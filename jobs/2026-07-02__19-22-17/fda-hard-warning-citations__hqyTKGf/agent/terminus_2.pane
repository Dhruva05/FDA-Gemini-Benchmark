[?2004l[?2004h> # Question 7: What important warnings or precautions are associated with Paxlovid?
[?2004l[?2004h> # qid: fbab4114f66e2dda, Paxlovid, set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a
[?2004l[?2004h> answers.append({
[?2004l[?2004h>     "qid": "fbab4114f66e2dda",
[?2004l[?2004h>     "status": "ANSWERED",
[?2004l[?2004h>     "answer": "Important warnings and precautions for Paxlovid include: 1) Risk of serious adverse reactions due to drug interactions, as initiation of Paxlovid (a strong CYP3A inhibitor) can significantly increase plasma concentrations of CYP3A-metabolized drugs; 2) Hypersensitivity reactions (such as anaphylaxis, toxic epidermal necrolysis, and Stevens-Johnson syndrome); 3) Hepatotoxicity (including transaminase elevations, clinical hepatitis, and jaundice); and 4) Risk of HIV-1 resistance development in patients with uncontrolled or undiagnosed HIV-1 infection.",
[?2004l[?2004h>     "citations": [
[?2004l[?2004h>         {
[?2004l[?2004h>             "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",
[?2004l[?2004h>             "passage_id": "PASSAGE_0013",
[?2004l[?2004h>             "section": "5.1",
[?2004l[?2004h>             "supporting_quote": "Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations of medications metabolized by CYP3A."
[?2004l[?2004h>         },
[?2004l[?2004h>         {
[?2004l[?2004h>             "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",
[?2004l[?2004h>             "passage_id": "PASSAGE_0014",
[?2004l[?2004h>             "section": "5.2",
[?2004l[?2004h>             "supporting_quote": "Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID ."
[?2004l[?2004h>         }
[?2004l[?2004h>     ],
[?2004l[?2004h>     "structured_fields": {}
[?2004l[?2004h> })
