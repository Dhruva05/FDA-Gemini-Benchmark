  "answers": [
    {
      "qid": "b2531657ba5c7a78",
      "status": "ANSWERED",
      "answer": "Paxlovid is a strong CYP3A inhibitor due to its ritonavir component, which can lead to significantly increased concentrations of concomitant medications metabolized by CYP3A, potentially resulting in severe, life-threatening, or fatal events. Concomitant use with strong CYP3A inducers can also decrease Paxlovid concentrations, potentially leading to loss of virologic response and resistance.",
      "citations": [
        {
          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",
          "passage_id": "PASSAGE_0000",
          "section": "BOXED WARNING",
          "supporting_quote": "PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events"
        },
        {
          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",
          "passage_id": "PASSAGE_0013",
          "section": "5.1",
          "supporting_quote": "Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations of medications metabolized by CYP3A."
        }
      ],
      "structured_fields": {}
    },
    {
      "qid": "6f12607a1ba14dd5",
      "status": "ANSWERED",
      "answer": "Paxlovid is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions, as well as drugs that are strong CYP3A inducers. Examples of contraindicated medications include alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in renal/hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (for PAH), triazolam, oral midazolam, flibanserin, tolvaptan, apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort.",
      "citations": [
        {
          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",
          "passage_id": "PASSAGE_0012",
          "section": "4",
          "supporting_quote": "PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers"
        }
      ],
      "structured_fields": {}
    },
    {
      "qid": "daef650b92e56473",
      "status": "ANSWERED",
      "answer": "Lopinavir and ritonavir oral solution must be taken with food. When administered by a feeding tube, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility with the ethanol and propylene glycol excipients. Silicone or polyvinyl chloride (PVC) feeding tubes should be used instead.",
      "citations": [
        {
          "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
          "passage_id": "PASSAGE_0001",
          "section": "2.1",
          "supporting_quote": "Lopinavir and ritonavir oral solution must be taken with food."
        },
        {
          "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
          "passage_id": "PASSAGE_0002",
          "section": "2.2",
          "supporting_quote": "Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility."
        }
      ],
      "structured_fields": {}
    },
    {
      "qid": "a0576a26f2a2eeac",
      "status": "ANSWERED",
      "answer": "Lopinavir and ritonavir can be given in a once daily or twice daily dosing regimen in adults. The recommended once daily dosage regimen is 800 mg/200 mg (10 mL) using the 80 mg/20 mg per mL oral solution. Once daily dosing is not recommended in patients with 3 or more lopinavir resistance-associated substitutions, in combination with certain drugs (like carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir), in pediatric patients under 18, or in pregnant women.",
      "citations": [
        {
          "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
          "passage_id": "PASSAGE_0003",
          "section": "2.3",
          "supporting_quote": "Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2."
        },
        {
          "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
          "passage_id": "PASSAGE_0004",
          "section": "2.3",
          "supporting_quote": "80 mg/20 mg per mL Oral Solution 800 mg/200 mg (10 mL) once daily"
        }
      ],
      "structured_fields": {}
    },
    {
      "qid": "9be5515bc3064979",
      "status": "ANSWERED",
      "answer": "Safety risks listed for lopinavir and ritonavir include pancreatitis (which can be fatal), hepatotoxicity (with postmarketing reports of hepatic dysfunction and fatalities), QT interval prolongation and torsade de pointes, PR interval prolongation, new onset or exacerbation of diabetes mellitus/hyperglycemia, immune reconstitution syndrome, lipid elevations (large increases in cholesterol and triglycerides), fat redistribution, and increased bleeding in patients with hemophilia.",
      "citations": [
        {
          "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
          "passage_id": "PASSAGE_0016",
          "section": "5.3",
          "supporting_quote": "Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations. In some cases, fatalities have been observed."
        },
        {
          "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
          "passage_id": "PASSAGE_0017",
          "section": "5.4",
          "supporting_quote": "There have been postmarketing reports of hepatic dysfunction, including some fatalities."
        }
      ],
      "structured_fields": {}
    },
    {
      "qid": "18078efe9380c8dc",
      "status": "ANSWERED",
      "answer": "Important warnings and precautions associated with lopinavir and ritonavir include: the risk of serious adverse reactions due to drug interactions (since it is a CYP3A inhibitor); toxicity in preterm neonates due to ethanol and propylene glycol excipients (which can lead to cardiac toxicity, lactic acidosis, renal failure, CNS depression, and death); pancreatitis; hepatotoxicity; QT interval prolongation; PR interval prolongation; diabetes mellitus/hyperglycemia; immune reconstitution syndrome; lipid elevations; fat redistribution; and increased bleeding in hemophilia patients.",
      "citations": [
        {
          "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
          "passage_id": "PASSAGE_0014",
          "section": "5.1",
          "supporting_quote": "Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A."
        },
        {
          "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
          "passage_id": "PASSAGE_0015",
          "section": "5.2",
          "supporting_quote": "Lopinavir and ritonavir oral solution should not be used in preterm neonates in the immediate postnatal period because of possible toxicities."
        }
      ],
