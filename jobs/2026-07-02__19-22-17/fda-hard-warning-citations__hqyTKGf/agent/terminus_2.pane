[?2004l[?2004h>     "status": "ANSWERED",
[?2004l[?2004h>     "answer": "Safety risks listed for Paxlovid include serious adverse reactions due to drug interactions (which can be severe, life-threatening, or fatal), hypersensitivity reactions (such as anaphylaxis, Stevens-Johnson syndrome, and toxic epidermal necrolysis), hepatotoxicity (with transaminase elevations, clinical hepatitis, and jaundice), and the risk of HIV-1 resistance development in individuals with uncontrolled or undiagnosed HIV-1 infection.",
[?2004l[?2004h>     "citations": [
[?2004l[?2004h>         {
[?2004l[?2004h>             "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",
[?2004l[?2004h>             "passage_id": "PASSAGE_0015",
[?2004l[?2004h>             "section": "5.3",
[?2004l[?2004h>             "supporting_quote": "Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir."
[?2004l[?2004h>         },
