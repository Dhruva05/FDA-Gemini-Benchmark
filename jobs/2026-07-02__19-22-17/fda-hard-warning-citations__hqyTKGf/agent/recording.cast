[169.529786, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.530221, "o", "            \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
