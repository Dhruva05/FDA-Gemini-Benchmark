[169.543086, "o", "> "]
[169.543139, "o", "# Question 8: What safety risks are listed for Paxlovid?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.543207, "o", "# qid: 2d63e0a82215867f, Paxlovid, set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.543288, "o", "answers.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.543354, "o", "    \"qid\": \"2d63e0a82215867f\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.543416, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.543767, "o", "    \"answer\": \"Safety risks listed for Paxlovid include serious adverse reactions due to drug interactions (which can be severe, life-threatening, or fatal), hypersensitivity reactions (such as anaphylaxis, Stevens-Johnson syndrome, and toxic epidermal necrolysis), hepatotoxicity (with transaminase elevations, clinical hepatitis, and jaundice), and the risk of HIV-1 resistance development in individuals with uncontrolled or undiagnosed HIV-1 infection.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.543813, "o", "    \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.54383, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.543898, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.543956, "o", "            \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.544, "o", "            \"section\": \"5.3\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.544125, "o", "            \"supporting_quote\": \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.544158, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h>         {"]
[169.544216, "o", "\r\n\u001b[?2004l\r"]
