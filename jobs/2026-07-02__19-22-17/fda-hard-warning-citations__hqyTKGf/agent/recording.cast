[169.535306, "o", "            \"passage_id\": \"PASSAGE_0004\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.535392, "o", "            \"section\": \"2.3\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.535571, "o", "            \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 800 mg/200 mg (10 mL) once daily\"\r\n\u001b[?2004l\r\u001b[?2004h"]
