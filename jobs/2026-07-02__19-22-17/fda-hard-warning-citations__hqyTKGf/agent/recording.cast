[169.535918, "o", "# Question 5: What safety risks are listed for Lopinavir-Ritonavir?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.536028, "o", "# qid: 9be5515bc3064979, Lopinavir-Ritonavir, set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.5361, "o", "answers.append({\r\n\u001b[?2004l\r"]
[169.536144, "o", "\u001b[?2004h> "]
[169.536165, "o", "    \"qid\": \"9be5515bc3064979\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.53618, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[169.536234, "o", "\u001b[?2004h> "]
[169.536941, "o", "    \"answer\": \"Safety risks listed for lopinavir and ritonavir include pancreatitis (which can be fatal), hepatotoxicity (with postmarketing reports of hepatic dysfunction and fatalities), QT interval prolongation and torsade de pointes, PR interval prolongation, new onset or exacerbation of diabetes mellitus/hyperglycemia, immune reconstitution syndrome, lipid elevations (large increases in cholesterol and triglycerides), fat redistribution, and increased bleeding in patients with hemophilia.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.536957, "o", "> "]
[169.537029, "o", "    \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.537051, "o", "        {\r\n\u001b[?2004l\r \u001b[?2004h> "]
[169.537182, "o", "            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.537257, "o", "            \"passage_id\": \"PASSAGE_0016\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
