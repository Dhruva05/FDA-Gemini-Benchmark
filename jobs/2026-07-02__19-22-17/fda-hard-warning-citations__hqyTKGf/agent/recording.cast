[169.538759, "o", "# Question 6: What important warnings or precautions are associated with Lopinavir-Ritonavir?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.538911, "o", "# qid: 18078efe9380c8dc, Lopinavir-Ritonavir, set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\r\n\u001b[?2004l\r"]
[169.538927, "o", "\u001b[?2004h> answers.append({\r\n\u001b[?2004l\r"]
[169.538967, "o", "\u001b[?2004h"]
[169.539015, "o", "> "]
[169.539067, "o", "    \"qid\": \"18078efe9380c8dc\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.539151, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rhe\u001b[?2004h> "]
[169.5401, "o", "    \"answer\": \"Important warnings and precautions associated with lopinavir and ritonavir include: the risk of serious adverse reactions due to drug interactions (since it is a CYP3A inhibitor); toxicity in preterm neonates due to ethanol and propylene glycol excipients (which can lead to cardiac toxicity, lactic acidosis, renal failure, CNS depression, and death); pancreatitis; hepatotoxicity; QT interval prolongation; PR interval prolongation; diabetes mellitus/hyperglycemia; immune reconstitution syndrome; lipid elevations; fat redistribution; and increased bleeding in hemophilia patients.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.540149, "o", "    \"citations\": [\r\n\u001b[?2004l\r"]
[169.540166, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.540211, "o", "> "]
[169.540297, "o", "            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.540359, "o", "            \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.540387, "o", "            \"section\": \"5.1\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.540665, "o", "            \"supporting_quote\": \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[169.540716, "o", "\u001b[?2004h> "]
[169.540762, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.54082, "o", "            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.540877, "o", "            \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h>             \"section\": \"5.2\",\r\n\u001b[?2004l\r"]
[169.540943, "o", "\u001b[?2004h> "]
[169.541075, "o", "            \"supporting_quote\": \"Lopinavir and ritonavir oral solution should not be used in preterm neonates in the immediate postnatal period because of possible toxicities.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[169.541091, "o", "\u001b[?2004h> "]
[169.541139, "o", "    ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.541174, "o", "    \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h> })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.541273, "o", "# Question 7: What important warnings or precautions are associated with Paxlovid?\r\n\u001b[?2004l\r"]
[169.541289, "o", "\u001b[?2004h> "]
[169.541383, "o", "# qid: fbab4114f66e2dda, Paxlovid, set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\r\n"]
[169.541478, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.541541, "o", "answers.append({\r\n\u001b[?2004l\r\u001b[?2004h>     \"qid\": \"fbab4114f66e2dda\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"status\": \"ANSWERED\","]
[169.54159, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.542018, "o", "    \"answer\": \"Important warnings and precautions for Paxlovid include: 1) Risk of serious adverse reactions due to drug interactions, as initiation of Paxlovid (a strong CYP3A inhibitor) can significantly increase plasma concentrations of CYP3A-metabolized drugs; 2) Hypersensitivity reactions (such as anaphylaxis, toxic epidermal necrolysis, and Stevens-Johnson syndrome); 3) Hepatotoxicity (including transaminase elevations, clinical hepatitis, and jaundice); and 4) Risk of HIV-1 resistance development in patients with uncontrolled or undiagnosed HIV-1 infection.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.542085, "o", "    \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.542153, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h>             \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.542169, "o", "> "]
[169.542215, "o", "            \"section\": \"5.1\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.542491, "o", "            \"supporting_quote\": \"Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations of medications metabolized by CYP3A.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[169.542505, "o", "\u001b[?2004h> "]
[169.542519, "o", "        {\r\n\u001b[?2004l\r"]
[169.542581, "o", "\u001b[?2004h> "]
[169.542604, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.542685, "o", "            \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.542699, "o", "            \"section\": \"5.2\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.542898, "o", "            \"supporting_quote\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.542948, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.543001, "o", "> "]
