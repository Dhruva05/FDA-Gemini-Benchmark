[169.530714, "o", "# Question 3: How should Lopinavir-Ritonavir be administered?\r\n\u001b[?2004l\r"]
[169.530788, "o", "\u001b[?2004h> "]
[169.530883, "o", "# qid: daef650b92e56473, Lopinavir-Ritonavir, set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.531022, "o", "answers.append({\r\n\u001b[?2004l\r({\r\n \u001b[?2004h>     \"qid\": \"daef650b92e56473\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.531099, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r,\r\n \u001b[?2004h> "]
[169.531592, "o", "    \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. When administered by a feeding tube, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility with the ethanol and propylene glycol excipients. Silicone or polyvinyl chloride (PVC) feeding tubes should be used instead.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.531643, "o", "    \"citations\": [\r\n\u001b[?2004l\rsion, a\u001b[?2004h>         {\r\n\u001b[?2004l\r);"]
[169.531705, "o", "\u001b[?2004h> "]
[169.531737, "o", "            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.53184, "o", "> "]
