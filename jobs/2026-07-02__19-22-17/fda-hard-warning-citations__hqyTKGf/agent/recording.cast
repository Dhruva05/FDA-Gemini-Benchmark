[169.537359, "o", "> "]
[169.537701, "o", "            \"supporting_quote\": \"Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations. In some cases, fatalities have been observed.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.537753, "o", "        },\r\n\u001b[?2004l\rbe sev\u001b[?2004h"]
