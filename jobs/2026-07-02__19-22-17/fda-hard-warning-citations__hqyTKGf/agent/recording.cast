[169.521906, "i", "cat << 'EOF' > /workspace/generate_answers.py\nimport json\n\nanswers = []\n\n# Question 1: What important drug interactions are noted for Paxlovid?\n# qid: b2531657ba5c7a78, Paxlovid, set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\nanswers.append({\n    \"qid\": \"b2531657ba5c7a78\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Paxlovid is a strong CYP3A inhibitor due to its ritonavir component, which can lead to significantly increased concentrations of concomitant medications metabolized by CYP3A, potentially resulting in severe, life-threatening, or fatal events. Concomitant use with strong CYP3A inducers can also decrease Paxlovid concentrations, potentially leading to loss of virologic response and resistance.\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0000\",\n            \"section\": \"BOXED WARNING\",\n            \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\n        },\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0013\",\n            \"section\": \"5.1\",\n            \"supporting_quote\": \"Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations of medications metabolized by CYP3A.\"\n        }\n    ],\n    \"structured_fields\": {}\n})\n\n# Question 2: Which medications should be avoided with Paxlovid?\n# qid: 6f12607a1ba14dd5, Paxlovid, set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\nanswers.append({\n    \"qid\": \"6f12607a1ba14dd5\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Paxlovid is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions, as well as drugs that are strong CYP3A inducers. Examples of contraindicated medications include alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in renal/hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (for PAH), triazolam, oral midazolam, flibanserin, tolvaptan, apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort.\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0012\",\n            \"section\": \"4\",\n            \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\n        }\n    ],\n    \"structured_fields\": {}\n})\n\n# Question 3: How should Lopinavir-Ritonavir be administered?\n# qid: daef650b92e56473, Lopinavir-Ritonavir, set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\nanswers.append({\n    \"qid\": \"daef650b92e56473\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. When administered by a feeding tube, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility with the ethanol and propylene glycol excipients. Silicone or polyvinyl chloride (PVC) feeding tubes should be used instead.\",\n    \"citations\": [\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0001\",\n            \"section\": \"2.1\",\n            \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\n        },\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id"]
[169.522108, "i", "\": \"PASSAGE_0002\",\n            \"section\": \"2.2\",\n            \"supporting_quote\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility.\"\n        }\n    ],\n    \"structured_fields\": {}\n})\n\n# Question 4: What is the recommended dosage regimen of Lopinavir-Ritonavir?\n# qid: a0576a26f2a2eeac, Lopinavir-Ritonavir, set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\nanswers.append({\n    \"qid\": \"a0576a26f2a2eeac\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Lopinavir and ritonavir can be given in a once daily or twice daily dosing regimen in adults. The recommended once daily dosage regimen is 800 mg/200 mg (10 mL) using the 80 mg/20 mg per mL oral solution. Once daily dosing is not recommended in patients with 3 or more lopinavir resistance-associated substitutions, in combination with certain drugs (like carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir), in pediatric patients under 18, or in pregnant women.\",\n    \"citations\": [\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0003\",\n            \"section\": \"2.3\",\n            \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2.\"\n        },\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0004\",\n            \"section\": \"2.3\",\n            \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 800 mg/200 mg (10 mL) once daily\"\n        }\n    ],\n    \"structured_fields\": {}\n})\n\n# Question 5: What safety risks are listed for Lopinavir-Ritonavir?\n# qid: 9be5515bc3064979, Lopinavir-Ritonavir, set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\nanswers.append({\n    \"qid\": \"9be5515bc3064979\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Safety risks listed for lopinavir and ritonavir include pancreatitis (which can be fatal), hepatotoxicity (with postmarketing reports of hepatic dysfunction and fatalities), QT interval prolongation and torsade de pointes, PR interval prolongation, new onset or exacerbation of diabetes mellitus/hyperglycemia, immune reconstitution syndrome, lipid elevations (large increases in cholesterol and triglycerides), fat redistribution, and increased bleeding in patients with hemophilia.\",\n    \"citations\": [\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0016\",\n            \"section\": \"5.3\",\n            \"supporting_quote\": \"Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations. In some cases, fatalities have been observed.\"\n        },\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0017\",\n            \"section\": \"5.4\",\n            \"supporting_quote\": \"There have been postmarketing reports of hepatic dysfunction, including some fatalities.\"\n        }\n    ],\n    \"structured_fields\": {}\n})\n\n# Question 6: What important warnings or precautions are associated with Lopinavir-Ritonavir?\n# qid: 18078efe9380c8dc, Lopinavir-Ritonavir, set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\nanswers.append({\n    \"qid\": \"18078efe9380c8dc\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Important warnings and precautions associated with lopinavir and ritonavir include: the risk of serious adverse reactions due to drug interactions (since it is a CYP3A inhibitor); toxicity in preterm neonates due to ethanol and propylene glycol excipients (which can lead to cardiac toxicity, lactic acidosis, renal failure, CNS depression, and death); pancreatitis; hepatotoxicity; QT interval prolongation; PR interval prolongation; diabetes mellitus/hyperglycemia; immune reconstitution syndrome; lipid elevations; fat redistribution; and increased bleeding in hemophilia patients.\",\n    \"citations\": [\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n           "]
[169.522265, "i", " \"passage_id\": \"PASSAGE_0014\",\n            \"section\": \"5.1\",\n            \"supporting_quote\": \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A.\"\n        },\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0015\",\n            \"section\": \"5.2\",\n            \"supporting_quote\": \"Lopinavir and ritonavir oral solution should not be used in preterm neonates in the immediate postnatal period because of possible toxicities.\"\n        }\n    ],\n    \"structured_fields\": {}\n})\n\n# Question 7: What important warnings or precautions are associated with Paxlovid?\n# qid: fbab4114f66e2dda, Paxlovid, set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\nanswers.append({\n    \"qid\": \"fbab4114f66e2dda\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Important warnings and precautions for Paxlovid include: 1) Risk of serious adverse reactions due to drug interactions, as initiation of Paxlovid (a strong CYP3A inhibitor) can significantly increase plasma concentrations of CYP3A-metabolized drugs; 2) Hypersensitivity reactions (such as anaphylaxis, toxic epidermal necrolysis, and Stevens-Johnson syndrome); 3) Hepatotoxicity (including transaminase elevations, clinical hepatitis, and jaundice); and 4) Risk of HIV-1 resistance development in patients with uncontrolled or undiagnosed HIV-1 infection.\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0013\",\n            \"section\": \"5.1\",\n            \"supporting_quote\": \"Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations of medications metabolized by CYP3A.\"\n        },\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0014\",\n            \"section\": \"5.2\",\n            \"supporting_quote\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\n        }\n    ],\n    \"structured_fields\": {}\n})\n\n# Question 8: What safety risks are listed for Paxlovid?\n# qid: 2d63e0a82215867f, Paxlovid, set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\nanswers.append({\n    \"qid\": \"2d63e0a82215867f\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Safety risks listed for Paxlovid include serious adverse reactions due to drug interactions (which can be severe, life-threatening, or fatal), hypersensitivity reactions (such as anaphylaxis, Stevens-Johnson syndrome, and toxic epidermal necrolysis), hepatotoxicity (with transaminase elevations, clinical hepatitis, and jaundice), and the risk of HIV-1 resistance development in individuals with uncontrolled or undiagnosed HIV-1 infection.\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0015\",\n            \"section\": \"5.3\",\n            \"supporting_quote\": \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"\n        },\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0016\",\n            \"section\": \"5.4\",\n            \"supporting_quote\": \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\"\n        }\n    ],\n    \"structured_fields\": {}\n})\n\nwith open('/workspace/answers.json', 'w') as f:\n    json.dump({\"answers\": answers}, f, indent=2)\nprint(\"Done!\")\nEOF\npython3 /workspace/generate_answers.py\n"]
