[33.180004, "i", "python3 -c \"import json; f=open('/workspace/data/public/labels.jsonl'); \nfor line in f:\n    obj = json.loads(line)\n    raw = obj['label_raw']\n    chunks = obj['chunks']\n    for i, chunk in enumerate(chunks):\n        pid = f'PASSAGE_{i:04d}'\n        tag = f'||{pid}||'\n        if tag not in raw:\n            print(f'Error: {pid} not in raw for {obj[\"drug_name\"]}')\n            break\n    else:\n        print(f'Success for {obj[\"drug_name\"]}')\n\"\n"]
