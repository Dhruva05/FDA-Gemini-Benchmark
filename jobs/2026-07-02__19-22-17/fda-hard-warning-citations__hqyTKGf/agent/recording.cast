[184.728551, "o", "Valid JSON: True\r\nNumber of answers: 8\r\n0 b2531657ba5c7a78 ANSWERED 2\r\n1 6f12607a1ba14dd5 ANSWERED 1\r\n2 daef650b92e56473 ANSWERED 2\r\n3 a0576a26f2a2eeac ANSWERED 2\r\n4 9be5515bc3064979 ANSWERED 2\r\n5 18078efe9380c8dc ANSWERED 2\r\n6 fbab4114f66e2dda ANSWERED 2\r\n7 2d63e0a82215867f ANSWERED 2\r\n"]
