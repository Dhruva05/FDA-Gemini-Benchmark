[169.531999, "o", "            \"section\": \"2.1\",\r\n\u001b[?2004l\rtut\u001b[?2004h> "]
[169.532165, "o", "            \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.532189, "o", "        },\r\n\u001b[?2004l\rci"]
[169.532333, "o", "\u001b[?2004h> "]
[169.532362, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h>             \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r"]
[169.532408, "o", "\u001b[?2004h> "]
