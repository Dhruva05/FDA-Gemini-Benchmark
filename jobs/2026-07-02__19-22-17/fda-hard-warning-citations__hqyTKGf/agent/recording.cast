[169.533413, "o", "# Question 4: What is the recommended dosage regimen of Lopinavir-Ritonavir?\r\n\u001b[?2004l\rP3A.\"\r\n     \u001b[?2004h> "]
[169.533516, "o", "# qid: a0576a26f2a2eeac, Lopinavir-Ritonavir, set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\r\n\u001b[?2004l\r"]
[169.533572, "o", "\u001b[?2004h> answers.append({\r\n\u001b[?2004l\r"]
[169.533636, "o", "\u001b[?2004h>     \"qid\": \"a0576a26f2a2eeac\",\r\n\u001b[?2004l\ro\u001b[?2004h"]
[169.533693, "o", "> "]
[169.533709, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.534485, "o", "    \"answer\": \"Lopinavir and ritonavir can be given in a once daily or twice daily dosing regimen in adults. The recommended once daily dosage regimen is 800 mg/200 mg (10 mL) using the 80 mg/20 mg per mL oral solution. Once daily dosing is not recommended in patients with 3 or more lopinavir resistance-associated substitutions, in combination with certain drugs (like carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir), in pediatric patients under 18, or in pregnant women.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.534538, "o", "    \"citations\": [\r\n\u001b[?2004l\rRis\u001b[?2004h> "]
[169.534612, "o", "        {\r\n\u001b[?2004l\rserio\u001b[?2004h> "]
[169.534634, "o", "            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\rns due to drug interactions, as initiation o\u001b[?2004h> "]
[169.534717, "o", "            \"passage_id\": \"PASSAGE_0003\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.534792, "o", "> "]
[169.534849, "o", "            \"section\": \"2.3\",\r\n\u001b[?2004l\r"]
[169.534893, "o", "\u001b[?2004h> "]
[169.535069, "o", "            \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[169.53514, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
