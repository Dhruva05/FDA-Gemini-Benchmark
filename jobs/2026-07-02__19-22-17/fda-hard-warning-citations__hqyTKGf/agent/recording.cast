[169.527663, "o", "stion 5: What safety "]
[169.527827, "o", "\u001b[?2004h> # qid: 6f12607a1ba14dd5, Paxlovid, set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.527975, "o", "answers.append({\r\n\u001b[?2004l\r_id: 4\u001b[?2004h"]
[169.528048, "o", "> "]
[169.528123, "o", "    \"qid\": \"6f12607a1ba14dd5\",\r\n\u001b[?2004l\r"]
[169.528161, "o", "\u001b[?2004h>     \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.529428, "o", "    \"answer\": \"Paxlovid is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions, as well as drugs that are strong CYP3A inducers. Examples of contraindicated medications include alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in renal/hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (for PAH), triazolam, oral midazolam, flibanserin, tolvaptan, apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.529524, "o", "    \"citations\": [\r\n"]
[169.529544, "o", "\u001b[?2004l\r"]
[169.529598, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.529695, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
