ing quote found.")\n        \n    # Check structured fields\n    print(f"  Structured fields: {ans[\'structured_fields\']}")\n    for field in q[\'required_output_fields\']:\n        if field.startswith(\'structured_fields.\'):\n            subfield = field.split(\'.\')[1]\n            assert subfield in ans[\'structured_fields\'], f"Required subfield {subfield} not found in structured_fields"\n\nprint("\\nAll checks passed successfully!")\nEOF\npython3 validate.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
