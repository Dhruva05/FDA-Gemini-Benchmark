[58.791662, "i", "cat << 'EOF' > read_clean.py\nwith open('clean_details.txt') as f:\n    content = f.read()\n\nblocks = content.split(\"=\" * 80)\nfor b in blocks:\n    if not b.strip():\n        continue\n    lines = b.strip().split('\\n')\n    qid = [l for l in lines if \"QID:\" in l][0]\n    print(\"=\" * 60)\n    print(qid)\n    # Let's find specific text or just write custom analysis for each QID\nEOF\npython3 -c \"\nwith open('clean_details.txt') as f:\n    content = f.read()\nfor b in content.split('=' * 80):\n    if 'QID:' in b:\n        print('='*40)\n        print(b[:1200])\n\"\n"]
