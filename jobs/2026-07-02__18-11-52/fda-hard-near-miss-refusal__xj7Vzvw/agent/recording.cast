[75.12626, "i", "cat << 'EOF' > inspect_acamprosate.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = {label['set_id']: label for line in f for label in [json.loads(line)]}\n\nlabel = labels['ae6e79c0-a307-4888-b647-1b7be4cb9127']\nfor idx, chunk in enumerate(label['chunks']):\n    if \"renal\" in chunk.lower() or \"hepatic\" in chunk.lower() or \"liver\" in chunk.lower():\n        print(f\"PASSAGE_{idx:04d}:\")\n        print(chunk)\n        print(\"-\" * 40)\nEOF\npython3 inspect_acamprosate.py\n"]
