[45.688125, "i", "cat << 'EOF' > parse_details.py\nwith open('details.txt') as f:\n    content = f.read()\n\nquestions_blocks = content.split(\"=\" * 80)\nfor block in questions_blocks:\n    if \"QID:\" in block:\n        lines = block.strip().split('\\n')\n        qid_line = [l for l in lines if \"QID:\" in l][0]\n        print(\"=\" * 40)\n        print(qid_line)\n        # Print the first 2-3 lines of the question\n        for l in lines[:4]:\n            print(l)\n        print(\"--- Passages found in block ---\")\n        # Find PASSAGE lines\n        passages = []\n        curr_passage = None\n        for l in lines:\n            if l.startswith(\"--- PASSAGE_\"):\n                if curr_passage:\n                    passages.append(curr_passage)\n                curr_passage = {\"id\": l, \"text\": []}\n            elif curr_passage is not None:\n                curr_passage[\"text\"].append(l)\n        if curr_passage:\n            passages.append(curr_passage)\n            \n        for p in passages:\n            text_joined = \"\\n\".join(p[\"text\"]).strip()\n            print(f\"{p['id']} (len: {len(text_joined)})\")\n            # Print first 2 lines and last 2 lines or just first 300 chars\n            print(text_joined[:400])\n            if len(text_joined) > 400:\n                print(\"... [TRUNCATED] ...\")\n            print(\"-\" * 20)\nEOF\npython3 parse_details.py\n"]
