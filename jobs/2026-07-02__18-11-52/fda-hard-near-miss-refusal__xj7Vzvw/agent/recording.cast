[40.127245, "i", "cat << 'EOF' > print_details.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = {label['set_id']: label for line in f for label in [json.loads(line)]}\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = [json.loads(line) for line in f]\n\ndef print_question_details(qid):\n    q = next(x for x in questions if x['qid'] == qid)\n    label = labels[q['set_id']]\n    print(\"=\" * 80)\n    print(f\"QID: {qid}\")\n    print(f\"QUESTION: {q['question']}\")\n    print(\"=\" * 80)\n    \n    # Print all chunks with their indices\n    for idx, chunk in enumerate(label['chunks']):\n        passage_id = f\"PASSAGE_{idx:04d}\"\n        # If the chunk seems relevant, print it in full\n        q_lower = q['question'].lower()\n        # Let's define relevance based on question\n        is_relevant = False\n        if qid == \"near-miss-04f3afa658fdef\":\n            is_relevant = \"warning\" in chunk.lower() or \"pharmacogenomic\" in chunk.lower() or \"test\" in chunk.lower() or idx in [1, 2, 4, 5, 6]\n        elif qid == \"near-miss-0c6ec72416151f\":\n            is_relevant = \"renal\" in chunk.lower() or \"hepatic\" in chunk.lower() or \"liver\" in chunk.lower() or \"impairment\" in chunk.lower()\n        elif qid == \"near-miss-bd69d0bfb1fc7d\":\n            is_relevant = \"pregnan\" in chunk.lower() or \"breast\" in chunk.lower() or \"lactat\" in chunk.lower() or \"milk\" in chunk.lower() or \"dose\" in chunk.lower()\n        elif qid == \"near-miss-d4ca1884aa8ab4\":\n            is_relevant = \"adverse\" in chunk.lower() or \"reaction\" in chunk.lower() or \"monitor\" in chunk.lower()\n        elif qid == \"near-miss-52e5f8cac33c50\":\n            is_relevant = \"pediatric\" in chunk.lower() or \"geriatric\" in chunk.lower() or \"child\" in chunk.lower() or \"elder\" in chunk.lower() or \"lifetime\" in chunk.lower() or \"cumulative\" in chunk.lower()\n        elif qid == \"near-miss-5b5cb6a5249660\":\n            is_relevant = \"pregnan\" in chunk.lower() or \"breast\" in chunk.lower() or \"lactat\" in chunk.lower() or \"milk\" in chunk.lower() or \"dose\" in chunk.lower()\n            \n        if is_relevant:\n            print(f\"--- {passage_id} ---\")\n            print(chunk)\n            print()\n\nfor q in questions:\n    print_question_details(q['qid'])\n\nEOF\npython3 print_details.py > details.txt\nhead -n 100 details.txt\n"]
