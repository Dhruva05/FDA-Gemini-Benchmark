[82.749335, "i", "cat << 'EOF' > inspect_others.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = {label['set_id']: label for line in f for label in [json.loads(line)]}\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = [json.loads(line) for line in f]\n\ndef inspect_q(qid, keywords):\n    q = next(x for x in questions if x['qid'] == qid)\n    label = labels[q['set_id']]\n    print(\"=\" * 80)\n    print(f\"QID: {qid}\")\n    print(f\"Question: {q['question']}\")\n    print(\"-\" * 40)\n    for idx, chunk in enumerate(label['chunks']):\n        if any(kw in chunk.lower() for kw in keywords):\n            print(f\"PASSAGE_{idx:04d}:\")\n            print(chunk)\n            print(\".\" * 40)\n\n# Q3: Acamprosate Calcium discusses pregnancy. recommendation for breastfeeding dose adjustment?\ninspect_q(\"near-miss-bd69d0bfb1fc7d\", [\"pregnan\", \"breast\", \"lactat\", \"milk\"])\n\n# Q4: Acamprosate Calcium discusses adverse reactions. recommendation for therapeutic drug monitoring target range?\ninspect_q(\"near-miss-d4ca1884aa8ab4\", [\"adverse\", \"reaction\", \"monitoring\"])\n\n# Q5: Acamprosate Calcium discusses pediatric. recommendation for geriatric maximum cumulative lifetime dose?\ninspect_q(\"near-miss-52e5f8cac33c50\", [\"pediatric\", \"geriatric\", \"child\", \"elder\", \"cumulative\", \"lifetime\"])\n\n# Q6: Acclean Chlorhexidine pregnancy, breastfeeding dose adjustment?\ninspect_q(\"near-miss-5b5cb6a5249660\", [\"pregnan\", \"breast\", \"lactat\", \"milk\"])\nEOF\npython3 inspect_others.py\n"]
