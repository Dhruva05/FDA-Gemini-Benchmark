[33.246757, "i", "cat << 'EOF' > find_passages.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = {label['set_id']: label for line in f for label in [json.loads(line)]}\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = [json.loads(line) for line in f]\n\nfor q in questions:\n    print(\"=\" * 80)\n    print(f\"QID: {q['qid']}\")\n    print(f\"Drug Name: {q['drug_name']}\")\n    print(f\"Question: {q['question']}\")\n    set_id = q['set_id']\n    label = labels[set_id]\n    print(f\"Total chunks: {len(label['chunks'])}\")\n    \n    q_lower = q['question'].lower()\n    print(\"Candidate chunks:\")\n    for idx, chunk in enumerate(label['chunks']):\n        passage_id = f\"PASSAGE_{idx:04d}\"\n        if len(label['chunks']) <= 20:\n            print(f\"  {passage_id}: {repr(chunk[:100])}...\")\n        else:\n            keywords = []\n            if \"renal\" in q_lower or \"hepatic\" in q_lower:\n                keywords = [\"renal\", \"kidney\", \"hepatic\", \"liver\"]\n            elif \"pregnancy\" in q_lower or \"breastfeeding\" in q_lower:\n                keywords = [\"pregnan\", \"breast\", \"lactat\", \"milk\"]\n            elif \"adverse\" in q_lower or \"monitoring\" in q_lower:\n                keywords = [\"adverse\", \"monitoring\", \"reaction\"]\n            elif \"pediatric\" in q_lower or \"geriatric\" in q_lower:\n                keywords = [\"pediatric\", \"geriatric\", \"child\", \"elderly\", \"age\"]\n            \n            if any(kw in chunk.lower() for kw in keywords):\n                print(f\"  {passage_id}: {repr(chunk[:150])}...\")\nEOF\npython3 find_passages.py\n"]
