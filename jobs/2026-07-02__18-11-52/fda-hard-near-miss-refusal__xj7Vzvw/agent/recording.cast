[11.176578, "i", "cat << 'EOF' > inspect_labels.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = [json.loads(line) for line in f]\n\nfor label in labels:\n    print(f\"Drug Name: {label.get('drug_name')}, Set ID: {label.get('set_id')}\")\n    print(f\"Number of chunks: {len(label.get('chunks', []))}\")\n    # Print first chunk to see the structure\n    if label.get('chunks'):\n        print(\"Sample chunk keys:\", label['chunks'][0].keys())\n        print(\"Sample chunk:\", json.dumps(label['chunks'][0], indent=2)[:500])\n    print(\"-\" * 40)\nEOF\npython3 inspect_labels.py\n"]
