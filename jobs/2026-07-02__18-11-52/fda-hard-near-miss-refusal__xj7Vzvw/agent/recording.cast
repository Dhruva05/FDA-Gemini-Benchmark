[63.232797, "i", "cat << 'EOF' > analyze_q.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = {label['set_id']: label for line in f for label in [json.loads(line)]}\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = [json.loads(line) for line in f]\n\ndef show_passages(qid, indices):\n    q = next(x for x in questions if x['qid'] == qid)\n    label = labels[q['set_id']]\n    print(\"=\" * 80)\n    print(f\"QID: {qid}\")\n    print(f\"Question: {q['question']}\")\n    print(f\"Required fields: {q['required_output_fields']}\")\n    for idx in indices:\n        print(f\"--- PASSAGE_{idx:04d} ---\")\n        print(label['chunks'][idx])\n    print(\"=\" * 80)\n\n# Q1: 12HR Allergy Relief warnings/pharmacogenomic testing requirement\nshow_passages(\"near-miss-04f3afa658fdef\", [1, 2, 3, 4, 5, 6, 9])\n\nEOF\npython3 analyze_q.py\n"]
