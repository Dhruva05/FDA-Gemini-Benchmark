[117.209371, "o", "\u001b[?2004hroot@c7da805c5eb1:/workspace# "]
[123.838116, "i", "cat << 'EOF' > validate_answers.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = {label['set_id']: label for line in f for label in [json.loads(line)]}\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = {q['qid']: q for line in f for q in [json.loads(line)]}\n\nwith open('/workspace/answers.json') as f:\n    ans_data = json.load(f)\n\nprint(\"Keys in answers.json:\", ans_data.keys())\nanswers = ans_data.get('answers', [])\nprint(f\"Number of answers: {len(answers)}\")\n\n# Check that every question is answered exactly once\nqids_in_ans = [a['qid'] for a in answers]\nprint(\"QIDs match questions.jsonl:\", set(qids_in_ans) == set(questions.keys()))\n\nfor a in answers:\n    qid = a['qid']\n    print(f\"\\nChecking QID: {qid}\")\n    q = questions[qid]\n    \n    # Check required fields\n    req_fields = q['required_output_fields']\n    print(f\"  Required fields: {req_fields}\")\n    # Check status\n    assert a['status'] in ['ANSWERED', 'NOT_FOUND'], f\"Invalid status {a['status']}\"\n    \n    # Check citations\n    citations = a.get('citations', [])\n    print(f\"  Number of citations: {len(citations)}\")\n    for c in citations:\n        set_id = c['set_id']\n        passage_id = c['passage_id']\n        section = c['section']\n        quote = c['supporting_quote']\n        \n        # Check set_id matches question\n        assert set_id == q['set_id'], f\"set_id {set_id} does not match question set_id {q['set_id']}\"\n        \n        # Check passage_id exists in label\n        label = labels[set_id]\n        idx = int(passage_id.split('_')[1])\n        assert 0 <= idx < len(label['chunks']), f\"passage_id {passage_id} out of bounds\"\n        \n        # Check quote is in the chunk\n        chunk = label['chunks'][idx]\n        assert quote in chunk, f\"Quote '{quote}' not found in passage {passage_id}\"\n        print(f\"  Citation verified: {passage_id} contains quote.\")\n        \n    # Check structured fields\n    sf = a.get('structured_fields', {})\n    print(f\"  Structured fields: {sf}\")\n    for field in req_fields:\n        if field.startswith('structured_fields.'):\n            subfield = field.split('.')[1]\n            assert subfield in sf, f\"Missing structured_field {subfield}\"\n\nprint(\"\\nAll validations passed successfully!\")\nEOF\npython3 validate_answers.py\n"]
