[54.92472, "i", "cat << 'EOF' > print_clean.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = {label['set_id']: label for line in f for label in [json.loads(line)]}\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = [json.loads(line) for line in f]\n\nfor q in questions:\n    print(\"=\" * 80)\n    print(f\"QID: {q['qid']}\")\n    print(f\"DRUG: {q['drug_name']}\")\n    print(f\"QUESTION: {q['question']}\")\n    print(\"-\" * 80)\n    label = labels[q['set_id']]\n    \n    # Let's see which chunks are relevant to the searched_topic in the question\n    # Let's print ALL chunks for that label, but nicely formatted with their indices\n    for idx, chunk in enumerate(label['chunks']):\n        passage_id = f\"PASSAGE_{idx:04d}\"\n        # Check if the chunk text is relevant to the question keywords\n        # Let's print any chunk that contains any keyword from the question\n        # or just print all chunks if there are fewer than 20\n        q_words = [w.strip(\"?,.()\") for w in q['question'].lower().split()]\n        # We want to find chunks that discuss the searched topic\n        # Let's print chunks that contain \"kidney\", \"renal\", \"hepatic\", \"pregnancy\", \"pediatric\", \"adverse\", \"warning\"\n        keywords = [\"kidney\", \"renal\", \"hepatic\", \"pregnancy\", \"pregnant\", \"breastfeeding\", \"pediatric\", \"geriatric\", \"adverse\", \"warning\", \"pharmacogenomic\", \"monitoring\"]\n        if len(label['chunks']) <= 20 or any(kw in chunk.lower() for kw in keywords):\n            print(f\"[{passage_id}]\")\n            print(chunk)\n            print(\".\" * 40)\nEOF\npython3 print_clean.py > clean_details.txt\n"]
