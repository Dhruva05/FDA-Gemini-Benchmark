[289.407241, "o", "> "]
[289.407731, "o", "          \"supporting_quote\": \"For patients who have difficulty swallowing capsules, the contents of a celecoxib capsule can be added to applesauce. The entire capsule contents are carefully emptied onto a level teaspoon of cool or room temperature applesauce and ingested immediately with water.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.40779, "o", "        }\r\n\u001b[?2004l\rim\u001b[?2004h>       ],\r\n\u001b[?2004l\ruc"]
