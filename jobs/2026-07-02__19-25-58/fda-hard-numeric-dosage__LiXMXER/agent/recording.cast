[289.419391, "o", "> "]
[289.419557, "o", "          \"supporting_quote\": \"Lenalidomide should be taken once daily at about the same time each day, Lenalidomide may be taken either with or without food. The capsules should not be opened, broken, or chewed. Lenalidomide should be swallowed whole with water.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
