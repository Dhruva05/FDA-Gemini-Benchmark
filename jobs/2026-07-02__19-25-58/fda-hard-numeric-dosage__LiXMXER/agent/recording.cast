[192.337443, "i", "cat << 'EOF' > print_last_chunks.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        drug_name = data['drug_name']\n        last_idx = len(data['chunks']) - 1\n        print(f\"=== {drug_name} Last Chunk ({last_idx}) ===\")\n        print(data['chunks'][last_idx][:300])\n        print()\nEOF\npython3 print_last_chunks.py\n"]
