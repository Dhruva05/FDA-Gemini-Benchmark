[289.419117, "o", "          \"supporting_quote\": \"Advise patients to take lenalidomide orally at about the same time each day, either with or without food. Advise patients to swallow lenalidomide capsules whole with water and not to open, break, or chew them.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
