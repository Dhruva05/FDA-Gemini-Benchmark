[171.441008, "i", "cat << 'EOF' > search_celecoxib_dose.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        if data['drug_name'] == 'CELECOXIB':\n            for idx, chunk in enumerate(data['chunks']):\n                if 'dosage' in chunk.lower() or 'dose' in chunk.lower():\n                    print(f\"Chunk {idx} (PASSAGE_{idx:04d}): {repr(chunk[:150])}\")\n            break\nEOF\npython3 search_celecoxib_dose.py\n"]
