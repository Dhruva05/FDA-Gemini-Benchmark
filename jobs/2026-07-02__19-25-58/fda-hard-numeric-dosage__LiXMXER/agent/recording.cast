[66.668953, "i", "cat << 'EOF' > dump_chunks.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        drug_name = data['drug_name'].replace(',', '').replace(' ', '_')\n        filename = f\"{drug_name}_chunks.txt\"\n        with open(filename, 'w') as out:\n            for i, chunk in enumerate(data['chunks'][:40]):\n                out.write(f\"=== CHUNK {i} (PASSAGE_{i:04d}) ===\\n\")\n                out.write(chunk)\n                out.write(\"\\n\\n\")\n        print(f\"Dumped {drug_name} chunks to {filename}\")\nEOF\npython3 dump_chunks.py && ls -la\n"]
