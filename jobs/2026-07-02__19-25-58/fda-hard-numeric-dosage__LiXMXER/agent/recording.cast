[142.189994, "i", "cat << 'EOF' > find_lenalidomide_admin.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        if data['drug_name'] == 'Lenalidomide':\n            for idx, chunk in enumerate(data['chunks']):\n                if any(w in chunk.lower() for w in ['administer', 'swallow', 'capsule', 'food', 'with water', 'whole']):\n                    print(f\"Chunk {idx} (PASSAGE_{idx:04d}): {repr(chunk[:150])}\")\n            break\nEOF\npython3 find_lenalidomide_admin.py\n"]
