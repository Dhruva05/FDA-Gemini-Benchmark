[28.110153, "i", "cat << 'EOF' > find_dosage_chunks.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        drug_name = data['drug_name']\n        print('='*40)\n        print(f'Drug: {drug_name}')\n        print('='*40)\n        for idx, chunk in enumerate(data['chunks']):\n            if any(h in chunk for h in ['DOSAGE AND ADMINISTRATION', 'Dosage and Administration']):\n                print(f'Chunk {idx} (PASSAGE_{idx:04d}): {chunk[:100]}...')\nEOF\npython3 find_dosage_chunks.py\n"]
