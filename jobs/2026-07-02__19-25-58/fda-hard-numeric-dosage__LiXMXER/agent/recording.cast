[9.101032, "i", "cat << 'EOF' > inspect_labels.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for i, line in enumerate(f):\n        data = json.loads(line)\n        print(f\"Line {i}: drug_name={data.get('drug_name')}, set_id={data.get('set_id')}, keys={list(data.keys())}\")\n        if 'chunks' in data:\n            print(f\"  Number of chunks: {len(data['chunks'])}\")\n            if len(data['chunks']) > 0:\n                print(f\"  First chunk keys: {list(data['chunks'][0].keys())}\")\n                print(f\"  First chunk example: {data['chunks'][0]}\")\nEOF\npython3 inspect_labels.py\n"]
