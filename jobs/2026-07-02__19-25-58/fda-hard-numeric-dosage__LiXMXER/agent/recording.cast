[289.414278, "o", "      \"qid\": \"85c49de5de841cb9\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.414335, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rld be swallowed w\u001b[?2004h> "]
[289.415368, "o", "      \"answer\": \"The recommended starting dosage of lenalidomide depends on the indication: For Multiple Myeloma (MM) in combination therapy, the recommended starting dose is 25 mg orally once daily on Days 1 to 21 of repeated 28-day cycles; for maintenance therapy following auto-HSCT, the starting dose is 10 mg once daily continuously. For Myelodysplastic Syndromes (MDS), the starting dose is 10 mg daily. For Mantle Cell Lymphoma (MCL), the starting dose is 25 mg daily orally on Days 1 to 21 of repeated 28-day cycles. For Follicular Lymphoma (FL) or Marginal Zone Lymphoma (MZL), the starting dose is 20 mg orally once daily on Days 1 to 21 of repeated 28-day cycles in combination with a rituximab product.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.415428, "o", "      \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.415495, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.415557, "o", "          \"set_id\": \"ed7a3099-ce31-4865-b212-358d9ff6261b\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.415623, "o", "          \"passage_id\": \"PASSAGE_0009\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.415687, "o", "          \"section\": \"2.1 Recommended Dosage for Multiple Myeloma\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.415879, "o", "          \"supporting_quote\": \"The recommended starting dose of lenalidomide is 25 mg orally once daily on Days 1 to 21 of repeated 28-day cycles in combination with dexamethasone.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.415926, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r"]
[289.415942, "o", "\u001b[?2004h> "]
[289.416011, "o", "          \"set_id\": \"ed7a3099-ce31-4865-b212-358d9ff6261b\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.416057, "o", "          \"passage_id\": \"PASSAGE_0010\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.416136, "o", "          \"section\": \"Lenalidomide Maintenance Therapy Following Auto-HSCT\",\r\n\u001b[?2004l\r"]
[289.416156, "o", "\u001b[?2004h> "]
[289.416326, "o", "          \"supporting_quote\": \"The recommended starting dose of lenalidomide is 10 mg once daily continuously (Days 1 to 28 of repeated 28-day cycles) until disease progression or unacceptable toxicity.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n"]
[289.416371, "o", "\u001b[?2004l\r\u001b[?2004h> "]
