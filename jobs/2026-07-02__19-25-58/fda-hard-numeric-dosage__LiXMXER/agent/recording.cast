[289.406207, "o", "      \"answer\": \"CELECOXIB capsules are administered orally and can be given without regard to timing of meals. For patients who have difficulty swallowing capsules, the contents of a celecoxib capsule can be carefully emptied onto a level teaspoon of cool or room temperature applesauce and ingested immediately with water.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.406238, "o", "      \"citations\": [\r\n\u001b[?2004l\r49\u001b[?2004h> "]
[289.406295, "o", "        {\r\n"]
[289.406352, "o", "\u001b[?2004l\r\u001b[?2004h> "]
