[289.417217, "o", "          \"supporting_quote\": \"The recommended starting dose of lenalidomide is 25 mg/day orally on Days 1 to 21 of repeated 28-day cycles for relapsed or refractory mantle cell lymphoma.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n"]
[289.417236, "o", "\u001b[?2004l\r\u001b[?2004h> "]
