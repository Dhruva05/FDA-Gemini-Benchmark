[221.718136, "i", "cat << 'EOF' > print_lenalidomide_dosage.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        if data['drug_name'] == 'Lenalidomide':\n            print(\"=== CHUNK 19 ===\")\n            print(data['chunks'][19])\n            print(\"=== CHUNK 22 ===\")\n            print(data['chunks'][22])\n            break\nEOF\npython3 print_lenalidomide_dosage.py\n"]
