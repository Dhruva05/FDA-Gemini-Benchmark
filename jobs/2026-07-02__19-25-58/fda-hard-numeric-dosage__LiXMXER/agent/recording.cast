[289.408569, "o", "> "]
[289.409669, "o", "      \"answer\": \"The recommended dosage of CELECOXIB varies by indication: For Osteoarthritis (OA), the dosage is 200 mg per day administered as a single dose or as 100 mg twice daily. For Rheumatoid Arthritis (RA), the dosage is 100 mg to 200 mg twice daily. For Ankylosing Spondylitis (AS), the dosage is 200 mg daily in single or divided doses. For Juvenile Rheumatoid Arthritis (JRA) in patients 2 years and older, the dosage is based on weight: 50 mg twice daily for patients 10 kg to 25 kg, and 100 mg twice daily for patients over 25 kg. For Management of Acute Pain and Treatment of Primary Dysmenorrhea, the dosage is 400 mg initially, followed by an additional 200 mg dose if needed on the first day, and on subsequent days, 200 mg twice daily as needed.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.409739, "o", "      \"citations\": [\r\n\u001b[?2004l\r"]
[289.409794, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\rd\": \"ed7a3\u001b[?2004h"]
