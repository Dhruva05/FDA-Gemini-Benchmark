[289.418345, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.418419, "o", "      \"qid\": \"0d262ce5d03f7c38\",\r\n\u001b[?2004l\r\u001b[?2004h>       \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.418628, "o", "      \"answer\": \"Lenalidomide should be taken orally once daily at about the same time each day, either with or without food. The capsules should be swallowed whole with water and should not be opened, broken, or chewed.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[289.418704, "o", "      \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r"]
