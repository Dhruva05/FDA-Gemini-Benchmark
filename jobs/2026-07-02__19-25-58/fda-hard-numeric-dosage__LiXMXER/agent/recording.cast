[289.417736, "o", "          \"supporting_quote\": \"The recommended starting dose of lenalidomide is 20 mg orally once daily on Days 1 to 21 of repeated 28-day cycles for up to 12 cycles of treatment in combination with a rituximab-product.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
