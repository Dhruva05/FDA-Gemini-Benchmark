[295.852059, "i", "cat << 'EOF' > validate_answers.py\nimport json\n\ntry:\n    with open('/workspace/answers.json') as f:\n        data = json.load(f)\n    print(\"Successfully loaded answers.json!\")\n    \n    # Check structure\n    if 'answers' not in data:\n        print(\"Error: 'answers' key not found!\")\n    else:\n        answers = data['answers']\n        print(f\"Number of answers: {len(answers)}\")\n        \n        # Load questions to compare qids\n        qids = []\n        with open('/workspace/data/public/questions.jsonl') as qf:\n            for line in qf:\n                q = json.loads(line)\n                qids.append(q['qid'])\n        \n        ans_qids = [a['qid'] for a in answers]\n        print(f\"Expected QIDs: {qids}\")\n        print(f\"Actual QIDs: {ans_qids}\")\n        if set(qids) != set(ans_qids):\n            print(\"Error: QID lists do not match!\")\n        else:\n            print(\"QID lists match perfectly!\")\n            \n        # Check fields\n        for idx, ans in enumerate(answers):\n            print(f\"Answer {idx} (qid={ans['qid']}):\")\n            for field in ['qid', 'status', 'answer', 'citations', 'structured_fields']:\n                if field not in ans:\n                    print(f\"  Error: field '{field}' is missing!\")\n            sf = ans.get('structured_fields', {})\n            for field in ['dose', 'unit', 'route', 'frequency', 'population', 'max_daily_dose', 'citation_passages']:\n                if field not in sf:\n                    print(f\"  Error: structured_fields field '{field}' is missing!\")\n            citations = ans.get('citations', [])\n            print(f\"  Citations count: {len(citations)}\")\n            for cit in citations:\n                for cfield in ['set_id', 'passage_id', 'section', 'supporting_quote']:\n                    if cfield not in cit:\n                        print(f\"    Error: citation field '{cfield}' is missing!\")\nexcept Exception as e:\n    print(f\"Error: {e}\")\nEOF\npython3 validate_answers.py\n"]
