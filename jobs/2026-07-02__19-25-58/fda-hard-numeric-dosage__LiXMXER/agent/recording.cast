[43.439043, "i", "cat << 'EOF' > print_lopinavir.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        if data['drug_name'] == 'Lopinavir-Ritonavir':\n            for i in range(15):\n                print(f\"--- CHUNK {i} (PASSAGE_{i:04d}) ---\")\n                print(data['chunks'][i])\n            break\nEOF\npython3 print_lopinavir.py\n"]
