e": {\n                    "dose_or_strength": "10 mg",\n                    "route": "oral (implied)",\n                    "frequency": "not stated",\n                    "population": "not stated",\n                    "maximum_daily_dose": "not stated"\n                }\n            }\n        }\n    },\n    {\n        "qid": "cross-e9a79ba825959d",\n        "status": "ANSWERED",\n        "answer": "Comparing Acamprosate Calcium and Acclean Chlorhexidine Gluconate 0.12% Oral Rinse: Acamprosate Calcium has a recommended dose of two 333 mg tablets (totaling 666 mg) taken orally three times daily for patients with alcohol dependence, with a total daily dose of 1998 mg (6 tablets). Acclean Chlorhexidine Gluconate 0.12% Oral Rinse has a usual dose of 15 ml (1 tablespoon) of undiluted oral rinse, swished in the mouth for 30 seconds and expectorated twice daily (morning and evening after tooth brushing or after breakfast and before bedtime) for patients directly following a dental prophylaxis, with no maximum daily dose stated.",\n        "citations": [\n            {\n                "set_id": "ae6e79c0-a307-4888-b647-1b7be4cb9127",\n                "passage_id": "PASSAGE_0001",\n                "section": "Dosage and Administration",\n                "supporting_quote": "The recommended dose of acamprosate calcium delayed-release tablets is two 333 mg tablets (each dose should total 666 mg) taken three times daily."\n            },\n            {\n                "set_id": "08c9d3dd-717b-0148-e054-00144ff8d46c",\n                "passage_id": "PASSAGE_0012",\n                "section": "Dosage and Administration",\n                "supporting_quote": "Recommended use is twice daily oral rinsing for 30 seconds, morning and evening after tooth brushing. Usual dosage is 15 ml (1 tablespoon) of undiluted chlorhexidine gluconate oral rinse."\n            }\n        ],\n        "structured_fields": {\n            "comparison": {\n                "ae6e79c0-a307-4888-b647-1b7be4cb9127": {\n                    "dose_or_strength": "two 333 mg tablets (666 mg)",\n                    "route": "oral",\n                    "frequency": "three times daily",\n                    "population": "patients with alcohol dependence",\n                    "maximum_daily_dose": "6 tablets (1998 mg) daily"\n                },\n                "08c9d3dd-717b-0148-e054-00144ff8d46c": {\n                    "dose_or_strength": "15 ml (1 tablespoon)",\n                    "route": "oral rinse (swish and expectorate)",\n                    "frequency": "twice daily",\n                    "population": "patients following a dental prophylaxis",\n                    "maximum_daily_dose": "not stated"\n                }\n            }\n        }\n    },\n    {\n        "qid": "cross-7421ed8b98b8f9",\n        "status": "ANSWERED",\n        "answer": "Comparing ACETAMINOPHEN with CODEINE and AcetaZOLAMIDE: ACETAMINOPHEN with CODEINE tablets are administered orally at a dose of 1 to 2 tablets every 6-8 hours as needed (repeated up to every 4 hours) for pain in adults, with a maximum daily dose determined by the prescriber based on the guidance (not to exceed 4000 mg of acetaminophen). AcetaZOLAMIDE is administered orally at doses ranging from 250 mg to 1000 mg daily (either once daily or in divided doses depending on the indication such as glaucoma, epilepsy, congestive heart failure, or acute mountain sickness) for adults and children, with a maximum daily dose of 1000 mg (1 g) stated as the limit above which no increased effect is produced for glaucoma and epilepsy.",\n        "citations": [\n            {\n                "set_id": "36adb32c-638c-4d6e-b66a-1a1c35174ce6",\n                "passage_id": "PASSAGE_0011",\n                "section": "Dosage and Administration",\n                "supporting_quote": "Dosage should be adjusted according to severity of pain and response of the patient.\\nTake (1 - 2) tablets orally every 6-8 hours as needed."\n            },\n            {\n                "set_id": "6972d9c1-36ec-4246-bf7b-13206d5952c3",\n                "passage_id": "PASSAGE_0014",\n                "section": "Glaucoma Dosage",\n                "supporting_quote": "The dosage employed in the treatment of chronic simple (open-angle) glaucoma ranges from 250 mg to 1 g of acetaZOLAMIDE per 24 hours, usually in divided doses for amounts over 250 mg."\n            }\n        ],\n        "structured_fields": {\n            "comparison": {\n                "36adb32c-638c-4d6e-b66a-1a1c35174ce6": {\n                    "dose_or_strength": "1 to 2 tablets (300 mg acetaminophen / 30 mg codeine per tablet)",\n                    "route": "oral",\n                    "frequency": "every 6 to 8 hours as needed (up to every 4 hours)",\n                    "population": "adults (children usual dose of codeine is 0.5 mg/kg)",\n                    "maximum_daily_dose": "determined by prescriber (acetaminophen limit 4000 mg daily)"\n                },\n                "6972d9c1-36ec-4246-bf7b-13206d5952c3": {\n                    "dose_or_strength": "250 mg to 1000 mg daily",\n                    "route": "oral",\n                    "frequency": "once daily or in divided doses",\n                    "population": "adults and children (varies by indication)",\n                    "maximum_daily_dose": "1000 mg (1 g) daily"\n                }\n            }\n        }\n    },\n    {\n        "qid": "cross-a4153187ea298f",\n        "status": "ANSWERED",\n        "answer": "Comparing ACETAZOLAMIDE EXTENDED-RELEASE and Actoplus Met: ACETAZOLAMIDE EXTENDED-RELEASE capsules have a recommended dosage of 1 capsule (500 mg) orally two times a day (morning and evening) for glaucoma or acute mountain sickness, with a maximum daily dose of 2 capsules (1 g) daily. Actoplus Met has a dose of 15 mg pioglitazone and 850 mg metformin HCl per tablet, taken orally with meals, titrated gradually up to a maximum recommended total daily dosage of three tablets per day (45 mg of pioglitazone and 2,550 mg of metformin HCl) for glycemic control in type 2 diabetes mellitus.",\n        "citations": [\n            {\n                "set_id": "8e396b27-b44a-4aa9-805b-086395444b5f",\n                "passage_id": "PASSAGE_0017",\n                "section": "Glaucoma Dosage",\n                "supporting_quote": "The recommended dosage is 1 capsule (500 mg) two times a day."\n            },\n            {\n                "set_id": "42e49120-6f3f-11db-9fe1-0800200c9a66",\n                "passage_id": "PASSAGE_0006",\n                "section": "Dosage and Administration",\n                "supporting_quote": "ACTOPLUS MET may be increased to a maximum recommended total daily dosage of three tablets per day (45 mg of pioglitazone and 2,550 mg of metformin HCl)."\n            }\n        ],\n        "structured_fields": {\n            "comparison": {\n                "8e396b27-b44a-4aa9-805b-086395444b5f": {\n                    "dose_or_strength": "1 capsule (500 mg)",\n                    "route": "oral",\n                    "frequency": "two times a day (morning and evening)",\n                    "population": "patients with glaucoma or acute mountain sickness",\n                    "maximum_daily_dose": "2 capsules (1 g) daily"\n                },\n                "42e49120-6f3f-11db-9fe1-0800200c9a66": {\n                    "dose_or_strength": "15 mg pioglitazone / 850 mg metformin HCl per tablet",\n                    "route": "oral",\n                    "frequency": "titrated gradually up to three times daily",\n                    "population": "patients requiring glycemic control",\n                    "maximum_daily_dose": "three tablets daily (45 mg pioglitazone / 2,550 mg metformin HCl)"\n                }\n            }\n        }\n    },\n    {\n        "qid": "cross-893c71f570b542",\n        "status": "ANSWERED",\n        "answer": "Comparing Acyclovir and Acyclovir suspension: Both formulations contain acyclovir and share the same dosing instructions. For acute treatment of herpes zoster, the dose is 800 mg orally every 4 hours, 5 times daily for 7 to 10 days. For initial genital herpes, the dose is 200 mg every 4 hours, 5 times daily for 10 days. Chronic suppressive therapy is 400 mg twice daily. Chickenpox dosing for children (2 years and older) is 20 mg/kg per dose 4 times daily, and for adults and children over 40 kg is 800 mg 4 times daily for 5 days. The maximum daily dose is 4000 mg (800 mg 5 times daily) for herpes zoster, 1000 mg (200 mg 5 times daily) for genital herpes, and 3200 mg for chickenpox.",\n        "citations": [\n            {\n                "set_id": "dcc29902-1fe6-4713-947e-335503959464",\n                "passage_id": "PASSAGE_0008",\n                "section": "Dosage and Administration",\n                "supporting_quote": "800 mg every 4 hours orally, 5 times daily for 7 to 10\\ndays. 200 mg every 4 hours, 5 times daily for 10 days."\n            },\n            {\n                "set_id": "3efa1e5e-5a14-4724-a2ca-25702f10faed",\n                "passage_id": "PASSAGE_0033",\n                "section": "Dosage and Administration",\n                "supporting_quote": "800\xa0mg\xa0every\xa04\xa0hours\xa0orally,\xa05\xa0times\xa0daily\xa0for\xa07\xa0to\xa010\xa0days."\n            }\n        ],\n        "structured_fields": {\n            "comparison": {\n                "dcc29902-1fe6-4713-947e-335503959464": {\n                    "dose_or_strength": "varies by indication (e.g., 200 mg, 400 mg, 800 mg, 20 mg/kg)",\n                    "route": "oral",\n                    "frequency": "varies by indication (e.g., 2 to 5 times daily)",\n                    "population": "adults and children (2 years of age and older for chickenpox)",\n                    "maximum_daily_dose": "4000 mg daily (for herpes zoster)"\n                },\n                "3efa1e5e-5a14-4724-a2ca-25702f10faed": {\n                    "dose_or_strength":