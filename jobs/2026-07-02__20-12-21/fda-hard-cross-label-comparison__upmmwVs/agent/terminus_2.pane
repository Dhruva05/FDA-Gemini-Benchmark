[?2004l[?2004h>         print(f"  Label: {label['drug_name']} ({set_id})")
[?2004l[?2004h>         for idx, chunk in enumerate(label['chunks']):
[?2004l[?2004h>             # search for keywords like dosing, dose, administration, directions, adult
[?2004l[?2004h>             lower_chunk = chunk.lower()
[?2004l[?2004h>             if any(kw in lower_chunk for kw in ['dose', 'direction', 'route', 'frequency', 'administration', 'adult', 'children']):
[?2004l[?2004h>                 print(f"    PASSAGE_{idx:04d}: {repr(chunk[:150])}...")
