[322.847631, "o", "\u001b[?2004h> "]
[322.847825, "o", "                \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.847911, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
