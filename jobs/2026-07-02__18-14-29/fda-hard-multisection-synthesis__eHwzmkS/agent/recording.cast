[246.383319, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> test_quotes = ["]
[246.383478, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.383592, "o", "    (paxlovid_id, 0, \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.383763, "o", "    (paxlovid_id, 19, \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1.\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.384041, "o", "    (paxlovid_id, 20, \"Nirmatrelvir and ritonavir are CYP3A substrates; therefore, drugs that induce CYP3A may decrease nirmatrelvir and ritonavir plasma concentrations and reduce PAXLOVID therapeutic effect\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.384309, "o", "    (paxlovid_id, 12, \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.384445, "o", "    (lop_rit_id, 1, \"Lopinavir and ritonavir oral solution must be taken with food.\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.384729, "o", "    (lop_rit_id, 2, \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility.\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[246.384846, "o", "> "]
[246.385025, "o", "    (lop_rit_id, 7, \"The dose of the oral solution should be administered using the calibrated cup (supplied) or oral dosing syringe.\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (lop_rit_id, 3, \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.385131, "o", "    (lop_rit_id, 4, \"80 mg/20 mg per mL Oral Solution 800 mg/200 mg (10 mL) once daily\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.385278, "o", "    (lop_rit_id, 5, \"80 mg/20 mg per mL Oral Solution 400 mg/100 mg (5 mL) twice daily\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.385385, "o", "    (lop_rit_id, 6, \"80 mg/20 mg per mL Oral Solution 520 mg/130 mg (6.5 mL) twice daily\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.385613, "o", "    (lop_rit_id, 14, \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.385788, "o", "    (lop_rit_id, 15, \"Lopinavir and ritonavir oral solution contains the excipients ethanol, approximately 42% (v/v) and propylene glycol, approximately 15% (w/v).\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.385994, "o", "    (lop_rit_id, 16, \"Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations.\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.386177, "o", "    (lop_rit_id, 28, \"Commonly reported adverse reactions to lopinavir and ritonavir included diarrhea, nausea, vomiting, hypertriglyceridemia and hypercholesterolemia.\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.386392, "o", "    (lop_rit_id, 18, \"Postmarketing cases of QT interval prolongation and torsade de pointes have been reported although causality of lopinavir and ritonavir could not be established.\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.386516, "o", "    (lop_rit_id, 19, \"Lopinavir and ritonavir prolongs the PR interval in some patients.\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.386774, "o", "    (paxlovid_id, 13, \"Initiation of PAXLOVID, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.386924, "o", "    (paxlovid_id, 14, \"Anaphylaxis and other hypersensitivity reactions have been reported with PAXLOVID\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.387082, "o", "    (paxlovid_id, 15, \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.387406, "o", "    (paxlovid_id, 16, \"Because nirmatrelvir is co-administered with ritonavir, there is a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection.\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.38765, "o", "    (paxlovid_id, 18, \"The most common adverse reactions (≥1% incidence in the PAXLOVID group and occurring at a greater frequency than in the placebo group) were dysgeusia (5% and <1%, respectively) and diarrhea (3% and 2%, respectively).\")\r\n\u001b[?2004l\r"]
[246.387719, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.387783, "o", "for set_id, idx, quote in test_quotes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.387843, "o", "    chunk = labels[set_id]['chunks'][idx]\r\n\u001b[?2004l\r\u001b[?2004h>     if quote in chunk:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.388035, "o", "        print(f\"OK: {set_id[:8]} PASSAGE_{idx:04d}\")\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.388102, "o", "        print(f\"FAIL: {set_id[:8]} PASSAGE_{idx:04d}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[246.388202, "o", "        print(f\"  Expected quote: {repr(quote)}\")\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Chunk start: {repr(chunk[:300])}\")\r\n\u001b[?2004l\r"]
[246.388262, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
