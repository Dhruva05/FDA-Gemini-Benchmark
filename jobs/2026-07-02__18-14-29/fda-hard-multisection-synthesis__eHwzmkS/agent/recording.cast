[322.842296, "o", "\u001b[?2004h>     \"18078efe9380c8dc\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.843213, "o", "        \"answer\": \"Important warnings and precautions associated with lopinavir and ritonavir include: 1) Risk of serious adverse reactions due to drug interactions (as a CYP3A inhibitor); 2) Toxicity in preterm neonates due to ethanol and propylene glycol content; 3) Pancreatitis (sometimes fatal); 4) Hepatotoxicity and hepatic decompensation; 5) QT interval prolongation and torsade de pointes; 6) PR interval prolongation and second or third degree atrioventricular block; 7) New onset or exacerbation of diabetes mellitus and hyperglycemia; 8) Immune reconstitution syndrome; 9) Lipid elevations (total cholesterol and triglycerides); 10) Fat redistribution/accumulation; 11) Increased bleeding in patients with hemophilia; and 12) Potential for development of resistance and cross-resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.84327, "o", "> "]
[322.843294, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n"]
