[322.831103, "o", "        \"answer\": \"Paxlovid is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions. These include: alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in patients with renal and/or hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (for PAH), triazolam, oral midazolam, flibanserin, and tolvaptan. Paxlovid is also contraindicated with strong CYP3A inducers that significantly reduce nirmatrelvir or ritonavir plasma concentrations, including: apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.831201, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.831222, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.831338, "o", ">                 \"set_id\": paxlovid_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.831361, "o", "> "]
[322.831458, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.831613, "o", "                \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.83218, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         ]\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.832338, "o", "    \"daef650b92e56473\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.832855, "o", "        \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. When administering the oral solution by feeding tube, polyurethane feeding tubes should not be used due to potential incompatibility with the ethanol and propylene glycol content; instead, silicone and polyvinyl chloride (PVC) feeding tubes should be used. For pediatric patients, the dose of oral solution should be administered using the supplied calibrated cup or an oral dosing syringe.\",\r\n\u001b[?2004l\rving me\u001b[?2004h>         \"citations\": [\r\n\u001b[?2004l\rdications metabolized b"]
[322.833092, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"set_id\": lop_rit_id,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0001\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"section\": \"2.1 General Administration Recommendations\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.833409, "o", "                \"supporting_quote\": \"oral solution must be taken with food.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"set_id\": lop_rit_id,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0002\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"section\": \"2.2 Administering Oral Solution by Feeding Tube\",\r\n\u001b[?2004l\r  "]
[322.833433, "o", "\u001b[?2004h> "]
[322.833853, "o", "                \"supporting_quote\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\ro\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.834127, "o", "                \"set_id\": lop_rit_id,\r\n\u001b[?2004l\rGE_002\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0007\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"section\": \"2.4 Dosage Recommendations in Pediatric Patients\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.834405, "o", "                \"supporting_quote\": \"The dose of the oral solution should be administered using the calibrated cup (supplied) or oral dosing syringe.\"\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         ]\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     \"a0576a26f2a2eeac\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.835433, "o", "        \"answer\": \"The recommended dosage of lopinavir and ritonavir oral solution in adults is either 800 mg/200 mg (10 mL) once daily, or 400 mg/100 mg (5 mL) twice daily. The dose must be increased to 520 mg/130 mg (6.5 mL) twice daily when administered in combination with efavirenz, nevirapine, or nelfinavir. Once daily dosing is not recommended in pediatric patients, pregnant women, or in combination with carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir, or in patients with three or more lopinavir resistance-associated substitutions.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.835498, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.835515, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
