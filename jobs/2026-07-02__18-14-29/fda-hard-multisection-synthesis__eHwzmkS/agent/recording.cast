[322.828346, "o", "                \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
