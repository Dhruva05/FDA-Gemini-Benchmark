[322.939786, "o", "\u001b[?2004hroot@a1980178bfd8:/workspace# "]
[333.981456, "i", "cat << 'EOF' > validate_answers.py\nimport json\n\nwith open('/workspace/answers.json') as f:\n    data = json.load(f)\n\nprint(\"Keys in answers.json:\", list(data.keys()))\nanswers = data['answers']\nprint(\"Number of answers:\", len(answers))\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = {l['set_id']: l for l in [json.loads(line) for line in f]}\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = {q['qid']: q for q in [json.loads(line) for line in f]}\n\nfor i, ans in enumerate(answers):\n    qid = ans['qid']\n    print(f\"\\n--- Validating Answer {i+1} (qid: {qid}) ---\")\n    assert qid in questions, f\"qid {qid} not in questions!\"\n    assert ans['status'] in ['ANSWERED', 'NOT_FOUND'], f\"invalid status {ans['status']}!\"\n    assert isinstance(ans['answer'], str) and len(ans['answer']) > 0, \"answer must be a non-empty string!\"\n    assert isinstance(ans['citations'], list), \"citations must be a list!\"\n    assert isinstance(ans['structured_fields'], dict), \"structured_fields must be a dict!\"\n    \n    for cit in ans['citations']:\n        set_id = cit['set_id']\n        passage_id = cit['passage_id']\n        section = cit['section']\n        quote = cit['supporting_quote']\n        \n        assert set_id in labels, f\"set_id {set_id} not in labels!\"\n        label = labels[set_id]\n        \n        assert passage_id.startswith('PASSAGE_'), f\"invalid passage_id format {passage_id}!\"\n        idx = int(passage_id.split('_')[1])\n        assert idx < len(label['chunks']), f\"passage index {idx} out of range!\"\n        \n        chunk = label['chunks'][idx]\n        assert quote in chunk, f\"quote {repr(quote)} not found in chunk {passage_id}!\"\n        print(f\"  Citation OK: {passage_id} -> {repr(quote[:50])}...\")\n\nprint(\"\\nAll validations passed successfully!\")\nEOF\npython3 validate_answers.py\n"]
[333.981732, "o", "cat << 'EOF' > validate_answers.py\r\n"]
[333.981868, "o", "\u001b[?2004l\r\u001b[?2004h"]
[333.982191, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[333.982391, "o", "> with open('/workspace/answers.json') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"Keys in answers.json:\", list(data.keys()))\r\n\u001b[?2004l\r\u001b[?2004h> answers = data['answers']\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Number of answers:\", len(answers))\r\n\u001b[?2004l\r"]
[333.982422, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/workspace/data/public/labels.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.982511, "o", "    labels = {l['set_id']: l for l in [json.loads(line) for line in f]}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.982634, "o", "with open('/workspace/data/public/questions.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.982754, "o", ">     questions = {q['qid']: q for q in [json.loads(line) for line in f]}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[333.982814, "o", "> for i, ans in enumerate(answers):\r\n\u001b[?2004l\r"]
[333.982836, "o", "\u001b[?2004h"]
[333.982843, "o", "> "]
[333.983009, "o", "    qid = ans['qid']\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\n--- Validating Answer {i+1} (qid: {qid}) ---\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert qid in questions, f\"qid {qid} not in questions!\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.983122, "o", "    assert ans['status'] in ['ANSWERED', 'NOT_FOUND'], f\"invalid status {ans['status']}!\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.983298, "o", "    assert isinstance(ans['answer'], str) and len(ans['answer']) > 0, \"answer must be a non-empty string!\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.983455, "o", "    assert isinstance(ans['citations'], list), \"citations must be a list!\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.983544, "o", "    assert isinstance(ans['structured_fields'], dict), \"structured_fields must be a dict!\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[333.983572, "o", ">     for cit in ans['citations']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.983866, "o", "        set_id = cit['set_id']\r\n\u001b[?2004l\r\u001b[?2004h>         passage_id = cit['passage_id']\r\n\u001b[?2004l\r\u001b[?2004h>         section = cit['section']\r\n\u001b[?2004l\r\u001b[?2004h>         quote = cit['supporting_quote']\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.983978, "o", "        assert set_id in labels, f\"set_id {set_id} not in labels!\"\r\n\u001b[?2004l\r\u001b[?2004h>         label = labels[set_id]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.984149, "o", "        assert passage_id.startswith('PASSAGE_'), f\"invalid passage_id format {passage_id}!\"\r\n\u001b[?2004l\r"]
[333.984213, "o", "\u001b[?2004h> "]
[333.98431, "o", "        idx = int(passage_id.split('_')[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.984372, "o", ">         assert idx < len(label['chunks']), f\"passage index {idx} out of range!\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.984472, "o", "        chunk = label['chunks'][idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.984541, "o", "        assert quote in chunk, f\"quote {repr(quote)} not found in chunk {passage_id}!\"\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"  Citation OK: {passage_id} -> {repr(quote[:50])}...\")\r\n\u001b[?2004l\r"]
[333.984561, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.984618, "o", "print(\"\\nAll validations passed successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[333.985264, "o", "\u001b[?2004hroot@a1980178bfd8:/workspace# "]
[333.985289, "o", "python3 validate_answers.py\r\n\u001b[?2004l\r"]
