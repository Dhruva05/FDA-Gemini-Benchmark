[88.46196, "i", "cat << 'EOF' > search.py\nimport json, re\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = [json.loads(line) for line in f]\n\ndef search_label(label_idx, query_regex):\n    label = labels[label_idx]\n    print(f\"=== Search in {label['drug_name']} for '{query_regex}' ===\")\n    for i, chunk in enumerate(label['chunks']):\n        if re.search(query_regex, chunk, re.IGNORECASE):\n            first_line = chunk.strip().split('\\n')[0]\n            print(f\"  PASSAGE_{i:04d}: {first_line[:80]}\")\n\nsearch_label(0, 'drug interaction')\nEOF\npython3 search.py\n"]
[88.462212, "o", "cat << 'EOF' > search.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
