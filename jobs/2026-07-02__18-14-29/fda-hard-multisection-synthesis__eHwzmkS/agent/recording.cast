[322.838441, "o", "    \"9be5515bc3064979\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.839562, "o", "        \"answer\": \"The safety risks of lopinavir and ritonavir include serious adverse reactions due to drug interactions (as a CYP3A inhibitor), toxicity in preterm neonates (due to ethanol and propylene glycol content), pancreatitis (which can be fatal), hepatotoxicity (especially in patients with hepatitis B or C), QT and PR interval prolongation (which can lead to atrioventricular block), diabetes mellitus/hyperglycemia, immune reconstitution syndrome, lipid elevations (large increases in cholesterol and triglycerides), fat redistribution, increased bleeding in patients with hemophilia, and resistance/cross-resistance. Commonly reported adverse reactions in adults include diarrhea (reported by at least half of patients on once-daily dosing), nausea, vomiting, hypertriglyceridemia, and hypercholesterolemia.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.839656, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[322.839716, "o", "\u001b[?2004h> "]
