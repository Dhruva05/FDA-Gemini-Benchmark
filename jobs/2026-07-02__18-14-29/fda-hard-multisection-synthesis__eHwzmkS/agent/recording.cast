[322.849578, "o", "    \"2d63e0a82215867f\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.850065, "o", "        \"answer\": \"The safety risks of Paxlovid include serious, life-threatening, or fatal adverse reactions due to drug-drug interactions, hypersensitivity reactions (including anaphylaxis, toxic epidermal necrolysis, and Stevens-Johnson syndrome), hepatotoxicity (transaminase elevations, clinical hepatitis, jaundice), and the risk of HIV-1 resistance development in patients with uncontrolled or undiagnosed HIV-1 infection. In clinical trials, the most common adverse reactions (>=1% incidence and greater than placebo) were dysgeusia (5% vs <1% for placebo) and diarrhea (3% vs 2% for placebo). Other adverse reactions reported during EUA use include headache, hypertension, abdominal pain, nausea, vomiting, and malaise.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.850084, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
