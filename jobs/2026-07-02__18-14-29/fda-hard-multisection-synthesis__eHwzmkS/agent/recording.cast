[135.31768, "o", "PASSAGE_0022: ↑ alfuzosin\r\nPASSAGE_0023: ↑ tamsulosin\r\nPASSAGE_0024: ↑ ranolazine\r\nPASSAGE_0025: ↑ antiarrhythmic\r\nPASSAGE_0026: ↑ antiarrhythmic\r\nPASSAGE_0027: ↓ nirmatrelvir/ritonavir\r\nPASSAGE_0028: Anticancer drugs\r\nPASSAGE_0029: ↑ anticancer drugs\r\nPASSAGE_0030: ↑↓ warfarin\r\nPASSAGE_0031: ↑ rivaroxaban\r\nPASSAGE_0032: ↑ dabigatran\r\nPASSAGE_0033: ↑ apixaban\r\nPASSAGE_0034: ↓ nirmatrelvir/ritonavir\r\nPASSAGE_0035: ↑ anticonvulsant\r\n"]
