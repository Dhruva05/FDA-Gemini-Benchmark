[322.829, "o", "                \"section\": \"7.2 Potential for Other Drugs to Affect PAXLOVID\",\r\n\u001b[?2004l\rven \u001b[?2004h> "]
[322.829394, "o", "                \"supporting_quote\": \"Nirmatrelvir and ritonavir are CYP3A substrates; therefore, drugs that induce CYP3A may decrease nirmatrelvir and ritonavir plasma concentrations and reduce PAXLOVID therapeutic effect\"\r\n\u001b[?2004l\rAdults\"\u001b[?2004h> "]
