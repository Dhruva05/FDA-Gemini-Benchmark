ely).")\n]\n\nfor set_id, idx, quote in test_quotes:\n    chunk = labels[set_id][\'chunks\'][idx]\n    if quote in chunk:\n        print(f"OK: {set_id[:8]} PASSAGE_{idx:04d}")\n    else:\n        print(f"FAIL: {set_id[:8]} PASSAGE_{idx:04d}")\n        print(f"  Expected quote: {repr(quote)}")\n        print(f"  Chunk start: {repr(chunk[:300])}")\nEOF\npython3 verify_quotes.py\n'] min_timeout_sec: 1.5 max_timeout_sec: 180.0
