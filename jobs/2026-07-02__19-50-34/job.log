tations": [\n        {\n          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",\n          "passage_id": "PASSAGE_0012",\n          "section": "4 CONTRAINDICATIONS",\n          "supporting_quote": "PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product."\n        }\n      ],\n      "structured_fields": {}\n    },\n    {\n      "qid": "c4dc176c4827f0ef",\n      "status": "ANSWERED",\n      "answer": "PAXLOVID should not be taken by: 1) Patients with a history of clinically significant hypersensitivity reactions (such as toxic epidermal necrolysis or Stevens-Johnson syndrome) to nirmatrelvir, ritonavir, or any other components of the product; 2) Patients taking medications that are contraindicated due to CYP3A metabolism or strong CYP3A induction; and 3) Patients with severe hepatic impairment (Child-Pugh Class C), for whom PAXLOVID is not recommended. Additionally, although not contraindicated, PAXLOVID is not recommended for pediatric patients as the optimal dose has not been established.",\n      "citations": [\n        {\n          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",\n          "passage_id": "PASSAGE_0012",\n          "section": "4 CONTRAINDICATIONS",\n          "supporting_quote": "PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product."\n        },\n        {\n          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",\n          "passage_id": "PASSAGE_0010",\n          "section": "2.4 Use in Patients with Hepatic Impairment",\n          "supporting_quote": "No pharmacokinetic or safety data are available regarding the use of nirmatrelvir or ritonavir in subjects with severe (Child-Pugh Class C) hepatic impairment; therefore, PAXLOVID is not recommended for use in patients with severe hepatic impairment ."\n        }\n      ],\n      "structured_fields": {}\n    },\n    {\n      "qid": "000ecd1d6df50389",\n      "status": "ANSWERED",\n      "answer": "The recommended dosage for PAXLOVID is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet), with all 3 tablets taken together orally twice daily (morning and bedtime) for 5 days. For patients with moderate renal impairment (eGFR >=30 to <60 mL/min), the dosage is reduced to 150 mg nirmatrelvir (one 150 mg tablet) and 100 mg ritonavir (one 100 mg tablet) twice daily for 5 days. For patients with severe renal impairment (eGFR <30 mL/min), the dose and dose frequency are reduced (300 mg nirmatrelvir and 100 mg ritonavir on Day 1, and 150 mg nirmatrelvir and 100 mg ritonavir on Days 2-5).",\n      "citations": [\n        {\n          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",\n          "passage_id": "PASSAGE_0004",\n          "section": "2.2 Recommended Dosage",\n          "supporting_quote": "The recommended dosage for PAXLOVID is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) with all 3 tablets taken together orally twice daily in the morning and at bedtime for 5 days."\n        },\n        {\n          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",\n          "passage_id": "PASSAGE_0003",\n          "section": "2.1 Important Dosage and Administration Information",\n          "supporting_quote": "PAXLOVID (nirmatrelvir; ritonavir) co-packaged for oral use 300 mg;100 mg (Day 1) and 150 mg;100 mg (Days 2-5) for patients with severe renal impairment"\n        }\n      ],\n      "structured_fields": {}\n    },\n    {\n      "qid": "b54c25890c1ae3a6",\n      "status": "ANSWERED",\n      "answer": "PAXLOVID (both nirmatrelvir and ritonavir tablets) must be co-administered together twice daily for 5 days, with or without food. The tablets must be swallowed whole and not chewed, broken, or crushed. Treatment should be initiated as soon as possible after COVID-19 diagnosis and within 5 days of symptom onset. If a dose is missed within 8 hours of the usual time, the patient should take it as soon as possible and resume the normal schedule. If missed by more than 8 hours, the missed dose should be skipped and the next dose taken at the regular time (do not double the dose).",\n      "citations": [\n        {\n          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",\n          "passage_id": "PASSAGE_0003",\n          "section": "2.1 Important Dosage and Administration Information",\n          "supporting_quote": "PAXLOVID (both nirmatrelvir and ritonavir tablets) can be taken with or without food . The tablets should be swallowed whole and not chewed, broken, or crushed."\n        },\n        {\n          "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",\n          "passage_id": "PASSAGE_0176",\n          "section": "Administration Instructions",\n          "supporting_quote": "If the patient misses a dose of PAXLOVID within 8 hours of the time it is usually taken, the patient should take it as soon as possible and resume the normal dosing schedule."\n        }\n      ],\n      "structured_fields": {}\n    }\n  ]\n}\n\nwith open(\'/workspace/answers.json\', \'w\') as f:\n    json.dump(answers_data, f, indent=2)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
