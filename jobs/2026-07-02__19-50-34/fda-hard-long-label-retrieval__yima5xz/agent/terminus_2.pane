[?2004l[?2004h>         data = json.loads(line)
[?2004l[?2004h>         chunks = data.get('chunks', [])
[?2004l[?2004h>         for idx in selected:
[?2004l[?2004h>             if idx < len(chunks):
[?2004l[?2004h>                 with open(f'chunk_{idx:03d}.txt', 'w') as out:
[?2004l[?2004h>                     out.write(chunks[idx])
