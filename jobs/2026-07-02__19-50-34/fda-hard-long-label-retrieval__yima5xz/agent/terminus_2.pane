import json
with open('/workspace/data/public/labels.jsonl') as f:
    for line in f:
        data = json.loads(line)
        print('set_id:', data.get('set_id'))
        print('drug_name:', data.get('drug_name'))
        print('keys:', list(data.keys()))
        print('num_chunks:', len(data.get('chunks', [])))
        if data.get('chunks'):
            print('chunk 0 keys:', list(data['chunks'][0].keys()))
            print('chunk 0 sample:', str(data['chunks'][0])[:300])
