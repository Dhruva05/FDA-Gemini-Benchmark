[290.06623, "o", "          \"passage_id\": \"PASSAGE_0176\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.066288, "o", "          \"section\": \"Administration Instructions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.066487, "o", "          \"supporting_quote\": \"If the patient misses a dose of PAXLOVID within 8 hours of the time it is usually taken, the patient should take it as soon as possible and resume the normal dosing schedule.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
