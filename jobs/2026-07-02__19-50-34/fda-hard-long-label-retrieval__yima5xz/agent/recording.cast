[62.577965, "i", "cat << 'EOF' > test_passages.py\nimport json\nimport re\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        raw = data.get('label_raw', '')\n        chunks = data.get('chunks', [])\n        print('Length of chunks:', len(chunks))\n        parts = re.split(r'\\|\\|PASSAGE_\\d{4}\\|\\|', raw)\n        print('Length of split parts:', len(parts))\n        for idx in range(min(5, len(chunks))):\n            print(f'Chunk {idx} length: {len(chunks[idx])}')\n            print(f'Part {idx} length: {len(parts[idx])}')\n            c_strip = chunks[idx].strip()\n            p_strip = parts[idx].strip()\n            print(f'Match? {c_strip == p_strip}')\nEOF\n"]
