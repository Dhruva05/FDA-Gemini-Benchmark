[237.201621, "o", "\u001b[?2004h> "]
[237.201653, "o", "import json\r\n\u001b[?2004l\r-1"]
[237.201665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.201911, "o", "answers_data = {\r\n\u001b[?2004l\r,\r\n    \u001b[?2004h>   \"answers\": [\r\n\u001b[?2004l\r  \"citations\": \u001b[?2004h>     {\r\n\u001b[?2004l\r[\r\n    \u001b[?2004h> "]
[237.202128, "o", "      \"qid\": \"b2531657ba5c7a78\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.202281, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.204251, "o", "      \"answer\": \"PAXLOVID contains ritonavir, which is a strong CYP3A inhibitor. This can lead to increased plasma concentrations of concomitant medications metabolized by CYP3A, potentially resulting in severe, life-threatening, or fatal events. Conversely, concomitant use of strong CYP3A inducers can decrease PAXLOVID concentrations, leading to a loss of therapeutic effect and the potential development of viral resistance. Commonly reported serious adverse reactions due to interactions include calcineurin inhibitors (e.g., tacrolimus, cyclosporine) and calcium channel blockers. Prior to prescribing, healthcare providers must review all medications to assess potential interactions and determine if dose adjustments, interruptions, or additional monitoring are required.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.204302, "o", "      \"citations\": [\r\n\u001b[?2004l\rd6"]
[237.204444, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.204518, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r"]
[237.204624, "o", "\u001b[?2004h> "]
[237.204692, "o", "          \"passage_id\": \"PASSAGE_0000\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.204827, "o", "          \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\r\n\u001b[?2004l\r"]
[237.204902, "o", "\u001b[?2004h> "]
[237.205372, "o", "          \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[237.205394, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r"]
[237.205435, "o", "\u001b[?2004h"]
[237.205527, "o", "> "]
[237.205564, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.205687, "o", "          \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.205778, "o", "          \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.206217, "o", "          \"supporting_quote\": \"The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[237.206295, "o", "\u001b[?2004h>       ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.206389, "o", "      \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\rme fa"]
[237.206452, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\rtal) d\u001b[?2004h"]
[237.206472, "o", "> "]
[237.206526, "o", "      \"qid\": \"6f12607a1ba14dd5\",\r\n\u001b[?2004l\rctions invo\u001b[?2004h> "]
[237.206663, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rin\u001b[?2004h> "]
[237.208216, "o", "      \"answer\": \"Medications that should be avoided (contraindicated) with PAXLOVID include drugs primarily metabolized by CYP3A for which elevated concentrations are associated with serious and/or life-threatening reactions, and strong CYP3A inducers which significantly reduce PAXLOVID plasma concentrations. Examples of medications to avoid include: alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in renal/hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (for PAH), triazolam, oral midazolam, flibanserin, and tolvaptan. Strong CYP3A inducers to avoid include apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.208364, "o", "      \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
