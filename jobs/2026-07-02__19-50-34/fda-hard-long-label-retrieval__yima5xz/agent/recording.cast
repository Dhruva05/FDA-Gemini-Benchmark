[100.460125, "o", "000: WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\r\n001: 1 INDICATIONS AND USAGE\r\n002: Limitations of Use\r\n003: 2.1\tImportant Dosage and Administration Information\r\n004: 2.2\tRecommended Dosage\r\n005: 2.3 Dosage in Patients with Renal Impairment\r\n006: Days of Treatment\r\n007: Days 1-5\r\n008: Day 1\r\n009: Days 2-5\r\n010: 2.4\tUse in Patients with Hepatic Impairment\r\n011: 3 DOSAGE FORMS AND STRENGTHS\r\n012: 4 CONTRAINDICATIONS\r\n013: 5.1\tRisk of Serious Adverse Reactions Due to Drug Interactions\r\n014: 5.2\tHypersensitivity Reactions\r\n015: 5.3\tHepatotoxicity\r\n016: 5.4\tRisk of HIV-1 Resistance Development\r\n017: 6 ADVERSE REACTIONS\r\n018: 6.1\tClinical Trials Experience\r\n019: 7.1\tPotential for PAXLOVID to Affect Other Drugs\r\n020: 7.2\tPotential for Other Drugs to Affect PAXLOVID\r\n021: 7.3\tEstablished and Other Potentially Significant Drug Interactions\r\n022: ↑ alfuzosin\r\n023: ↑ tamsulosin\r\n024: ↑ ranolazine\r\n025: ↑ antiarrhythmic\r\n026: ↑ antiarrhythmic\r\n027: ↓ nirmatrelvir/ritonavir\r\n028: Anticancer drugs\r\n029: ↑ anticancer drugs\r\n030: ↑↓ warfarin\r\n031: ↑ rivaroxaban\r\n032: ↑ dabigatran\r\n033: ↑ apixaban\r\n034: ↓ nirmatrelvir/ritonavir\r\n035: ↑ anticonvulsant\r\n036: ↓ bupropion and active metabolite hydroxy-bupropion\r\n037: ↑ trazodone\r\n038: ↓ voriconazole\r\n039: ↑ ketoconazole↑ isavuconazonium sulfate↑ itraconazole\r\n040: ↑ nirmatrelvir/ritonavir\r\n041: ↑ colchicine\r\n042: ↑ protease inhibitor\r\n043: efavirenz,maraviroc,nevirapine,zidovudine,bictegravir/ emtricitabine/ tenofovir\r\n044: ↑ clarithromycin↑ erythromycin\r\n045: ↓ nirmatrelvir/ritonavir\r\n046: ↑ bedaquiline\r\n047: ↑ rifabutin\r\n048: ↑ lurasidone↑ pimozide\r\n049: ↑ quetiapine\r\n"]
