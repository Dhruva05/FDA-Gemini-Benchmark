[43.754968, "i", "cat << 'EOF' > inspect_passage_format.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        for idx, chunk in enumerate(data['chunks']):\n            if 'PASSAGE_' in chunk:\n                print(f\"Chunk {idx} has 'PASSAGE_':\")\n                print(chunk[:200])\n                print(\"-\"*40)\n            else:\n                print(f\"Chunk {idx} does NOT have 'PASSAGE_'\")\n            if idx >= 5:\n                break\nEOF\n"]
