[237.215334, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.215433, "o", "          \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.215556, "o", "          \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.215819, "o", "          \"supporting_quote\": \"Severe, life-threatening, and/or fatal adverse reactions due to drug interactions have been reported in patients treated with PAXLOVID.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.215877, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\r\n        {\u001b[?2004h> "]
[237.215981, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.216064, "o", "          \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r"]
[237.216083, "o", "\u001b[?2004h> "]
[237.216234, "o", "          \"section\": \"5.2 Hypersensitivity Reactions\",\r\n\u001b[?2004l\r    \u001b[?2004h> "]
[237.216552, "o", "          \"supporting_quote\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\ra"]
[237.216606, "o", "\u001b[?2004h> "]
[237.216627, "o", "      ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.216694, "o", "      \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.21671, "o", ">     },\r\n\u001b[?2004l\r"]
[237.216799, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.216908, "o", "      \"qid\": \"cf74a5a8ac9b19de\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.217032, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.217101, "o", "> "]
[237.218027, "o", "      \"answer\": \"PAXLOVID is contraindicated in: 1) Patients with a history of clinically significant hypersensitivity reactions (e.g., toxic epidermal necrolysis or Stevens-Johnson syndrome) to its active ingredients (nirmatrelvir or ritonavir) or any other components; 2) Co-administration with drugs primarily metabolized by CYP3A for which elevated concentrations are associated with serious and/or life-threatening reactions; and 3) Co-administration with drugs that are strong CYP3A inducers where significantly reduced plasma concentrations of nirmatrelvir or ritonavir may lead to loss of virologic response and possible resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.218097, "o", "      \"citations\": ["]
[237.218112, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.218189, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.218337, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.218467, "o", "          \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\rin 8 \u001b[?2004h> "]
[237.218568, "o", "          \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.219119, "o", "          \"supporting_quote\": \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n"]
[237.219132, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[237.219171, "o", "      ],\r\n\u001b[?2004l\r \"PASSAGE\u001b[?2004h> "]
[237.219304, "o", "      \"structured_fields\": {}\r\n\u001b[?2004l\r \"\u001b[?2004h> "]
[237.219375, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\rortant\u001b[?2004h> "]
[237.219517, "o", "      \"qid\": \"c4dc176c4827f0ef\",\r\n\u001b[?2004l\rm\u001b[?2004h> "]
[237.219575, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rrtin\u001b[?2004h> "]
[237.22064, "o", "      \"answer\": \"PAXLOVID should not be taken by: 1) Patients with a history of clinically significant hypersensitivity reactions (such as toxic epidermal necrolysis or Stevens-Johnson syndrome) to nirmatrelvir, ritonavir, or any other components of the product; 2) Patients taking medications that are contraindicated due to CYP3A metabolism or strong CYP3A induction; and 3) Patients with severe hepatic impairment (Child-Pugh Class C), for whom PAXLOVID is not recommended. Additionally, although not contraindicated, PAXLOVID is not recommended for pediatric patients as the optimal dose has not been established.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.22071, "o", "      \"citations\": [\r\n\u001b[?2004l\rw\u001b[?2004h> "]
[237.220795, "o", "        {\r\n\u001b[?2004l\r',\u001b[?2004h> "]
[237.22089, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.220947, "o", "          \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.221034, "o", "          \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.221236, "o", "          \"supporting_quote\": \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.22128, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.221326, "o", ">         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.22139, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.221444, "o", "          \"passage_id\": \"PASSAGE_0010\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.221477, "o", "          \"section\": \"2.4 Use in Patients with Hepatic Impairment\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.221739, "o", "          \"supporting_quote\": \"No pharmacokinetic or safety data are available regarding the use of nirmatrelvir or ritonavir in subjects with severe (Child-Pugh Class C) hepatic impairment; therefore, PAXLOVID is not recommended for use in patients with severe hepatic impairment .\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.221795, "o", ">       ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.221862, "o", "      \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[237.221905, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.221942, "o", "      \"qid\": \"000ecd1d6df50389\",\r\n\u001b[?2004l\r\u001b[?2004h>       \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[237.22199, "o", "\u001b[?2004h> "]
[237.222545, "o", "      \"answer\": \"The recommended dosage for PAXLOVID is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet), with all 3 tablets taken together orally twice daily (morning and bedtime) for 5 days. For patients with moderate renal impairment (eGFR >=30 to <60 mL/min), the dosage is reduced to 150 mg nirmatrelvir (one 150 mg tablet) and 100 mg ritonavir (one 100 mg tablet) twice daily for 5 days. For patients with severe renal impairment (eGFR <30 mL/min), the dose and dose frequency are reduced (300 mg nirmatrelvir and 100 mg ritonavir on Day 1, and 150 mg nirmatrelvir and 100 mg ritonavir on Days 2-5).\",\r\n\u001b[?2004l\r"]
[237.222562, "o", "\u001b[?2004h>       \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.222608, "o", ">         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.222662, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.222737, "o", "          \"passage_id\": \"PASSAGE_0004\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.222795, "o", "          \"section\": \"2.2 Recommended Dosage\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.22301, "o", "          \"supporting_quote\": \"The recommended dosage for PAXLOVID is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) with all 3 tablets taken together orally twice daily in the morning and at bedtime for 5 days.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[237.223042, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.223118, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.223189, "o", "          \"passage_id\": \"PASSAGE_0003\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.223254, "o", "          \"section\": \"2.1 Important Dosage and Administration Information\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.223402, "o", "          \"supporting_quote\": \"PAXLOVID (nirmatrelvir; ritonavir) co-packaged for oral use 300 mg;100 mg (Day 1) and 150 mg;100 mg (Days 2-5) for patients with severe renal impairment\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.223469, "o", "      ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.223538, "o", "      \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.223591, "o", ">     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.223647, "o", "      \"qid\": \"b54c25890c1ae3a6\",\r\n\u001b[?2004l\r\u001b[?2004h>       \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.223663, "o", "> "]
[237.224159, "o", "      \"answer\": \"PAXLOVID (both nirmatrelvir and ritonavir tablets) must be co-administered together twice daily for 5 days, with or without food. The tablets must be swallowed whole and not chewed, broken, or crushed. Treatment should be initiated as soon as possible after COVID-19 diagnosis and within 5 days of symptom onset. If a dose is missed within 8 hours of the usual time, the patient should take it as soon as possible and resume the normal schedule. If missed by more than 8 hours, the missed dose should be skipped and the next dose taken at the regular time (do not double the dose).\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.224207, "o", "      \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r"]
[237.224242, "o", "\u001b[?2004h> "]
[237.224292, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.224328, "o", "          \"passage_id\": \"PASSAGE_0003\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.224421, "o", "          \"section\": \"2.1 Important Dosage and Administration Information\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.224606, "o", "          \"supporting_quote\": \"PAXLOVID (both nirmatrelvir and ritonavir tablets) can be taken with or without food . The tablets should be swallowed whole and not chewed, broken, or crushed.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[237.22462, "o", "\u001b[?2004h> "]
[237.224658, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.224723, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.224767, "o", "          \"passage_id\": \"PASSAGE_0176\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.224842, "o", "          \"section\": \"Administration Instructions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.225007, "o", "          \"supporting_quote\": \"If the patient misses a dose of PAXLOVID within 8 hours of the time it is usually taken, the patient should take it as soon as possible and resume the normal dosing schedule.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[237.225054, "o", "\u001b[?2004h>       ],\r\n\u001b[?2004l\r"]
[237.225075, "o", "\u001b[?2004h>       \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.225121, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>   ]\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[237.225139, "o", "\u001b[?2004h> "]
[237.225196, "o", "with open('/workspace/answers.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
