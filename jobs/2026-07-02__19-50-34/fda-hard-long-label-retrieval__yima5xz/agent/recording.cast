[290.051942, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[290.05208, "o", "\u001b[?2004h> "]
[290.052795, "o", "      \"answer\": \"The important warnings and precautions associated with PAXLOVID include: 1) Risk of serious adverse reactions due to drug interactions (strong CYP3A inhibition of concomitant drugs or reduction of PAXLOVID concentrations by inducers); 2) Hypersensitivity reactions, including anaphylaxis, toxic epidermal necrolysis (TEN), and Stevens-Johnson syndrome; 3) Hepatotoxicity, including hepatic transaminase elevations, clinical hepatitis, and jaundice; and 4) Risk of HIV-1 resistance development in individuals with uncontrolled or undiagnosed HIV-1 infection.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.052857, "o", "      \"citations\": [\r\n\u001b[?2004l\r"]
[290.052913, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.052988, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\","]
[290.053065, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.053087, "o", "          \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.053186, "o", "          \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r \u001b[?2004h> "]
[290.053508, "o", "          \"supporting_quote\": \"Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[290.053528, "o", "\u001b[?2004h> "]
[290.053551, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.05366, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\rain\u001b[?2004h> "]
[290.053798, "o", "          \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.053912, "o", "> "]
[290.053953, "o", "          \"section\": \"5.2 Hypersensitivity Reactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.054345, "o", "          \"supporting_quote\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.054363, "o", "        },\r\n\u001b[?2004l\r \u001b[?2004h> "]
[290.054411, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.054531, "o", "> "]
[290.054606, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.054707, "o", "          \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.05477, "o", "          \"section\": \"5.3 Hepatotoxicity\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.055062, "o", "          \"supporting_quote\": \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.055079, "o", "        },\r\n\u001b[?2004l\rions e\u001b[?2004h> "]
[290.055124, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.055271, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r"]
[290.055286, "o", "\u001b[?2004h> "]
[290.055347, "o", "          \"passage_id\": \"PASSAGE_0016\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.055501, "o", "          \"section\": \"5.4 Risk of HIV-1 Resistance Development\",\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[290.055894, "o", "          \"supporting_quote\": \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.055984, "o", "        }\r\n\u001b[?2004l\r"]
[290.056074, "o", "\u001b[?2004h>       ],\r\n\u001b[?2004l\r\u001b[?2004h>       \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[290.056107, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.056164, "o", "      \"qid\": \"2d63e0a82215867f\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.056233, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.056911, "o", "      \"answer\": \"Safety risks listed for PAXLOVID include: 1) Serious adverse reactions (some fatal) due to drug-drug interactions involving CYP3A inhibition or induction; 2) Serious hypersensitivity reactions such as anaphylaxis, toxic epidermal necrolysis, and Stevens-Johnson syndrome; 3) Hepatotoxicity, including hepatic transaminase elevations, clinical hepatitis, and jaundice; and 4) Risk of HIV-1 resistance development in patients with uncontrolled or undiagnosed HIV-1 infection.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.056989, "o", "      \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r60 mL/min)\u001b[?2004h> "]
[290.057126, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\rmg t\u001b[?2004h> "]
[290.057148, "o", "          \"passage_id\": \"PASSAGE_0013\","]
[290.057202, "o", "\r\n\u001b[?2004l\r"]
[290.057229, "o", "\u001b[?2004h> "]
[290.057389, "o", "          \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.057625, "o", "          \"supporting_quote\": \"Severe, life-threatening, and/or fatal adverse reactions due to drug interactions have been reported in patients treated with PAXLOVID.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.057679, "o", ">         },\r\n\u001b[?2004l\r\u001b[?2004h>         {"]
[290.057761, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.057817, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.057913, "o", "          \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r\",\u001b[?2004h> "]
[290.05801, "o", "          \"section\": \"5.2 Hypersensitivity Reactions\",\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[290.058351, "o", "          \"supporting_quote\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\r\n\u001b[?2004l\rhe mor\u001b[?2004h> "]
[290.058437, "o", "        }\r\n\u001b[?2004l\r a\u001b[?2004h> "]
[290.058461, "o", "      ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.05852, "o", "      \"structured_fields\": {}\r\n\u001b[?2004l\r   \u001b[?2004h>     },\r\n"]
[290.058561, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[290.058614, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.058683, "o", "      \"qid\": \"cf74a5a8ac9b19de\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.058739, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.058819, "o", "> "]
[290.059773, "o", "      \"answer\": \"PAXLOVID is contraindicated in: 1) Patients with a history of clinically significant hypersensitivity reactions (e.g., toxic epidermal necrolysis or Stevens-Johnson syndrome) to its active ingredients (nirmatrelvir or ritonavir) or any other components; 2) Co-administration with drugs primarily metabolized by CYP3A for which elevated concentrations are associated with serious and/or life-threatening reactions; and 3) Co-administration with drugs that are strong CYP3A inducers where significantly reduced plasma concentrations of nirmatrelvir or ritonavir may lead to loss of virologic response and possible resistance.\",\r\n\u001b[?2004l\r"]
[290.059796, "o", "\u001b[?2004h>       \"citations\": [\r\n\u001b[?2004l\r"]
[290.059877, "o", "\u001b[?2004h> "]
[290.059956, "o", "        {\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[290.060028, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.060128, "o", "          \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r "]
[290.060202, "o", "\u001b[?2004h> "]
[290.060217, "o", "          \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.060693, "o", "          \"supporting_quote\": \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n"]
[290.06072, "o", "\u001b[?2004l\r"]
[290.060768, "o", "\u001b[?2004h>       ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.060813, "o", "      \"structured_fields\": {}\r\n\u001b[?2004l\r"]
[290.060833, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\rp\u001b[?2004h"]
[290.060846, "o", "> "]
[290.060893, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.060986, "o", "      \"qid\": \"c4dc176c4827f0ef\",\r\n\u001b[?2004l\rm\u001b[?2004h> "]
[290.061097, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rin\u001b[?2004h> "]
[290.062072, "o", "      \"answer\": \"PAXLOVID should not be taken by: 1) Patients with a history of clinically significant hypersensitivity reactions (such as toxic epidermal necrolysis or Stevens-Johnson syndrome) to nirmatrelvir, ritonavir, or any other components of the product; 2) Patients taking medications that are contraindicated due to CYP3A metabolism or strong CYP3A induction; and 3) Patients with severe hepatic impairment (Child-Pugh Class C), for whom PAXLOVID is not recommended. Additionally, although not contraindicated, PAXLOVID is not recommended for pediatric patients as the optimal dose has not been established.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.062122, "o", "      \"citations\": [\r\n\u001b[?2004l\r"]
[290.06218, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\rers.json',"]
[290.062208, "o", "\u001b[?2004h> "]
[290.062307, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.062368, "o", "          \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.062448, "o", "          \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.06271, "o", "          \"supporting_quote\": \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.06276, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.062823, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.062881, "o", "          \"passage_id\": \"PASSAGE_0010\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.062952, "o", "          \"section\": \"2.4 Use in Patients with Hepatic Impairment\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.063189, "o", "          \"supporting_quote\": \"No pharmacokinetic or safety data are available regarding the use of nirmatrelvir or ritonavir in subjects with severe (Child-Pugh Class C) hepatic impairment; therefore, PAXLOVID is not recommended for use in patients with severe hepatic impairment .\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.063237, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>       ],\r\n\u001b[?2004l\r"]
[290.063249, "o", "\u001b[?2004h> "]
[290.063297, "o", "      \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.063326, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.063377, "o", "> "]
[290.063406, "o", "      \"qid\": \"000ecd1d6df50389\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.063469, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064012, "o", "      \"answer\": \"The recommended dosage for PAXLOVID is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet), with all 3 tablets taken together orally twice daily (morning and bedtime) for 5 days. For patients with moderate renal impairment (eGFR >=30 to <60 mL/min), the dosage is reduced to 150 mg nirmatrelvir (one 150 mg tablet) and 100 mg ritonavir (one 100 mg tablet) twice daily for 5 days. For patients with severe renal impairment (eGFR <30 mL/min), the dose and dose frequency are reduced (300 mg nirmatrelvir and 100 mg ritonavir on Day 1, and 150 mg nirmatrelvir and 100 mg ritonavir on Days 2-5).\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064029, "o", "      \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064106, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.064137, "o", ">           \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064193, "o", "          \"passage_id\": \"PASSAGE_0004\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064242, "o", "          \"section\": \"2.2 Recommended Dosage\",\r\n\u001b[?2004l\r"]
[290.064303, "o", "\u001b[?2004h> "]
[290.064513, "o", "          \"supporting_quote\": \"The recommended dosage for PAXLOVID is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) with all 3 tablets taken together orally twice daily in the morning and at bedtime for 5 days.\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n"]
[290.064529, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[290.064573, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064639, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064699, "o", "          \"passage_id\": \"PASSAGE_0003\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064778, "o", "          \"section\": \"2.1 Important Dosage and Administration Information\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064928, "o", "          \"supporting_quote\": \"PAXLOVID (nirmatrelvir; ritonavir) co-packaged for oral use 300 mg;100 mg (Day 1) and 150 mg;100 mg (Days 2-5) for patients with severe renal impairment\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064941, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.064998, "o", "      ],\r\n\u001b[?2004l\r\u001b[?2004h>       \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.065044, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.065113, "o", "      \"qid\": \"b54c25890c1ae3a6\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.065129, "o", "      \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.065636, "o", "      \"answer\": \"PAXLOVID (both nirmatrelvir and ritonavir tablets) must be co-administered together twice daily for 5 days, with or without food. The tablets must be swallowed whole and not chewed, broken, or crushed. Treatment should be initiated as soon as possible after COVID-19 diagnosis and within 5 days of symptom onset. If a dose is missed within 8 hours of the usual time, the patient should take it as soon as possible and resume the normal schedule. If missed by more than 8 hours, the missed dose should be skipped and the next dose taken at the regular time (do not double the dose).\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.065655, "o", "      \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r"]
[290.0657, "o", "\u001b[?2004h> "]
[290.065766, "o", "          \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.065853, "o", "          \"passage_id\": \"PASSAGE_0003\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.065869, "o", "          \"section\": \"2.1 Important Dosage and Administration Information\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.066046, "o", "          \"supporting_quote\": \"PAXLOVID (both nirmatrelvir and ritonavir tablets) can be taken with or without food . The tablets should be swallowed whole and not chewed, broken, or crushed.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.066091, "o", "        },\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r"]
[290.066143, "o", "\u001b[?2004h> "]
