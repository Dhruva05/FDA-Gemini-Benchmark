[48.397195, "i", "cat << 'EOF' > find_passage_string.py\nimport json\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        for key, val in data.items():\n            if isinstance(val, str) and 'PASSAGE_' in val:\n                print(f\"Found in key '{key}': ...{val[val.index('PASSAGE_')-50:val.index('PASSAGE_')+150]}...\")\n            elif isinstance(val, list):\n                for idx, item in enumerate(val):\n                    if isinstance(item, str) and 'PASSAGE_' in item:\n                        print(f\"Found in list key '{key}' index {idx}: ...{item[item.index('PASSAGE_')-50:item.index('PASSAGE_')+150]}...\")\nEOF\n"]
