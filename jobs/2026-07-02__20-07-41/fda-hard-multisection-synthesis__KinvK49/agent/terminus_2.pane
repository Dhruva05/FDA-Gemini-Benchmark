[?2004limport json, re

with open('/workspace/data/public/labels.jsonl') as f:
    labels = [json.loads(line) for line in f]

def search_drug(drug_name, keywords):
    for label in labels:
        if label['drug_name'].lower() == drug_name.lower():
            print(f"=== {label['drug_name']} ({label['set_id']}) ===")
            for idx, chunk in enumerate(label['chunks']):
                if any(re.search(r'\\b' + re.escape(kw) + r'\\b', chunk, re.IGNORECASE) for kw in keywords):
                    print(f"PASSAGE_{idx:04d} (len={len(chunk)}):")
                    lines = chunk.strip().split('\n')
                    print("  Header:", lines[0])
                    print("  Snippet:", ' | '.join(lines[1:4]))
                    print("-" * 40)

print("Search Paxlovid interactions:")
search_drug("Paxlovid", ["interaction", "co-administered", "cyp3a"])
