[?2004l[?2004h>                 "section": "Recommended Dosage",
[?2004l[?2004h>                 "supporting_quote": "80 mg/20 mg per mL Oral Solution 520 mg/130 mg (6.5 mL) twice daily"
[?2004l[?2004h>             },
[?2004l     [?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004lnd torsad[?2004h>                 "passage_id": "PASSAGE_0007",
[?2004lusa[?2004h>                 "section": "2.4 Dosage Recommendations in Pediatric Patients",
[?2004l[?2004h>                 "supporting_quote": "Lopinavir and ritonavir oral solution is not recommended for once daily dosing in pediatric patients younger than 18 years of age."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l "s[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0012",
[?2004lthird d[?2004h>                 "section": "2.5 Dosage Recommendations in Pregnancy",
[?2004l  [?2004h>                 "supporting_quote": "Administer 400/100 mg of lopinavir and ritonavir twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions."
[?2004l[?2004h>             }
[?2004l[?2004h>         ],
[?2004l[?2004h>         "structured_fields": {}
[?2004lreac[?2004h>     },
[?2004l[?2004h>     {
[?2004ldue to [?2004h>         "qid": "9be5515bc3064979",
[?2004l[?2004h>         "status": "ANSWERED",
[?2004lfe-threatenin[?2004h>         "answer": "The safety risks listed for lopinavir and ritonavir include: 1) Risk of serious adverse reactions due to drug interactions, potentially leading to severe, life-threatening, or fatal events. 2) Toxicity in preterm neonates due to high ethanol and propylene glycol content in the oral solution, which can cause life-threatening cardiac toxicity (complete AV block, bradycardia, cardiomyopathy), lactic acidosis, acute renal failure, CNS depression, and respiratory complications. 3) Pancreatitis (including fatalities), particularly in patients with marked triglyceride elevations. 4) Hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation, and fatalities), especially in patients with underlying hepatitis B or C or cirrhosis. 5) QT interval prolongation and torsade de pointes. 6) PR interval prolongation, which can cause second or third-degree AV block. 7) Diabetes mellitus, hyperglycemia, or diabetic ketoacidosis. 8) Immune reconstitution syndrome and autoimmune disorders. 9) Large elevations in total cholesterol and triglycerides. 10) Fat redistribution and accumulation. 11) Increased bleeding in patients with hemophilia. 12) Potential development of HIV resistance or cross-resistance.",
[?2004l[?2004h>         "citations": [
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0014",
[?2004l[?2004h>                 "section": "5.1 Risk of Serious Adverse Reactions Due to Drug Interactions",
[?2004l[?2004h>                 "supporting_quote": "These interactions may lead to: Clinically significant adverse reactions, potentially leading to severe, life-threatening, or fatal events from greater exposures of concomitant medications."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0015",
[?2004l[?2004h>                 "section": "5.2 Toxicity in Preterm Neonates",
[?2004l[?2004h>                 "supporting_quote": "Postmarketing life-threatening cases of cardiac toxicity (including complete AV block, bradycardia, and cardiomyopathy), lactic acidosis, acute renal failure, CNS depression and respiratory complications leading to death have been reported, predominantly in preterm neonates receiving lopinavir and ritonavir oral solution."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0016",
[?2004l[?2004h>                 "section": "5.3 Pancreatitis",
[?2004l[?2004h>                 "supporting_quote": "Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0017",
[?2004l[?2004h>                 "section": "5.4 Hepatotoxicity",
[?2004l[?2004h>                 "supporting_quote": "There have been postmarketing reports of hepatic dysfunction, including some fatalities."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0018",
[?2004l[?2004h>                 "section": "5.5 QT Interval Prolongation",
[?2004l[?2004h>                 "supporting_quote": "Postmarketing cases of QT interval prolongation and torsade de pointes have been reported although causality of lopinavir and ritonavir could not be established."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0019",
[?2004l[?2004h>                 "section": "5.6 PR Interval Prolongation",
[?2004l[?2004h>                 "supporting_quote": "Lopinavir and ritonavir prolongs the PR interval in some patients. Cases of second or third degree atrioventricular block have been reported."
[?2004l[?2004h>             }
[?2004l[?2004h>         ],
[?2004l[?2004h>         "structured_fields": {}
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>         "qid": "18078efe9380c8dc",
[?2004l[?2004h>         "status": "ANSWERED",
[?2004l[?2004h>         "answer": "The warnings and precautions associated with lopinavir and ritonavir include: 1) Risk of serious adverse reactions due to drug interactions (potentially leading to severe, life-threatening, or fatal events). 2) Toxicity in preterm neonates due to high ethanol and propylene glycol content in the oral solution, which can cause life-threatening cardiac toxicity (complete AV block, bradycardia, cardiomyopathy), lactic acidosis, acute renal failure, CNS depression, and respiratory complications. 3) Pancreatitis (including fatalities), particularly in patients with marked triglyceride elevations. 4) Hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation, and fatalities), especially in patients with underlying hepatitis B or C or cirrhosis. 5) QT interval prolongation and torsade de pointes. 6) PR interval prolongation, which can cause second or third-degree AV block. 7) Diabetes mellitus, hyperglycemia, or diabetic ketoacidosis. 8) Immune reconstitution syndrome and autoimmune disorders. 9) Large elevations in total cholesterol and triglycerides. 10) Fat redistribution and accumulation. 11) Increased bleeding in patients with hemophilia. 12) Potential development of HIV resistance or cross-resistance.",
