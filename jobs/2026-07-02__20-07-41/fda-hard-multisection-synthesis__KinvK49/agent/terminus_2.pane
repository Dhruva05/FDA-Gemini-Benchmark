[?2004l[?2004h> 
[?2004l[?2004h> def search_drug(drug_name, keywords):
[?2004l[?2004h>     for label in labels:
[?2004l[?2004h>         if label['drug_name'].lower() == drug_name.lower():
[?2004l[?2004h>             print(f"=== {label['drug_name']} ({label['set_id']}) ===")
[?2004l[?2004h>             for idx, chunk in enumerate(label['chunks']):
[?2004l[?2004h>                 if any(kw.lower() in chunk.lower() for kw in keywords):
[?2004l[?2004h>                     print(f"PASSAGE_{idx:04d} (len={len(chunk)}):")
[?2004l[?2004h>                     lines = chunk.strip().split('\n')
[?2004l[?2004h>                     print("  Header:", lines[0])
[?2004l[?2004h>                     print("  Snippet:", ' | '.join(lines[1:4]))
[?2004l[?2004h>                     print("-" * 40)
