[66.97498, "o", "import json, re\r\n\r\nwith open('/workspace/data/public/labels.jsonl') as f:\r\n    labels = [json.loads(line) for line in f]\r\n\r\ndef search_drug(drug_name, keywords):\r\n    for label in labels:\r\n        if label['drug_name'].lower() == drug_name.lower():\r\n            print(f\"=== {label['drug_name']} ({label['set_id']}) ===\")\r\n            for idx, chunk in enumerate(label['chunks']):\r\n                if any(re.search(r'\\\\b' + re.escape(kw) + r'\\\\b', chunk, re.IGNORECASE) for kw in keywords):\r\n                    print(f\"PASSAGE_{idx:04d} (len={len(chunk)}):\")\r\n                    lines = chunk.strip().split('\\n')\r\n                    print(\"  Header:\", lines[0])\r\n                    print(\"  Snippet:\", ' | '.join(lines[1:4]))\r\n                    print(\"-\" * 40)\r\n\r\nprint(\"Search Paxlovid interactions:\")\r\nsearch_drug(\"Paxlovid\", [\"interaction\", \"co-administered\", \"cyp3a\"])\r\n"]
[66.975153, "o", "\u001b[?2004hroot@1ce871952c8c:/workspace# "]
[74.146939, "i", "cat << 'EOF' > search_labels.py\nimport json, re\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = [json.loads(line) for line in f]\n\ndef search_drug(drug_name, keywords):\n    for label in labels:\n        if label['drug_name'].lower() == drug_name.lower():\n            print(f\"=== {label['drug_name']} ({label['set_id']}) ===\")\n            for idx, chunk in enumerate(label['chunks']):\n                if any(kw.lower() in chunk.lower() for kw in keywords):\n                    print(f\"PASSAGE_{idx:04d} (len={len(chunk)}):\")\n                    lines = chunk.strip().split('\\n')\n                    print(\"  Header:\", lines[0])\n                    print(\"  Snippet:\", ' | '.join(lines[1:4]))\n                    print(\"-\" * 40)\n\nprint(\"Search Paxlovid interactions:\")\nsearch_drug(\"Paxlovid\", [\"interaction\", \"co-administered\", \"cyp3a\"])\nEOF\npython3 search_labels.py > /tmp/search_paxlovid_interactions.txt\nhead -n 40 /tmp/search_paxlovid_interactions.txt\n"]
