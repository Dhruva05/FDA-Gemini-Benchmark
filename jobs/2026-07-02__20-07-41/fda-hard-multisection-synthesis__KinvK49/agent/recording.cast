[30.653052, "i", "python3 -c \"import json, re; data=[json.loads(line) for line in open('/workspace/data/public/labels.jsonl')]\nfor d in data:\n    raw = d['label_raw']\n    parts = re.split(r'\\|\\|(PASSAGE_\\d+)\\|\\|', raw)\n    pairs = {}\n    for idx in range(1, len(parts), 2):\n        pid = parts[idx]\n        ptext = parts[idx+1].strip()\n        pairs[pid] = ptext\n    chunks = [c.strip() for c in d['chunks']]\n    print(d['drug_name'], len(chunks), len(pairs))\n    matched = 0\n    for c in chunks:\n        if c in pairs.values(): matched += 1\n    print('Matched chunks:', matched)\n\"\n"]
