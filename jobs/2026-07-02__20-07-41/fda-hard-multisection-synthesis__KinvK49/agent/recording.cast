[237.780334, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\rreac"]
[237.780377, "o", "\u001b[?2004h> "]
[237.78043, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\rdue to \u001b[?2004h> "]
[237.78051, "o", "        \"qid\": \"9be5515bc3064979\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.78056, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rfe-threatenin\u001b[?2004h> "]
[237.781953, "o", "        \"answer\": \"The safety risks listed for lopinavir and ritonavir include: 1) Risk of serious adverse reactions due to drug interactions, potentially leading to severe, life-threatening, or fatal events. 2) Toxicity in preterm neonates due to high ethanol and propylene glycol content in the oral solution, which can cause life-threatening cardiac toxicity (complete AV block, bradycardia, cardiomyopathy), lactic acidosis, acute renal failure, CNS depression, and respiratory complications. 3) Pancreatitis (including fatalities), particularly in patients with marked triglyceride elevations. 4) Hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation, and fatalities), especially in patients with underlying hepatitis B or C or cirrhosis. 5) QT interval prolongation and torsade de pointes. 6) PR interval prolongation, which can cause second or third-degree AV block. 7) Diabetes mellitus, hyperglycemia, or diabetic ketoacidosis. 8) Immune reconstitution syndrome and autoimmune disorders. 9) Large elevations in total cholesterol and triglycerides. 10) Fat redistribution and accumulation. 11) Increased bleeding in patients with hemophilia. 12) Potential development of HIV resistance or cross-resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.781994, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[237.782056, "o", "\u001b[?2004h> "]
[237.782118, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.782147, "o", "                \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.782231, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.782399, "o", "                \"supporting_quote\": \"These interactions may lead to: Clinically significant adverse reactions, potentially leading to severe, life-threatening, or fatal events from greater exposures of concomitant medications.\"\r\n\u001b[?2004l\r"]
[237.782427, "o", "\u001b[?2004h> "]
[237.782463, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.78253, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.782559, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.782632, "o", "                \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.782716, "o", "                \"section\": \"5.2 Toxicity in Preterm Neonates\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.782947, "o", "                \"supporting_quote\": \"Postmarketing life-threatening cases of cardiac toxicity (including complete AV block, bradycardia, and cardiomyopathy), lactic acidosis, acute renal failure, CNS depression and respiratory complications leading to death have been reported, predominantly in preterm neonates receiving lopinavir and ritonavir oral solution.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.782963, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.783025, "o", ">             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
