[81.638926, "o", "==================== \u001b[01;31m\u001b[KPaxlovid\u001b[m\u001b[K (8a99d6d6-fd9e-45bb-b1bf-48c7f761232a) ====================\r\nPASSAGE_0000: WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\r\nPASSAGE_0001: 1 INDICATIONS AND USAGE\r\nPASSAGE_0002: Limitations of Use\r\nPASSAGE_0003: 2.1\tImportant Dosage and Administration Information\r\nPASSAGE_0004: 2.2\tRecommended Dosage\r\nPASSAGE_0005: 2.3 Dosage in Patients with Renal Impairment\r\nPASSAGE_0006: Days of Treatment\r\nPASSAGE_0007: Days 1-5\r\nPASSAGE_0008: Day 1\r\nPASSAGE_0009: Days 2-5\r\nPASSAGE_0010: 2.4\tUse in Patients with Hepatic Impairment\r\nPASSAGE_0011: 3 DOSAGE FORMS AND STRENGTHS\r\nPASSAGE_0012: 4 CONTRAINDICATIONS\r\nPASSAGE_0013: 5.1\tRisk of Serious Adverse Reactions Due to Drug Interactions\r\nPASSAGE_0014: 5.2\tHypersensitivity Reactions\r\nPASSAGE_0015: 5.3\tHepatotoxicity\r\nPASSAGE_0016: 5.4\tRisk of HIV-1 Resistance Development\r\nPASSAGE_0017: 6 ADVERSE REACTIONS\r\nPASSAGE_0018: 6.1\tClinical Trials Experience\r\nPASSAGE_0019: 7.1\tPotential for PAXLOVID to Affect Other Drugs\r\n"]
