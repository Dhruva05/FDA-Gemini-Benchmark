[249.100629, "o", "    print(f\"\\nChecking answer {idx+1} for qid {ans['qid']}:\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"qid\" in ans, \"Missing qid\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
