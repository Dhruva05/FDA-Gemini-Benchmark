[249.101593, "o", "\u001b[?2004h>     \r\n"]
[249.101698, "o", "\u001b[?2004l\r\u001b[?2004h>     for cit in ans[\"citations\"]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.101781, "o", "        assert \"set_id\" in cit, \"Missing set_id in citation\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.101916, "o", "        assert cit[\"set_id\"] == q[\"set_id\"], f\"Mismatch set_id: expected {q['set_id']}, got {cit['set_id']}\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[249.102068, "o", "\u001b[?2004h>         assert \"passage_id\" in cit, \"Missing passage_id in citation\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.102187, "o", "        assert isinstance(cit[\"passage_id\"], str) and cit[\"passage_id\"].startswith(\"PASSAGE_\"), f\"Invalid passage_id {cit['passage_id']}\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[249.102263, "o", "\u001b[?2004h> "]
[249.102318, "o", "        assert \"section\" in cit, \"Missing section in citation\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.102434, "o", "        assert cit[\"section\"] is None or isinstance(cit[\"section\"], str), \"section must be string or null\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.102544, "o", "        assert \"supporting_quote\" in cit, \"Missing supporting_quote in citation\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.102636, "o", "        assert isinstance(cit[\"supporting_quote\"], str), \"supporting_quote must be string\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[249.102701, "o", "> "]
[249.102795, "o", "    assert \"structured_fields\" in ans, \"Missing structured_fields\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.102866, "o", "    assert isinstance(ans[\"structured_fields\"], dict), \"structured_fields must be a dict\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.102937, "o", "print(\"\\nAll validation checks passed successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
