[160.755398, "o", "\u001b[?2004hroot@1ce871952c8c:/workspace# "]
[237.76058, "i", "cat << 'EOF' > make_answers.py\nimport json\n\nanswers = [\n    {\n        \"qid\": \"b2531657ba5c7a78\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Paxlovid is associated with significant drug interactions because it includes ritonavir, a strong CYP3A inhibitor. Initiation of Paxlovid in patients receiving medications metabolized by CYP3A, or initiation of medications metabolized by CYP3A in patients already receiving Paxlovid, can increase the plasma concentrations of these concomitant medications, potentially resulting in severe, life-threatening, or fatal events. The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers. Conversely, co-administration of Paxlovid with strong CYP3A inducers is contraindicated, as it may decrease plasma concentrations of nirmatrelvir and ritonavir, leading to a loss of therapeutic effect and the potential development of viral resistance. Additionally, Paxlovid is an inhibitor of CYP2D6, P-gp, and OATP1B1, meaning that co-administration with substrates of these enzymes or transporters may result in increased plasma concentrations and adverse events.\",\n        \"citations\": [\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0000\",\n                \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\n                \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0013\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"supporting_quote\": \"Severe, life-threatening, and/or fatal adverse reactions due to drug interactions have been reported in patients treated with PAXLOVID. The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0019\",\n                \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\n                \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0020\",\n                \"section\": \"7.2 Potential for Other Drugs to Affect PAXLOVID\",\n                \"supporting_quote\": \"Nirmatrelvir and ritonavir are CYP3A substrates; therefore, drugs that induce CYP3A may decrease nirmatrelvir and ritonavir plasma concentrations and reduce PAXLOVID therapeutic effect .\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"6f12607a1ba14dd5\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Medications that should be avoided (contraindicated) with Paxlovid include: 1) Drugs primarily metabolized by CYP3A for which elevated concentrations are associated with serious and/or life-threatening reactions: alfuzosin (alpha 1-adrenoreceptor antagonist); ranolazine (antianginal); amiodarone, dronedarone, flecainide, propafenone, quinidine (antiarrhythmics); colchicine in patients with renal and/or hepatic impairment (anti-gout); lurasidone, pimozide (antipsychotics); silodosin (benign prostatic hyperplasia agent); eplerenone, ivabradine (cardiovascular agents); dihydroergotamine, ergotamine, methylergonovine (ergot derivatives); lovastatin, simvastatin (HMG-CoA reductase inhibitors); voclosporin (immunosuppressant); lomitapide (microsomal triglyceride transfer protein inhibitor); eletriptan, ubrogepant"]
[237.760804, "i", " (migraine medications); finerenone (mineralocorticoid receptor antagonist); naloxegol (opioid antagonist); sildenafil [Revatio] when used for pulmonary arterial hypertension (PDE5 inhibitor); triazolam, oral midazolam (sedative/hypnotics); flibanserin (serotonin receptor 1A agonist/2A antagonist); and tolvaptan (vasopressin receptor antagonist). 2) Strong CYP3A inducers where significantly reduced nirmatrelvir or ritonavir plasma concentrations may lead to loss of virologic response and resistance: apalutamide, enzalutamide (anticancer drugs); carbamazepine, phenobarbital, primidone, phenytoin (anticonvulsants); rifampin, rifapentine (antimycobacterials); lumacaftor/ivacaftor (cystic fibrosis transmembrane conductance regulator potentiator); and St. John's Wort (herbal product).\",\n        \"citations\": [\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0012\",\n                \"section\": \"4 CONTRAINDICATIONS\",\n                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers where significantly reduced nirmatrelvir or ritonavir plasma concentrations may be associated with the potential for loss of virologic response and possible resistance.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"daef650b92e56473\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. When administered via a feeding tube, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility with the excipients ethanol and propylene glycol. Feeding tubes made of materials compatible with these excipients, such as silicone and polyvinyl chloride (PVC), can be used for administration. In pediatric patients, the dose of the oral solution should be administered using the supplied calibrated cup or an oral dosing syringe.\",\n        \"citations\": [\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0001\",\n                \"section\": \"2.1 General Administration Recommendations\",\n                \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0002\",\n                \"section\": \"2.2 Administering Oral Solution by Feeding Tube\",\n                \"supporting_quote\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility. Feeding tubes that are compatible with ethanol and propylene glycol, such as silicone and polyvinyl chloride (PVC) feeding tubes, can be used for administration of lopinavir and ritonavir oral solution.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0007\",\n                \"section\": \"2.4 Dosage Recommendations in Pediatric Patients\",\n                \"supporting_quote\": \"The dose of the oral solution should be administered using the calibrated cup (supplied) or oral dosing syringe.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"a0576a26f2a2eeac\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Lopinavir and ritonavir can be administered as a once-daily or twice-daily dosing regimen in adults. 1) Once-daily dosing: The recommended dosage is 800 mg/200 mg (10 mL) once daily. Once-daily dosing is NOT recommended in pediatric patients younger than 18 years, pregnant women, in combination with carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir, or in adult patients with three or more lopinavir resistance-associated substitutions. 2) Twice-daily dosing: The recommend"]
[237.761286, "i", "ed dosage is 400 mg/100 mg (5 mL) twice daily. The dose must be increased to 520 mg/130 mg (6.5 mL) twice daily when administered in combination with efavirenz, nevirapine, or nelfinavir. 3) Pregnancy: Administer 400 mg/100 mg twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions. Once-daily dosing is not recommended in pregnancy, and use of the oral solution should be avoided. 4) Pediatric patients: Once-daily dosing is not recommended. The oral solution is not recommended in neonates before a postmenstrual age of 42 weeks and a postnatal age of at least 14 days has been attained.\",\n        \"citations\": [\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0003\",\n                \"section\": \"2.3 Dosage Recommendations in Adults\",\n                \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0004\",\n                \"section\": \"Recommended Dosage\",\n                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 800 mg/200 mg (10 mL) once daily\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0005\",\n                \"section\": \"Recommended Dosage\",\n                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 400 mg/100 mg (5 mL) twice daily\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0006\",\n                \"section\": \"Recommended Dosage\",\n                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 520 mg/130 mg (6.5 mL) twice daily\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0007\",\n                \"section\": \"2.4 Dosage Recommendations in Pediatric Patients\",\n                \"supporting_quote\": \"Lopinavir and ritonavir oral solution is not recommended for once daily dosing in pediatric patients younger than 18 years of age.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0012\",\n                \"section\": \"2.5 Dosage Recommendations in Pregnancy\",\n                \"supporting_quote\": \"Administer 400/100 mg of lopinavir and ritonavir twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"9be5515bc3064979\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"The safety risks listed for lopinavir and ritonavir include: 1) Risk of serious adverse reactions due to drug interactions, potentially leading to severe, life-threatening, or fatal events. 2) Toxicity in preterm neonates due to high ethanol and propylene glycol content in the oral solution, which can cause life-threatening cardiac toxicity (complete AV block, bradycardia, cardiomyopathy), lactic acidosis, acute renal failure, CNS depression, and respiratory complications. 3) Pancreatitis (including fatalities), particularly in patients with marked triglyceride elevations. 4) Hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation, and fatalities), especially in patients with underlying hepatitis B or C or cirrhosis. 5) QT interval prolongation and torsade de pointes. 6) PR interval prolongation, which can cause second or third-degree AV block. 7) Diabetes mellitus, hyperglycemia, or diabetic ketoacidosis. 8) Immune reconstitution syndrome and autoimmune disorders. 9) Large elevations in total cholesterol and triglycerides. 10) Fat redistribution and accumulation. 11) Increased bleeding in patients with hemophilia. 12) Potential development of HIV resistance or cross-resistance.\",\n        \"citations\": [\n            {\n"]
[237.761378, "o", "cat << 'EOF' > make_answers.py\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> answers = [\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.761432, "i", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0014\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"supporting_quote\": \"These interactions may lead to: Clinically significant adverse reactions, potentially leading to severe, life-threatening, or fatal events from greater exposures of concomitant medications.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0015\",\n                \"section\": \"5.2 Toxicity in Preterm Neonates\",\n                \"supporting_quote\": \"Postmarketing life-threatening cases of cardiac toxicity (including complete AV block, bradycardia, and cardiomyopathy), lactic acidosis, acute renal failure, CNS depression and respiratory complications leading to death have been reported, predominantly in preterm neonates receiving lopinavir and ritonavir oral solution.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0016\",\n                \"section\": \"5.3 Pancreatitis\",\n                \"supporting_quote\": \"Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0017\",\n                \"section\": \"5.4 Hepatotoxicity\",\n                \"supporting_quote\": \"There have been postmarketing reports of hepatic dysfunction, including some fatalities.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0018\",\n                \"section\": \"5.5 QT Interval Prolongation\",\n                \"supporting_quote\": \"Postmarketing cases of QT interval prolongation and torsade de pointes have been reported although causality of lopinavir and ritonavir could not be established.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0019\",\n                \"section\": \"5.6 PR Interval Prolongation\",\n                \"supporting_quote\": \"Lopinavir and ritonavir prolongs the PR interval in some patients. Cases of second or third degree atrioventricular block have been reported.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"18078efe9380c8dc\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"The warnings and precautions associated with lopinavir and ritonavir include: 1) Risk of serious adverse reactions due to drug interactions (potentially leading to severe, life-threatening, or fatal events). 2) Toxicity in preterm neonates due to high ethanol and propylene glycol content in the oral solution, which can cause life-threatening cardiac toxicity (complete AV block, bradycardia, cardiomyopathy), lactic acidosis, acute renal failure, CNS depression, and respiratory complications. 3) Pancreatitis (including fatalities), particularly in patients with marked triglyceride elevations. 4) Hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation, and fatalities), especially in patients with underlying hepatitis B or C or cirrhosis. 5) QT interval prolongation and torsade de pointes. 6) PR interval prolongation, which can cause second or third-degree AV block. 7) Diabetes mellitus, hyperglycemia, or diabetic ketoacidosis. 8) Immune reconstitution syndrome and autoimmune disorders. 9) Large elevations in"]
[237.761589, "o", "        \"qid\": \"b2531657ba5c7a78\",\r\n\u001b[?2004l\r"]
[237.761658, "o", "\u001b[?2004h> "]
[237.761753, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[237.763658, "o", "        \"answer\": \"Paxlovid is associated with significant drug interactions because it includes ritonavir, a strong CYP3A inhibitor. Initiation of Paxlovid in patients receiving medications metabolized by CYP3A, or initiation of medications metabolized by CYP3A in patients already receiving Paxlovid, can increase the plasma concentrations of these concomitant medications, potentially resulting in severe, life-threatening, or fatal events. The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers. Conversely, co-administration of Paxlovid with strong CYP3A inducers is contraindicated, as it may decrease plasma concentrations of nirmatrelvir and ritonavir, leading to a loss of therapeutic effect and the potential development of viral resistance. Additionally, Paxlovid is an inhibitor of CYP2D6, P-gp, and OATP1B1, meaning that co-administration with substrates of these enzymes or transporters may result in increased plasma concentrations and adverse events.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.763681, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.763779, "o", "            {\r\n\u001b[?2004l\rificantl\u001b[?2004h> "]
[237.763861, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.76388, "o", "> "]
[237.763967, "o", "                \"passage_id\": \"PASSAGE_0000\",\r\n\u001b[?2004l\rrol\u001b[?2004h> "]
[237.764152, "o", "                \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.764464, "o", "                \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\r"]
[237.764488, "o", "\u001b[?2004h> "]
[237.764546, "o", "            },\r\n\u001b[?2004l\rith\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.764572, "o", "> "]
[237.764726, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\rts\u001b[?2004h> "]
[237.764797, "o", "                \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.765042, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.765121, "o", "> "]
[237.765594, "o", "                \"supporting_quote\": \"Severe, life-threatening, and/or fatal adverse reactions due to drug interactions have been reported in patients treated with PAXLOVID. The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.765614, "o", "            },\r\n\u001b[?2004l\rn"]
[237.765702, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.7658, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\rvir \u001b[?2004h> "]
[237.765874, "o", "                \"passage_id\": \"PASSAGE_0019\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.766031, "o", "                \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.766233, "o", "                \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1.\"\r\n\u001b[?2004l\rote\u001b[?2004h> "]
[237.766303, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.766321, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.7665, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.76664, "o", "> "]
[237.766793, "o", "                \"passage_id\": \"PASSAGE_0020\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.766913, "o", "                \"section\": \"7.2 Potential for Other Drugs to Affect PAXLOVID\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.767256, "o", "                \"supporting_quote\": \"Nirmatrelvir and ritonavir are CYP3A substrates; therefore, drugs that induce CYP3A may decrease nirmatrelvir and ritonavir plasma concentrations and reduce PAXLOVID therapeutic effect .\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.767275, "o", ">             }\r\n\u001b[?2004l\r"]
[237.767347, "o", "\u001b[?2004h>         ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.767439, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.76749, "o", ">     {\r\n\u001b[?2004l\r\u001b[?2004h>         \"qid\": \"6f12607a1ba14dd5\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": \"ANSWERED\",\r\n"]
[237.767516, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[237.770253, "o", "        \"answer\": \"Medications that should be avoided (contraindicated) with Paxlovid include: 1) Drugs primarily metabolized by CYP3A for which elevated concentrations are associated with serious and/or life-threatening reactions: alfuzosin (alpha 1-adrenoreceptor antagonist); ranolazine (antianginal); amiodarone, dronedarone, flecainide, propafenone, quinidine (antiarrhythmics); colchicine in patients with renal and/or hepatic impairment (anti-gout); lurasidone, pimozide (antipsychotics); silodosin (benign prostatic hyperplasia agent); eplerenone, ivabradine (cardiovascular agents); dihydroergotamine, ergotamine, methylergonovine (ergot derivatives); lovastatin, simvastatin (HMG-CoA reductase inhibitors); voclosporin (immunosuppressant); lomitapide (microsomal triglyceride transfer protein inhibitor); eletriptan, ubrogepant (migraine medications); finerenone (mineralocorticoid receptor antagonist); naloxegol (opioid antagonist); sildenafil [Revatio] when used for pulmonary arterial hypertension (PDE5 inhibitor); triazolam, oral midazolam (sedative/hypnotics); flibanserin (serotonin receptor 1A agonist/2A antagonist); and tolvaptan (vasopressin receptor antagonist). 2) Strong CYP3A inducers where significantly reduced nirmatrelvir or ritonavir plasma concentrations may lead to loss of virologic response and resistance: apalutamide, enzalutamide (anticancer drugs); carbamazepine, phenobarbital, primidone, phenytoin (anticonvulsants); rifampin, rifapentine (antimycobacterials); lumacaftor/ivacaftor (cystic fibrosis transmembrane conductance regulator potentiator); and St. John's Wort (herbal product).\",\r\n\u001b[?2004l\r"]
[237.770273, "o", "\u001b[?2004h> "]
[237.770355, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.770501, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r"]
[237.770516, "o", "\u001b[?2004h> "]
[237.770613, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.770663, "o", "                \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r"]
[237.770716, "o", "\u001b[?2004h> "]
[237.771207, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers where significantly reduced nirmatrelvir or ritonavir plasma concentrations may be associated with the potential for loss of virologic response and possible resistance.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.7713, "o", "            }\r\n\u001b[?2004l\rGE\u001b[?2004h> "]
[237.771354, "o", "        ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.771412, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r Do\u001b[?2004h>     {\r\n"]
[237.771429, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[237.771517, "o", "        \"qid\": \"daef650b92e56473\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rer mL Oral Sol"]
[237.771587, "o", "\u001b[?2004h> "]
[237.772262, "o", "        \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. When administered via a feeding tube, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility with the excipients ethanol and propylene glycol. Feeding tubes made of materials compatible with these excipients, such as silicone and polyvinyl chloride (PVC), can be used for administration. In pediatric patients, the dose of the oral solution should be administered using the supplied calibrated cup or an oral dosing syringe.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.772324, "o", "        \"citations\": [\r\n\u001b[?2004l\r"]
[237.772354, "o", "\u001b[?2004h> "]
[237.772418, "o", "            {\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[237.772551, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.772606, "o", "                \"passage_id\": \"PASSAGE_0001\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.772641, "o", "> "]
[237.772721, "o", "                \"section\": \"2.1 General Administration Recommendations\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.772741, "o", "> "]
[237.772859, "o", "                \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\r\n\u001b[?2004l\r    \u001b[?2004h> "]
[237.77295, "o", "            },\r\n\u001b[?2004l\rct"]
[237.772966, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\rion\": \"2.5 Dos\u001b[?2004h"]
[237.773009, "o", "> "]
[237.773117, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\rpporting_quo\u001b[?2004h> "]
[237.773205, "o", "                \"passage_id\": \"PASSAGE_0002\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.773362, "o", "                \"section\": \"2.2 Administering Oral Solution by Feeding Tube\",\r\n\u001b[?2004l\rassocia\u001b[?2004h> "]
[237.773941, "o", "                \"supporting_quote\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility. Feeding tubes that are compatible with ethanol and propylene glycol, such as silicone and polyvinyl chloride (PVC) feeding tubes, can be used for administration of lopinavir and ritonavir oral solution.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.773986, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.774001, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h"]
[237.774101, "o", "> "]
[237.774158, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.774289, "o", "                \"passage_id\": \"PASSAGE_0007\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.774396, "o", "                \"section\": \"2.4 Dosage Recommendations in Pediatric Patients\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.774572, "o", "                \"supporting_quote\": \"The dose of the oral solution should be administered using the calibrated cup (supplied) or oral dosing syringe.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.774639, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         ],\r\n\u001b[?2004l\red tran\u001b[?2004h> "]
[237.774691, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\rsaminases, hepatic decompensatio\u001b[?2004h> "]
[237.77474, "o", "    },\r\n\u001b[?2004l\r and "]
[237.774796, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[237.774864, "o", "\u001b[?2004h>         \"qid\": \"a0576a26f2a2eeac\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.774887, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.776596, "o", "        \"answer\": \"Lopinavir and ritonavir can be administered as a once-daily or twice-daily dosing regimen in adults. 1) Once-daily dosing: The recommended dosage is 800 mg/200 mg (10 mL) once daily. Once-daily dosing is NOT recommended in pediatric patients younger than 18 years, pregnant women, in combination with carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir, or in adult patients with three or more lopinavir resistance-associated substitutions. 2) Twice-daily dosing: The recommended dosage is 400 mg/100 mg (5 mL) twice daily. The dose must be increased to 520 mg/130 mg (6.5 mL) twice daily when administered in combination with efavirenz, nevirapine, or nelfinavir. 3) Pregnancy: Administer 400 mg/100 mg twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions. Once-daily dosing is not recommended in pregnancy, and use of the oral solution should be avoided. 4) Pediatric patients: Once-daily dosing is not recommended. The oral solution is not recommended in neonates before a postmenstrual age of 42 weeks and a postnatal age of at least 14 days has been attained.\",\r\n\u001b[?2004l\r"]
[237.776662, "o", "\u001b[?2004h> "]
[237.776723, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\re\":\u001b[?2004h> "]
