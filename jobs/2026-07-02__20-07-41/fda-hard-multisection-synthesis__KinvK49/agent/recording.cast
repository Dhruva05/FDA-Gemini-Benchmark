[249.101098, "o", "    assert ans[\"status\"] in [\"ANSWERED\", \"NOT_FOUND\"], f\"Invalid status {ans['status']}\"\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
