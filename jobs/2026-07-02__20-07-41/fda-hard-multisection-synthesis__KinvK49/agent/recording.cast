[237.898409, "o", "\u001b[?2004hroot@1ce871952c8c:/workspace# "]
[249.09882, "i", "cat << 'EOF' > validate_answers.py\nimport json\n\n# Load questions\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = [json.loads(line) for line in f]\nqids = {q['qid']: q for q in questions}\n\n# Load answers\nwith open('/workspace/answers.json') as f:\n    data = json.load(f)\n\nassert \"answers\" in data, \"Missing 'answers' key\"\nanswers = data[\"answers\"]\n\nprint(f\"Number of questions: {len(questions)}\")\nprint(f\"Number of answers: {len(answers)}\")\n\nassert len(answers) == len(questions), \"Mismatch in number of answers\"\n\nfor idx, ans in enumerate(answers):\n    print(f\"\\nChecking answer {idx+1} for qid {ans['qid']}:\")\n    assert \"qid\" in ans, \"Missing qid\"\n    assert ans[\"qid\"] in qids, f\"Unknown qid {ans['qid']}\"\n    q = qids[ans[\"qid\"]]\n    \n    assert \"status\" in ans, \"Missing status\"\n    assert ans[\"status\"] in [\"ANSWERED\", \"NOT_FOUND\"], f\"Invalid status {ans['status']}\"\n    \n    assert \"answer\" in ans, \"Missing answer\"\n    assert isinstance(ans[\"answer\"], str), \"answer must be a string\"\n    \n    assert \"citations\" in ans, \"Missing citations\"\n    assert isinstance(ans[\"citations\"], list), \"citations must be a list\"\n    \n    for cit in ans[\"citations\"]:\n        assert \"set_id\" in cit, \"Missing set_id in citation\"\n        assert cit[\"set_id\"] == q[\"set_id\"], f\"Mismatch set_id: expected {q['set_id']}, got {cit['set_id']}\"\n        \n        assert \"passage_id\" in cit, \"Missing passage_id in citation\"\n        assert isinstance(cit[\"passage_id\"], str) and cit[\"passage_id\"].startswith(\"PASSAGE_\"), f\"Invalid passage_id {cit['passage_id']}\"\n        \n        assert \"section\" in cit, \"Missing section in citation\"\n        assert cit[\"section\"] is None or isinstance(cit[\"section\"], str), \"section must be string or null\"\n        \n        assert \"supporting_quote\" in cit, \"Missing supporting_quote in citation\"\n        assert isinstance(cit[\"supporting_quote\"], str), \"supporting_quote must be string\"\n        \n    assert \"structured_fields\" in ans, \"Missing structured_fields\"\n    assert isinstance(ans[\"structured_fields\"], dict), \"structured_fields must be a dict\"\n\nprint(\"\\nAll validation checks passed successfully!\")\nEOF\npython3 validate_answers.py\n"]
[249.099107, "o", "cat << 'EOF' > validate_answers.py\r\n\u001b[?2004l\r"]
[249.099235, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load questions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[249.099346, "o", "with open('/workspace/data/public/questions.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
