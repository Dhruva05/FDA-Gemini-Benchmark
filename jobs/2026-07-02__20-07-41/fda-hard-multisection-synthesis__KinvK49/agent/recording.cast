[237.779581, "o", "            },\r\n\u001b[?2004l\r"]
[237.779635, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r \"s\u001b[?2004h"]
[237.779693, "o", "> "]
[237.779768, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.779828, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\rthird d\u001b[?2004h> "]
[237.779956, "o", "                \"section\": \"2.5 Dosage Recommendations in Pregnancy\",\r\n\u001b[?2004l\r  \u001b[?2004h> "]
[237.780186, "o", "                \"supporting_quote\": \"Administer 400/100 mg of lopinavir and ritonavir twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.780258, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
