[237.883662, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.883716, "o", "                \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.883812, "o", "                \"section\": \"5.3 Hepatotoxicity\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.883927, "o", "                \"supporting_quote\": \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.883989, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
