_dose": "800/200 mg",\n            "citation_passages": ["PASSAGE_0001", "PASSAGE_0002", "PASSAGE_0007"]\n        }\n    },\n    {\n        "qid": "a0576a26f2a2eeac",\n        "status": "ANSWERED",\n        "answer": "In adults, lopinavir and ritonavir can be given in once daily or twice daily dosing regimens. The recommended once daily dosage is 800 mg/200 mg (10 mL) once daily. The recommended twice daily dosage is 400 mg/100 mg (5 mL) twice daily. In pregnant women with no documented lopinavir-associated resistance substitutions, the recommended dosage is 400/100 mg twice daily. Pediatric dosage is calculated based on body weight or body surface area (BSA) and should not exceed the recommended adult daily dose of 400/100 mg (5 mL) twice daily.",\n        "citations": [\n            {\n                "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",\n                "passage_id": "PASSAGE_0003",\n                "section": "2.3 Dosage Recommendations in Adults",\n                "supporting_quote": "Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2."\n            },\n            {\n                "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",\n                "passage_id": "PASSAGE_0004",\n                "section": "2.3 Dosage Recommendations in Adults",\n                "supporting_quote": "800 mg/200 mg (10 mL) once daily"\n            },\n            {\n                "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",\n                "passage_id": "PASSAGE_0005",\n                "section": "2.3 Dosage Recommendations in Adults",\n                "supporting_quote": "400 mg/100 mg (5 mL) twice daily"\n            },\n            {\n                "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",\n                "passage_id": "PASSAGE_0008",\n                "section": "2.4 Dosage Recommendations in Pediatric Patients",\n                "supporting_quote": "Total dose of lopinavir and ritonavir oral solution in pediatric patients should not exceed the recommended adult daily dose of 400/100 mg (5mL) twice daily."\n            },\n            {\n                "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",\n                "passage_id": "PASSAGE_0012",\n                "section": "2.5 Dosage Recommendations in Pregnancy",\n                "supporting_quote": "Administer 400/100 mg of lopinavir and ritonavir twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions."\n            }\n        ],\n        "structured_fields": {\n            "dose": "400/100 or 800/200",\n            "unit": "mg",\n            "route": "oral",\n            "frequency": "once daily or twice daily",\n            "population": "adults, pregnant women, and pediatric patients 14 days and older",\n            "max_daily_dose": "800/200 mg",\n            "citation_passages": ["PASSAGE_0003", "PASSAGE_0004", "PASSAGE_0005", "PASSAGE_0008", "PASSAGE_0012"]\n        }\n    },\n    {\n        "qid": "55d09c5df742eaec",\n        "status": "ANSWERED",\n        "answer": "The recommended dosage of emtricitabine, rilpivirine and tenofovir disoproxil fumarate tablets in adult and pediatric patients weighing at least 35 kg is one tablet taken orally once daily with food. One tablet contains 200 mg of emtricitabine, 25 mg of rilpivirine, and 300 mg of tenofovir disoproxil fumarate.",\n        "citations": [\n            {\n                "set_id": "d9a4185e-43fa-4aeb-9b0f-8db01b166038",\n                "passage_id": "PASSAGE_0003",\n                "section": "2.2 Recommended Dosage",\n                "supporting_quote": "The recommended dosage of emtricitabine, rilpivirine and tenofovir disoproxil fumarate tablets in adult and pediatric patients weighing at least 35 kg is one tablet taken orally once daily with food."\n            }\n        ],\n        "structured_fields": {\n            "dose": "1",\n            "unit": "tablet",\n          