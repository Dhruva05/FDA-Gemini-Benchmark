3b6611104089",\n                "passage_id": "PASSAGE_0010",\n                "section": "2.3 Rheumatoid Arthritis",\n                "supporting_quote": "For RA, the dosage is 100 mg to 200 mg twice daily."\n            },\n            {\n                "set_id": "27f17ae7-939b-402e-9498-3b6611104089",\n                "passage_id": "PASSAGE_0011",\n                "section": "2.4 Juvenile Rheumatoid Arthritis",\n                "supporting_quote": "For JRA, the dosage for pediatric patients (age 2 years and older) is based on weight. For patients ≥10 kg to \uf0a325 kg the recommended dose is 50 mg twice daily. For patients >25 kg the recommended dose is 100 mg twice daily."\n            },\n            {\n                "set_id": "27f17ae7-939b-402e-9498-3b6611104089",\n                "passage_id": "PASSAGE_0012",\n                "section": "2.5 Ankylosing Spondylitis",\n                "supporting_quote": "For AS, the dosage of celecoxib capsules is 200 mg daily in single (once per day) or divided (twice per day) doses. If no effect is observed after 6 weeks, a trial of 400 mg daily may be worthwhile."\n            },\n            {\n                "set_id": "27f17ae7-939b-402e-9498-3b6611104089",\n                "passage_id": "PASSAGE_0013",\n                "section": "2.6 Management of Acute Pain and Treatment of Primary Dysmenorrhea",\n                "supporting_quote": "For management of Acute Pain and Treatment of Primary Dysmenorrhea, the dosage is 400 mg initially, followed by an additional 200 mg dose if needed on the first day. On subsequent days, the recommended dose is 200 mg twice daily as needed."\n            }\n        ],\n        "structured_fields": {\n            "dose": "200 to 400",\n            "unit": "mg",\n            "route": "oral",\n            "frequency": "once daily or twice daily",\n            "population": "adults and pediatric patients age 2 years and older",\n            "max_daily_dose": "400 mg (or 600 mg on the first day of acute pain/primary dysmenorrhea)",\n            "citation_passages": ["PASSAGE_0009", "PASSAGE_0010", "PASSAGE_0011", "PASSAGE_0012", "PASSAGE_0013"]\n        }\n    },\n    {\n        "qid": "85c49de5de841cb9",\n        "status": "ANSWERED",\n        "answer": "The recommended starting dose of lenalidomide depends on the indication: (1) Multiple Myeloma: 25 mg orally once daily on Days 1 to 21 of repeated 28-day cycles in combination with dexamethasone; (2) Myelodysplastic Syndromes: 10 mg daily; (3) Mantle Cell Lymphoma: 25 mg/day orally on Days 1 to 21 of repeated 28-day cycles; (4) Follicular Lymphoma or Marginal Zone Lymphoma: 20 mg orally once daily on Days 1 to 21 of repeated 28-day cycles in combination with a rituximab-product. Dosage adjustments are required for patients with renal impairment based on creatinine clearance.",\n        "citations": [\n            {\n                "set_id": "ed7a3099-ce31-4865-b212-358d9ff6261b",\n                "passage_id": "PASSAGE_0009",\n                "section": "2.1 Recommended Dosage for Multiple Myeloma",\n                "supporting_quote": "The recommended starting dose of lenalidomide is 25 mg orally once daily on Days 1 to 21 of repeated 28-day cycles in combination with dexamethasone."\n            },\n            {\n                "set_id": "ed7a3099-ce31-4865-b212-358d9ff6261b",\n                "passage_id": "PASSAGE_0015",\n                "section": "2.2 Recommended Dosage for Myelodysplastic Syndromes",\n                "supporting_quote": "The recommended starting dose of lenalidomide is 10 mg daily."\n            },\n            {\n                "set_id": "ed7a3099-ce31-4865-b212-358d9ff6261b",\n                "passage_id": "PASSAGE_0019",\n                "section": "2.3 Recommended Dosage for Mantle Cell Lymphoma",\n                "supporting_quote": "The recommended starting dose of lenalidomide is 25 mg/day orally on Days 1 to 21 of repeated 28-day cycles for relapsed or refractory mantle cell lymphoma."\n            },\n            {\n                "set_id": "ed7a3099-ce31-4865-b212-358d9ff6261b",\n                "passage_id": "PASSAGE_0022",\n                "section": "2.4 Recommended Dosage for Follicular Lymphoma or Marginal Zone Lymphoma",\n                "supporting_quote": "The recommended starting dose of lenalidomide is 20 mg orally once daily on Days 1 to 21 of repeated 28-day cycles for up to 12 cycles of treatment in combination with a rituximab-product."\n            },\n            {\n                "set_id": "ed7a3099-ce31-4865-b212-358d9ff6261b",\n                "passage_id": "PASSAGE_0028",\n                "section": "2.6 Recommended Dosage for Patients with Renal Impairment",\n                "supporting_quote": "The recommendations for dosing patients with renal impairment are shown in the following table ."\n            }\n        ],\n        "structured_fields": {\n            "dose": "10 to 25",\n            "unit": "mg",\n            "route": "oral",\n            "frequency": "once daily",\n            "population": "adults",\n            "max_daily_dose": "25 mg",\n            "citation_passages": ["PASSAGE_0009", "PASSAGE_0015", "PASSAGE_0019", "PASSAGE_0022", "PASSAGE_0028"]\n        }\n    },\n    {\n        "qid": "0d262ce5d03f7c38",\n        "status": "ANSWERED",\n        "answer": "Lenalidomide should be taken orally at about the same time each day, either with or without food. The capsules must be swallowed whole with water and should not be opened, broken, or chewed.",\n        "citations": [\n            {\n                "set_id": "ed7a3099-ce31-4865-b212-358d9ff6261b",\n                "passage_id": "PASSAGE_0032",\n                "section": "2.7 Administration",\n                "supporting_quote": "Advise patients to take lenalidomide orally at about the same time each day, either with or without food. Advise patients to swallow lenalidomide capsules whole with water and not to open, break, or chew