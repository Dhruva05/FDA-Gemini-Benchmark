[274.06027, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[274.060358, "o", "se of l\u001b[?2004h> "]
[274.060415, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.060455, "o", "        \"qid\": \"0de6259e34606d2d\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.060468, "o", "> "]
[274.060521, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r \u001b[?2004h> "]
[274.061609, "o", "        \"answer\": \"The recommended dosage regimen of CELECOXIB varies by indication: For Osteoarthritis (OA), the dosage is 200 mg per day administered as a single dose or as 100 mg twice daily. For Rheumatoid Arthritis (RA), the dosage is 100 mg to 200 mg twice daily. For Ankylosing Spondylitis (AS), the dosage is 200 mg daily in single or divided doses, which can be increased to 400 mg daily if needed. For JRA (age 2 and older), the dosage is weight-based: 50 mg twice daily for patients 10 kg to 25 kg, and 100 mg twice daily for patients over 25 kg. For Acute Pain and Primary Dysmenorrhea, the dosage is 400 mg initially, followed by an additional 200 mg dose if needed on the first day, and 200 mg twice daily as needed on subsequent days.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.061781, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.06186, "o", "                \"passage_id\": \"PASSAGE_0009\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.061875, "o", "                \"section\": \"2.2\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.062145, "o", "                \"supporting_quote\": \"For OA, the dosage is 200 mg per day administered as a single dose or as 100 mg twice daily.\"\r\n\u001b[?2004l\r"]
[274.062159, "o", "\u001b[?2004h> "]
[274.0622, "o", "            },\r\n\u001b[?2004l\r"]
[274.062244, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.062258, "o", "> "]
[274.062375, "o", "                \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\r\n\u001b[?2004l\red_f\u001b[?2004h> "]
[274.062462, "o", "                \"passage_id\": \"PASSAGE_0010\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
