[23.655557, "i", "cat << 'EOF' > search.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        print(\"=\"*80)\n        print(f\"DRUG: {data['drug_name']} ({data['set_id']})\")\n        print(\"=\"*80)\n        for idx, chunk in enumerate(data['chunks']):\n            if any(kw in chunk.lower() for kw in ['dosage', 'dose', 'administration', 'recommended', 'schedule', 'frequency']):\n                print(f\"PASSAGE_{idx:04d}: {chunk[:200]}...\")\nEOF\npython3 search.py | head -n 40\n"]
