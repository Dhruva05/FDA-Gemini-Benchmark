[35.637775, "i", "cat << 'EOF' > dump_dosage.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        print(\"=\"*80)\n        print(f\"{data['drug_name']} ({data['set_id']})\")\n        print(\"=\"*80)\n        for idx, chunk in enumerate(data['chunks']):\n            # Check if chunk starts with \"2 \" or \"2.\" or is related to section 2\n            first_line = chunk.split('\\n')[0]\n            if first_line.startswith('2') or 'dosage' in chunk.lower() or 'administration' in chunk.lower():\n                print(f\"PASSAGE_{idx:04d} (len={len(chunk)}):\\n{chunk}\\n{'-'*40}\")\nEOF\npython3 dump_dosage.py > /workspace/dosage_sections.txt\nhead -n 100 /workspace/dosage_sections.txt\n"]
