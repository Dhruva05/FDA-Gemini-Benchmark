[274.038209, "i", "cat << 'EOF' > generate_answers.py\nimport json\n\nlabels = {}\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        labels[data['set_id']] = data\n\ndef verify_and_clean_quote(set_id, passage_id, quote):\n    if set_id not in labels:\n        raise ValueError(f\"Label {set_id} not found!\")\n    label_data = labels[set_id]\n    try:\n        idx = int(passage_id.split('_')[1])\n    except Exception:\n        raise ValueError(f\"Invalid passage_id format {passage_id}\")\n    if idx >= len(label_data['chunks']):\n        raise ValueError(f\"passage_id {passage_id} out of bounds for {set_id}\")\n    passage_text = label_data['chunks'][idx]\n    if quote in passage_text:\n        return quote\n    normalized_passage = \" \".join(passage_text.split())\n    normalized_quote = \" \".join(quote.split())\n    if normalized_quote in normalized_passage:\n        print(f\"WARNING: Space mismatch in quote: {repr(quote)}\")\n        return quote\n    raise ValueError(f\"Quote {repr(quote)} not found in {passage_id} of {set_id}!\\nPassage content: {repr(passage_text[:200])}...\")\n\nraw_answers = [\n    {\n        \"qid\": \"daef650b92e56473\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. It can be administered by feeding tube; however, polyurethane feeding tubes are not recommended due to potential incompatibility. Compatible feeding tubes include silicone and polyvinyl chloride (PVC) feeding tubes. For pediatric patients, the dose should be administered using the calibrated cup (supplied) or oral dosing syringe.\",\n        \"citations\": [\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0001\",\n                \"section\": \"2.1\",\n                \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0002\",\n                \"section\": \"2.2\",\n                \"supporting_quote\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0007\",\n                \"section\": \"2.4\",\n                \"supporting_quote\": \"The dose of the oral solution should be administered using the calibrated cup (supplied) or oral dosing syringe.\"\n            }\n        ],\n        \"structured_fields\": {\n            \"dose\": \"800/200\",\n            \"unit\": \"mg/mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"once daily or twice daily\",\n            \"population\": \"adults\",\n            \"max_daily_dose\": \"800/200 mg\",\n            \"citation_passages\": [\"PASSAGE_0001\", \"PASSAGE_0002\", \"PASSAGE_0007\"]\n        }\n    },\n    {\n        \"qid\": \"a0576a26f2a2eeac\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"In adults, lopinavir and ritonavir can be given in a once daily dosing regimen of 800 mg/200 mg (10 mL), or a twice daily dosing regimen of 400 mg/100 mg (5 mL). The once daily regimen is not recommended in pediatric patients, pregnant women, or in combination with certain drugs/mutations. In pregnant patients with no documented resistance substitutions, the recommended dose is 400 mg/100 mg twice daily. In pediatric patients (14 days and older), the dose is calculated based on weight or body surface area (BSA) and should not exceed the adult daily dose of 400 mg/100 mg twice daily.\",\n        \"citations\": [\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0003\",\n                \"section\": \"2.3\",\n                \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1"]
[274.038353, "i", "dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0004\",\n                \"section\": \"2.3\",\n                \"supporting_quote\": \"800 mg/200 mg (10 mL) once daily\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0005\",\n                \"section\": \"2.3\",\n                \"supporting_quote\": \"400 mg/100 mg (5 mL) twice daily\"\n            }\n        ],\n        \"structured_fields\": {\n            \"dose\": \"400/100 or 800/200\",\n            \"unit\": \"mg/mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"once daily or twice daily\",\n            \"population\": \"adults\",\n            \"max_daily_dose\": \"800/200 mg\",\n            \"citation_passages\": [\"PASSAGE_0003\", \"PASSAGE_0004\", \"PASSAGE_0005\"]\n        }\n    },\n    {\n        \"qid\": \"55d09c5df742eaec\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"The recommended dosage of emtricitabine, rilpivirine, and tenofovir disoproxil fumarate tablets in adult and pediatric patients weighing at least 35 kg is one tablet taken orally once daily with food. It is not recommended in patients with moderate or severe renal impairment (estimated creatinine clearance below 50 mL per minute).\",\n        \"citations\": [\n            {\n                \"set_id\": \"d9a4185e-43fa-4aeb-9b0f-8db01b166038\",\n                \"passage_id\": \"PASSAGE_0003\",\n                \"section\": \"2.2\",\n                \"supporting_quote\": \"The recommended dosage of emtricitabine, rilpivirine and tenofovir disoproxil fumarate tablets in adult and pediatric patients weighing at least 35 kg is one tablet taken orally once daily with food .\"\n            }\n        ],\n        \"structured_fields\": {\n            \"dose\": \"200/25/300\",\n            \"unit\": \"mg/mg/mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"once daily\",\n            \"population\": \"adult and pediatric patients weighing at least 35 kg\",\n            \"max_daily_dose\": \"200/25/300 mg\",\n            \"citation_passages\": [\"PASSAGE_0003\"]\n        }\n    },\n    {\n        \"qid\": \"005acaea4542b5ca\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Emtricitabine, rilpivirine, and tenofovir disoproxil fumarate tablets should be administered orally once daily with food. Prior to or when initiating treatment, patients should be tested for hepatitis B virus infection, and renal function (including serum creatinine, estimated creatinine clearance, urine glucose, and urine protein) should be assessed.\",\n        \"citations\": [\n            {\n                \"set_id\": \"d9a4185e-43fa-4aeb-9b0f-8db01b166038\",\n                \"passage_id\": \"PASSAGE_0003\",\n                \"section\": \"2.2\",\n                \"supporting_quote\": \"The recommended dosage of emtricitabine, rilpivirine and tenofovir disoproxil fumarate tablets in adult and pediatric patients weighing at least 35 kg is one tablet taken orally once daily with food .\"\n            },\n            {\n                \"set_id\": \"d9a4185e-43fa-4aeb-9b0f-8db01b166038\",\n                \"passage_id\": \"PASSAGE_0002\",\n                \"section\": \"2.1\",\n                \"supporting_quote\": \"Prior to or when initiating emtricitabine, rilpivirine and tenofovir disoproxil fumarate tablets, test patients for hepatitis B virus infection .\"\n            }\n        ],\n        \"structured_fields\": {\n            \"dose\": \"200/25/300\",\n            \"unit\": \"mg/mg/mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"once daily\",\n            \"population\": \"adult and pediatric patients weighing at least 35 kg\",\n            \"max_daily_dose\": \"200/25/300 mg\",\n            \"citation_passages\": [\"PASSAGE_0002\", \"PASSAGE_0003\"]\n        }\n    },\n    {\n        \"qid\": \"2566741a8a58fd5d\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"CELECOXIB capsules are administered orally. The doses can be given without regard to the timing of meals. For patients who have difficulty swallowing capsules, the contents of a celecoxib capsule can be added to applesauce. The entire capsule contents are carefully emptied onto a level teaspoon of cool or room temperature applesauce and ingeste"]
[274.038394, "i", "d immediately with water. The sprinkled capsule contents on applesauce are stable for up to 6 hours under refrigerated conditions.\",\n        \"citations\": [\n            {\n                \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\n                \"passage_id\": \"PASSAGE_0008\",\n                \"section\": \"2.1\",\n                \"supporting_quote\": \"These doses can be given without regard to timing of meals.\"\n            },\n            {\n                \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\n                \"passage_id\": \"PASSAGE_0011\",\n                \"section\": \"2.4\",\n                \"supporting_quote\": \"For patients who have difficulty swallowing capsules, the contents of a celecoxib capsule can be added to applesauce. The entire capsule contents are carefully emptied onto a level teaspoon of cool or room temperature applesauce and ingested immediately with water.\"\n            }\n        ],\n        \"structured_fields\": {\n            \"dose\": \"50-400\",\n            \"unit\": \"mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"once or twice daily\",\n            \"population\": \"adults and pediatric patients 2 years and older\",\n            \"max_daily_dose\": \"400 mg\",\n            \"citation_passages\": [\"PASSAGE_0008\", \"PASSAGE_0011\"]\n        }\n    },\n    {\n        \"qid\": \"0de6259e34606d2d\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"The recommended dosage regimen of CELECOXIB varies by indication: For Osteoarthritis (OA), the dosage is 200 mg per day administered as a single dose or as 100 mg twice daily. For Rheumatoid Arthritis (RA), the dosage is 100 mg to 200 mg twice daily. For Ankylosing Spondylitis (AS), the dosage is 200 mg daily in single or divided doses, which can be increased to 400 mg daily if needed. For JRA (age 2 and older), the dosage is weight-based: 50 mg twice daily for patients 10 kg to 25 kg, and 100 mg twice daily for patients over 25 kg. For Acute Pain and Primary Dysmenorrhea, the dosage is 400 mg initially, followed by an additional 200 mg dose if needed on the first day, and 200 mg twice daily as needed on subsequent days.\",\n        \"citations\": [\n            {\n                \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\n                \"passage_id\": \"PASSAGE_0009\",\n                \"section\": \"2.2\",\n                \"supporting_quote\": \"For OA, the dosage is 200 mg per day administered as a single dose or as 100 mg twice daily.\"\n            },\n            {\n                \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\n                \"passage_id\": \"PASSAGE_0010\",\n                \"section\": \"2.3\",\n                \"supporting_quote\": \"For RA, the dosage is 100 mg to 200 mg twice daily.\"\n            },\n            {\n                \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\n                \"passage_id\": \"PASSAGE_0012\",\n                \"section\": \"2.5\",\n                \"supporting_quote\": \"For AS, the dosage of celecoxib capsules is 200 mg daily in single (once per day) or divided (twice per day) doses. If no effect is observed after 6 weeks, a trial of 400 mg daily may be worthwhile.\"\n            },\n            {\n                \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\n                \"passage_id\": \"PASSAGE_0013\",\n                \"section\": \"2.6\",\n                \"supporting_quote\": \"For management of Acute Pain and Treatment of Primary Dysmenorrhea, the dosage is 400 mg initially, followed by an additional 200 mg dose if needed on the first day. On subsequent days, the recommended dose is 200 mg twice daily as needed.\"\n            }\n        ],\n        \"structured_fields\": {\n            \"dose\": \"100-400\",\n            \"unit\": \"mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"once or twice daily\",\n            \"population\": \"adults and pediatric patients 2 years and older\",\n            \"max_daily_dose\": \"400 mg\",\n            \"citation_passages\": [\"PASSAGE_0009\", \"PASSAGE_0010\", \"PASSAGE_0012\", \"PASSAGE_0013\"]\n        }\n    },\n    {\n        \"qid\": \"85c49de5de841cb9\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"The recommended starting dose of L"]
[274.038561, "i", "enalidomide varies by indication: For Multiple Myeloma (MM) combination therapy, it is 25 mg orally once daily on Days 1 to 21 of repeated 28-day cycles in combination with dexamethasone. For MM maintenance therapy following auto-HSCT, it is 10 mg once daily continuously (Days 1 to 28 of repeated 28-day cycles). For Myelodysplastic Syndromes (MDS), it is 10 mg daily. For Mantle Cell Lymphoma (MCL), it is 25 mg/day orally on Days 1 to 21 of repeated 28-day cycles. For Follicular Lymphoma (FL) or Marginal Zone Lymphoma (MZL), it is 20 mg orally once daily on Days 1 to 21 of repeated 28-day cycles for up to 12 cycles in combination with a rituximab-product.\",\n        \"citations\": [\n            {\n                \"set_id\": \"ed7a3099-ce31-4865-b212-358d9ff6261b\",\n                \"passage_id\": \"PASSAGE_0009\",\n                \"section\": \"2.1\",\n                \"supporting_quote\": \"The recommended starting dose of lenalidomide is 25 mg orally once daily on Days 1 to 21 of repeated 28-day cycles in combination with dexamethasone.\"\n            },\n            {\n                \"set_id\": \"ed7a3099-ce31-4865-b212-358d9ff6261b\",\n                \"passage_id\": \"PASSAGE_0010\",\n                \"section\": \"2.1\",\n                \"supporting_quote\": \"The recommended starting dose of lenalidomide is 10 mg once daily continuously (Days 1 to 28 of repeated 28-day cycles) until disease progression or unacceptable toxicity.\"\n            },\n            {\n                \"set_id\": \"ed7a3099-ce31-4865-b212-358d9ff6261b\",\n                \"passage_id\": \"PASSAGE_0015\",\n                \"section\": \"2.2\",\n                \"supporting_quote\": \"The recommended starting dose of lenalidomide is 10 mg daily.\"\n            },\n            {\n                \"set_id\": \"ed7a3099-ce31-4865-b212-358d9ff6261b\",\n                \"passage_id\": \"PASSAGE_0019\",\n                \"section\": \"2.3\",\n                \"supporting_quote\": \"The recommended starting dose of lenalidomide is 25 mg/day orally on Days 1 to 21 of repeated 28-day cycles for relapsed or refractory mantle cell lymphoma.\"\n            },\n            {\n                \"set_id\": \"ed7a3099-ce31-4865-b212-358d9ff6261b\",\n                \"passage_id\": \"PASSAGE_0022\",\n                \"section\": \"2.4\",\n                \"supporting_quote\": \"The recommended starting dose of lenalidomide is 20 mg orally once daily on Days 1 to 21 of repeated 28-day cycles for up to 12 cycles of treatment in combination with a rituximab-product.\"\n            }\n        ],\n        \"structured_fields\": {\n            \"dose\": \"10-25\",\n            \"unit\": \"mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"once daily\",\n            \"population\": \"adults\",\n            \"max_daily_dose\": \"25 mg\",\n            \"citation_passages\": [\"PASSAGE_0009\", \"PASSAGE_0010\", \"PASSAGE_0015\", \"PASSAGE_0019\", \"PASSAGE_0022\"]\n        }\n    },\n    {\n        \"qid\": \"0d262ce5d03f7c38\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Lenalidomide should be taken orally at about the same time each day, either with or without food. Patients should be advised to swallow lenalidomide capsules whole with water and not to open, break, or chew them.\",\n        \"citations\": [\n            {\n                \"set_id\": \"ed7a3099-ce31-4865-b212-358d9ff6261b\",\n                \"passage_id\": \"PASSAGE_0032\",\n                \"section\": \"2.7\",\n                \"supporting_quote\": \"Advise patients to take lenalidomide orally at about the same time each day, either with or without food. Advise patients to swallow lenalidomide capsules whole with water and not to open, break, or chew them.\"\n            }\n        ],\n        \"structured_fi"]
