[274.06527, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.065313, "o", ">     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.065368, "o", "        \"qid\": \"85c49de5de841cb9\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.065388, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.065949, "o", "        \"answer\": \"The recommended starting dose of Lenalidomide varies by indication: For Multiple Myeloma (MM) combination therapy, it is 25 mg orally once daily on Days 1 to 21 of repeated 28-day cycles in combination with dexamethasone. For MM maintenance therapy following auto-HSCT, it is 10 mg once daily continuously (Days 1 to 28 of repeated 28-day cycles). For Myelodysplastic Syndromes (MDS), it is 10 mg daily. For Mantle Cell Lymphoma (MCL), it is 25 mg/day orally on Days 1 to 21 of repeated 28-day cycles. For Follicular Lymphoma (FL) or Marginal Zone Lymphoma (MZL), it is 20 mg orally once daily on Days 1 to 21 of repeated 28-day cycles for up to 12 cycles in combination with a rituximab-product.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
