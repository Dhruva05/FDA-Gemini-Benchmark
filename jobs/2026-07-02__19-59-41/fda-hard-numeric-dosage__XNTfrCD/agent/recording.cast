[274.062693, "o", "                \"supporting_quote\": \"For RA, the dosage is 100 mg to 200 mg twice daily.\"\r\n\u001b[?2004l\r \u001b[?2004h> "]
[274.062711, "o", "            },\r\n\u001b[?2004l\r"]
[274.062753, "o", "\u001b[?2004h"]
[274.062815, "o", ">             {\r\n\u001b[?2004l\re\": \u001b[?2004h> "]
[274.062936, "o", "                \"set_id\": \"27f17ae7-939b-402e-9498-3b6611104089\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.063089, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\rSS\u001b[?2004h> "]
[274.063213, "o", "                \"section\": \"2.5\",\r\n\u001b[?2004l\r"]
[274.063238, "o", "\u001b[?2004h> "]
[274.063554, "o", "                \"supporting_quote\": \"For AS, the dosage of celecoxib capsules is 200 mg daily in single (once per day) or divided (twice per day) doses. If no effect is observed after 6 weeks, a trial of 400 mg daily may be worthwhile.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.06357, "o", "> "]
[274.063613, "o", "            },\r\n\u001b[?2004l\rth"]
