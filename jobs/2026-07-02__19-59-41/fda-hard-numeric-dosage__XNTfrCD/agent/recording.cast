[274.06453, "o", "                \"supporting_quote\": \"For management of Acute Pain and Treatment of Primary Dysmenorrhea, the dosage is 400 mg initially, followed by an additional 200 mg dose if needed on the first day. On subsequent days, the recommended dose is 200 mg twice daily as needed.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
