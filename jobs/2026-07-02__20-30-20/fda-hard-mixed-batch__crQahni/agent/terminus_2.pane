[?2004l[?2004h> # 9. mixed-eead76662cb6bf (Paxlovid, multihop)
[?2004l[?2004h> answers_map["mixed-eead76662cb6bf"] = {
[?2004l[?2004h>     "qid": "mixed-eead76662cb6bf",
[?2004l[?2004h>     "status": "ANSWERED",
[?2004l[?2004h>     "answer": "PAXLOVID contains ritonavir, which is a strong CYP3A inhibitor. Co-administration of PAXLOVID with drugs that are highly dependent on CYP3A for clearance and for which elevated plasma concentrations are associated with serious and/or life-threatening events is contraindicated. In addition, co-administration with strong CYP3A inducers is contraindicated as they can dramatically lower PAXLOVID plasma levels, leading to loss of therapeutic effect and potential viral resistance. PAXLOVID also inhibits CYP2D6, P-gp, and OATP1B1, which can lead to increased exposure of co-administered drugs metabolized or transported via these pathways.",
[?2004l[?2004h>     "citations": [
[?2004l[?2004h>         {
[?2004l[?2004h>             "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",
[?2004l[?2004h>             "passage_id": "PASSAGE_0000",
[?2004l[?2004h>             "section": "WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID",
[?2004l[?2004h>             "supporting_quote": "PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events"
[?2004l[?2004h>         },
[?2004l[?2004h>         {
[?2004l[?2004h>             "set_id": "8a99d6d6-fd9e-45bb-b1bf-48c7f761232a",
[?2004l[?2004h>             "passage_id": "PASSAGE_0019",
[?2004l[?2004h>             "section": "7.1 Potential for PAXLOVID to Affect Other Drugs",
[?2004l[?2004h>             "supporting_quote": "PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1. Co-administration of PAXLOVID with drugs that are primarily metabolized by CYP3A and CYP2D6 or are transported by P-gp or OATP1B1 may result in increased plasma concentrations of such drugs and increase the risk of adverse events."
[?2004l[?2004h>         }
[?2004l[?2004h>     ],
[?2004l[?2004h>     "structured_fields": {}
[?2004l[?2004h> }
[?2004l[?2004h> 
