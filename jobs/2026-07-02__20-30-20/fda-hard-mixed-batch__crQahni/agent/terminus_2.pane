[?2004l[?2004h>             assert "structured_fields" in a, f"Missing structured_fields in answer for {qid}"
[?2004l[?2004h>             assert subfield in a["structured_fields"], f"Missing {subfield} in structured_fields for {qid}"
[?2004l[?2004h>         else:
[?2004l[?2004h>             assert field in a, f"Missing field {field} in answer for {qid}"
[?2004l[?2004h>             
[?2004l[?2004h>     # Check citations
[?2004l[?2004h>     assert "citations" in a, f"Missing citations for {qid}"
[?2004l[?2004h>     for cit in a["citations"]:
