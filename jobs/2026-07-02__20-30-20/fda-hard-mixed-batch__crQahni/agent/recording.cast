[115.527603, "i", "python3 -c '\nimport json\nwith open(\"/workspace/data/public/labels.jsonl\") as f:\n    for line in f:\n        data = json.loads(line)\n        if data[\"drug_name\"] == \"Paxlovid\":\n            for i, chunk in enumerate(data[\"chunks\"]):\n                if \"CONTRAINDICATIONS\" in chunk or \"DRUG INTERACTIONS\" in chunk:\n                    lines = chunk.split(\"\\n\")\n                    for l in lines:\n                        if \"CONTRAINDICATIONS\" in l or \"DRUG INTERACTIONS\" in l or \"7 \" in l or \"4 \" in l:\n                            print(f\"PASSAGE_{i:04d}: {l[:100]}\")\n'\n"]
