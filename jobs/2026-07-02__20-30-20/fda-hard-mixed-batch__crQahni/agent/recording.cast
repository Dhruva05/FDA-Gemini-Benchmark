[161.872993, "o", "> "]
[161.873178, "o", "    \"answer\": \"The 12HR Allergy Relief label discusses warnings, including warnings about allergic reactions and kidney disease, but it does not provide any supported recommendation for a pharmacogenomic testing requirement.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.87324, "o", "    \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.873316, "o", "            \"set_id\": \"ea5d0e55-2191-4094-b082-24b317f95752\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.873334, "o", "            \"passage_id\": \"PASSAGE_0002\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.873394, "o", "            \"section\": \"Warnings\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.87349, "o", "            \"supporting_quote\": \"Ask a doctor before use if you have kidney disease. Your doctor should determine if you need a different dose.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.873597, "o", ">         },\r\n"]
[161.873642, "o", "\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.873699, "o", "            \"set_id\": \"ea5d0e55-2191-4094-b082-24b317f95752\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.873772, "o", "            \"passage_id\": \"PASSAGE_0001\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.873861, "o", "            \"section\": \"Warnings\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.87393, "o", "            \"supporting_quote\": \"Do not use if you have ever had an allergic reaction to this product or any of its ingredients.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.874034, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h>     \"structured_fields\": {\r\n\u001b[?2004l\r\u001b[?2004h>         \"searched_topic\": \"warnings\",\r\n\u001b[?2004l\r\u001b[?2004h"]
