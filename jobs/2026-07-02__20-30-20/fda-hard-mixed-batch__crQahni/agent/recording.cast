[161.869145, "o", "# 6. a0576a26f2a2eeac (Lopinavir-Ritonavir, numeric)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.86923, "o", "answers_map[\"a0576a26f2a2eeac\"] = {\r\n\u001b[?2004l\rote\": \"Aca\u001b[?2004h> "]
[161.869294, "o", "    \"qid\": \"a0576a26f2a2eeac\",\r\n\u001b[?2004l\rcontraindic\u001b[?2004h> "]
[161.869367, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rseve\u001b[?2004h> "]
[161.86996, "o", "    \"answer\": \"The recommended dosage regimen of Lopinavir-Ritonavir in adults is either 800 mg lopinavir / 200 mg ritonavir (10 mL) once daily or 400 mg lopinavir / 100 mg ritonavir (5 mL) twice daily, administered with food. Once-daily dosing is not recommended in pregnant patients, pediatric patients, or in combination with certain CYP3A inducers. The maximum daily adult dose is 800 mg lopinavir / 200 mg ritonavir.\",\r\n\u001b[?2004l\r"]
[161.869978, "o", "\u001b[?2004h>     \"citations\": [\r\n\u001b[?2004l\ritor."]
