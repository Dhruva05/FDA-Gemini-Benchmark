[161.848077, "i", "cat << 'EOF' > /workspace/build_answers.py\nimport json\n\n# Let's define the answers for each QID\n\n# Paxlovid set_id: 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\n# Lopinavir-Ritonavir set_id: 4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\n# 12HR Allergy Relief set_id: ea5d0e55-2191-4094-b082-24b317f95752\n# Acamprosate Calcium set_id: ae6e79c0-a307-4888-b647-1b7be4cb9127\n\nanswers_map = {}\n\n# 1. b2531657ba5c7a78 (Paxlovid, factual)\nanswers_map[\"b2531657ba5c7a78\"] = {\n    \"qid\": \"b2531657ba5c7a78\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"PAXLOVID is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp, and OATP1B1. Co-administration of PAXLOVID with drugs primarily metabolized by CYP3A and CYP2D6 or transported by P-gp or OATP1B1 can significantly increase their plasma concentrations and the risk of serious, life-threatening, or fatal adverse events. Additionally, co-administration of PAXLOVID with strong CYP3A inducers is contraindicated because it can significantly reduce plasma concentrations of nirmatrelvir or ritonavir, potentially leading to a loss of virologic response and development of resistance.\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0000\",\n            \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\n            \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\n        },\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0012\",\n            \"section\": \"4 CONTRAINDICATIONS\",\n            \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\n        },\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0019\",\n            \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\n            \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1. Co-administration of PAXLOVID with drugs that are primarily metabolized by CYP3A and CYP2D6 or are transported by P-gp or OATP1B1 may result in increased plasma concentrations of such drugs and increase the risk of adverse events.\"\n        }\n    ],\n    \"structured_fields\": {}\n}\n\n# 2. 6f12607a1ba14dd5 (Paxlovid, factual)\nanswers_map[\"6f12607a1ba14dd5\"] = {\n    \"qid\": \"6f12607a1ba14dd5\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Medications that should be avoided or are contraindicated with PAXLOVID include: alpha 1-adrenoreceptor antagonists (alfuzosin), antianginals (ranolazine), antiarrhythmics (amiodarone, dronedarone, flecainide, propafenone, quinidine), anti-gout agents (colchicine in patients with renal and/or hepatic impairment), antipsychotics (lurasidone, pimozide), benign prostatic hyperplasia agents (silodosin), cardiovascular agents (eplerenone, ivabradine), ergot derivatives (dihydroergotamine, ergotamine, methylergonovine), HMG-CoA reductase inhibitors (lovastatin, simvastatin), immunosuppressants (voclosporin), microsomal triglyceride transfer protein inhibitors (lomitapide), migraine medications (eletriptan, ubrogepant), mineralocorticoid receptor antagonists (finerenone), opioid antagonists (naloxegol), PDE5 inhibitors (sildenafil [Revatio] for pulmonary arterial hypertension), sedative/hypnotics (triazolam, oral midazolam), serotonin receptor 1A agonist/serotonin receptor 2A antagonists (flibanserin), and vasopressin receptor antagonists (tolvaptan). Strong CYP3A inducers to be avoided include apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John\\u0027s Wort. Other medications to avoid concomitant use with include tamsulosin, en"]
[161.848243, "i", "corafenib, ivosidenib, neratinib, venetoclax, ibrutinib, rivaroxaban, voriconazole, aliskiren, ticagrelor, vorapaxar, glecaprevir/pibrentasvir, everolimus, sirolimus, salmeterol, rimegepant, suvorexant, and tadalafil (for PAH).\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0012\",\n            \"section\": \"4 CONTRAINDICATIONS\",\n            \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\n        }\n    ],\n    \"structured_fields\": {}\n}\n\n# 3. mixed-2a90a3df19df68 (Paxlovid, factual)\nanswers_map[\"mixed-2a90a3df19df68\"] = {\n    \"qid\": \"mixed-2a90a3df19df68\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"PAXLOVID contains ritonavir, which is a strong CYP3A inhibitor. This can result in increased plasma concentrations of concomitant medications that are primarily metabolized by CYP3A, potentially leading to serious, life-threatening, or fatal adverse events. PAXLOVID is contraindicated with drugs highly dependent on CYP3A for clearance and with strong CYP3A inducers that can significantly lower PAXLOVID plasma levels and lead to loss of efficacy and viral resistance. It also inhibits CYP2D6, P-gp, and OATP1B1, which can increase exposure to drugs metabolized or transported by these pathways.\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0000\",\n            \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\n            \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\n        },\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0019\",\n            \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\n            \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1.\"\n        }\n    ],\n    \"structured_fields\": {}\n}\n\n# 4. mixed-7c14643ec4356a (Paxlovid, factual)\nanswers_map[\"mixed-7c14643ec4356a\"] = {\n    \"qid\": \"mixed-7c14643ec4356a\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"Medications contraindicated and to be avoided with PAXLOVID include: alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in renal/hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (Revatio for PAH), triazolam, oral midazolam, flibanserin, and tolvaptan. Strong CYP3A inducers such as apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John\\u0027s Wort are also contraindicated. Concomitant use of other drugs like tamsulosin, encorafenib, ivosidenib, neratinib, venetoclax, ibrutinib, rivaroxaban, voriconazole, aliskiren, ticagrelor, vorapaxar, glecaprevir/pibrentasvir, everolimus, sirolimus, salmeterol, rimegepant, suvorexant, and tadalafil (for PAH) should also be avoided.\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0012\",\n            \"section\": \"4 CONTRAINDICATIONS\",\n            \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\n        }\n    ],\n    \"structured_fields\": {}\n}\n\n# 5. daef650b92e56473 (Lopinavir-Ritonavir, numeric)\nanswers_map[\"daef650b92e56473\"] = {\n    \"qid\": \"daef650b92e56473\",\n    \"status\": \"ANS"]
[161.848335, "i", "WERED\",\n    \"answer\": \"Lopinavir-Ritonavir oral solution must be administered with food. In adults, it can be given in a once-daily regimen of 800 mg lopinavir / 200 mg ritonavir (10 mL) or a twice-daily regimen of 400 mg lopinavir / 100 mg ritonavir (5 mL). Once-daily dosing is not recommended in pediatric patients, pregnant women, or patients taking certain concomitant medications. The maximum recommended daily adult dose is 800 mg lopinavir / 200 mg ritonavir (10 mL).\",\n    \"citations\": [\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0001\",\n            \"section\": \"2.1 General Administration Recommendations\",\n            \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\n        },\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0003\",\n            \"section\": \"2.3 Dosage Recommendations in Adults\",\n            \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2.\"\n        },\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0005\",\n            \"section\": \"Recommended Dosage\",\n            \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 400 mg/100 mg (5 mL) twice daily\"\n        }\n    ],\n    \"structured_fields\": {\n        \"dose\": \"400/100\",\n        \"unit\": \"mg\",\n        \"route\": \"oral\",\n        \"frequency\": \"twice daily\",\n        \"population\": \"adults\",\n        \"max_daily_dose\": \"800/200 mg\",\n        \"citation_passages\": [\"PASSAGE_0001\", \"PASSAGE_0003\", \"PASSAGE_0005\"]\n    }\n}\n\n# 6. a0576a26f2a2eeac (Lopinavir-Ritonavir, numeric)\nanswers_map[\"a0576a26f2a2eeac\"] = {\n    \"qid\": \"a0576a26f2a2eeac\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"The recommended dosage regimen of Lopinavir-Ritonavir in adults is either 800 mg lopinavir / 200 mg ritonavir (10 mL) once daily or 400 mg lopinavir / 100 mg ritonavir (5 mL) twice daily, administered with food. Once-daily dosing is not recommended in pregnant patients, pediatric patients, or in combination with certain CYP3A inducers. The maximum daily adult dose is 800 mg lopinavir / 200 mg ritonavir.\",\n    \"citations\": [\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0001\",\n            \"section\": \"2.1 General Administration Recommendations\",\n            \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\n        },\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0003\",\n            \"section\": \"2.3 Dosage Recommendations in Adults\",\n            \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2.\"\n        },\n        {\n            \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n            \"passage_id\": \"PASSAGE_0005\",\n            \"section\": \"Recommended Dosage\",\n            \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 400 mg/100 mg (5 mL) twice daily\"\n        }\n    ],\n    \"structured_fields\": {\n        \"dose\": \"400/100\",\n        \"unit\": \"mg\",\n        \"route\": \"oral\",\n        \"frequency\": \"twice daily\",\n        \"population\": \"adults\",\n        \"max_daily_dose\": \"800/200 mg\",\n        \"citation_passages\": [\"PASSAGE_0001\", \"PASSAGE_0003\", \"PASSAGE_0005\"]\n    }\n}\n\n# 7. near-miss-04f3afa658fdef (12HR Allergy Relief, refusal)\nanswers_map[\"near-miss-04f3afa658fdef\"] = {\n    \"qid\": \"near-miss-04f3afa658fdef\",\n    \"status\": \"NOT_FOUND\",\n    \"answer\": \"The 12HR Allergy Relief label discusses warnings, including warnings about allergic reactions and kidney disease, but it does not provide any supported recommendation for a pharmacogenomic testing requirement.\",\n    \"citations\": [\n        {\n            \"set_id\": \"ea5d0e55-2191-4094-b082-24b317f95752\",\n            \"passage_id\": \"PASSAGE_0002\",\n            \"section\": \"Warnings\",\n            \"supporting_quote\": \"Ask a "]
[161.848382, "i", "doctor before use if you have kidney disease. Your doctor should determine if you need a different dose.\"\n        },\n        {\n            \"set_id\": \"ea5d0e55-2191-4094-b082-24b317f95752\",\n            \"passage_id\": \"PASSAGE_0001\",\n            \"section\": \"Warnings\",\n            \"supporting_quote\": \"Do not use if you have ever had an allergic reaction to this product or any of its ingredients.\"\n        }\n    ],\n    \"structured_fields\": {\n        \"searched_topic\": \"warnings\",\n        \"unsupported_topic\": \"pharmacogenomic testing requirement\"\n    }\n}\n\n# 8. near-miss-0c6ec72416151f (Acamprosate Calcium, refusal)\nanswers_map[\"near-miss-0c6ec72416151f\"] = {\n    \"qid\": \"near-miss-0c6ec72416151f\",\n    \"status\": \"NOT_FOUND\",\n    \"answer\": \"The Acamprosate Calcium label discusses dosage adjustment in moderate renal impairment and contraindication in severe renal impairment, and mentions that no dosage adjustment is recommended in mild to moderate hepatic impairment. However, it does not provide any supported recommendation for patients with severe hepatic impairment.\",\n    \"citations\": [\n        {\n            \"set_id\": \"ae6e79c0-a307-4888-b647-1b7be4cb9127\",\n            \"passage_id\": \"PASSAGE_0044\",\n            \"section\": \"12.3 Pharmacokinetics - Hepatic Impairment\",\n            \"supporting_quote\": \"Acamprosate is not metabolized by the liver and the pharmacokinetics of acamprosate calcium are not altered in patients with mild to moderate hepatic impairment (groups A and B of the Child-Pugh classification). No adjustment of dosage is recommended in such patients.\"\n        },\n        {\n            \"set_id\": \"ae6e79c0-a307-4888-b647-1b7be4cb9127\",\n            \"passage_id\": \"PASSAGE_0035\",\n            \"section\": \"8.6 Renal Impairment\",\n            \"supporting_quote\": \"Acamprosate calcium is contraindicated in patients with severe renal impairment (creatinine clearance of <=30 mL/min) .\"\n        }\n    ],\n    \"structured_fields\": {\n        \"searched_topic\": \"renal impairment\",\n        \"unsupported_topic\": \"severe hepatic impairment\"\n    }\n}\n\n# 9. mixed-eead76662cb6bf (Paxlovid, multihop)\nanswers_map[\"mixed-eead76662cb6bf\"] = {\n    \"qid\": \"mixed-eead76662cb6bf\",\n    \"status\": \"ANSWERED\",\n    \"answer\": \"PAXLOVID contains ritonavir, which is a strong CYP3A inhibitor. Co-administration of PAXLOVID with drugs that are highly dependent on CYP3A for clearance and for which elevated plasma concentrations are associated with serious and/or life-threatening events is contraindicated. In addition, co-administration with strong CYP3A inducers is contraindicated as they can dramatically lower PAXLOVID plasma levels, leading to loss of therapeutic effect and potential viral resistance. PAXLOVID also inhibits CYP2D6, P-gp, and OATP1B1, which can lead to increased exposure of co-administered drugs metabolized or transported via these pathways.\",\n    \"citations\": [\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0000\",\n            \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\n            \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\n        },\n        {\n            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n            \"passage_id\": \"PASSAGE_0019\",\n            \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\n            \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1. Co-ad"]
