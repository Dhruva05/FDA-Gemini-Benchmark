[161.861936, "o", "\u001b[?2004h> "]
[161.862078, "o", "            \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.86243, "o", "            \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.862506, "o", "        }\r\n\u001b[?2004l\rs\":\u001b[?2004h>     ],\r\n\u001b[?2004l\r\r\n    "]
