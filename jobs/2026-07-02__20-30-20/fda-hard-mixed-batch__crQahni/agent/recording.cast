[133.591423, "i", "cat << 'EOF' > /workspace/generate_answers.py\nimport json\n\nlabels = {}\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        labels[data['drug_name']] = data\n\nquestions = []\nwith open('/workspace/data/public/questions.jsonl') as f:\n    for line in f:\n        questions.append(json.loads(line))\n\nprint(\"Loaded\", len(labels), \"labels and\", len(questions), \"questions.\")\nEOF\npython3 /workspace/generate_answers.py\n"]
