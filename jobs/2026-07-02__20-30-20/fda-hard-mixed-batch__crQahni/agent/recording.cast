[161.85025, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[161.850363, "o", "# 1. b2531657ba5c7a78 (Paxlovid, factual)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.850526, "o", "answers_map[\"b2531657ba5c7a78\"] = {\r\n\u001b[?2004l\r\u001b[?2004h>     \"qid\": \"b2531657ba5c7a78\",\r\n\u001b[?2004l\r"]
[161.850611, "o", "\u001b[?2004h>     \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.851804, "o", "    \"answer\": \"PAXLOVID is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp, and OATP1B1. Co-administration of PAXLOVID with drugs primarily metabolized by CYP3A and CYP2D6 or transported by P-gp or OATP1B1 can significantly increase their plasma concentrations and the risk of serious, life-threatening, or fatal adverse events. Additionally, co-administration of PAXLOVID with strong CYP3A inducers is contraindicated because it can significantly reduce plasma concentrations of nirmatrelvir or ritonavir, potentially leading to a loss of virologic response and development of resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.851906, "o", "    \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.851927, "o", "        {"]
[161.851999, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.852112, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.852215, "o", "            \"passage_id\": \"PASSAGE_0000\",\r\n\u001b[?2004l\r"]
[161.852266, "o", "\u001b[?2004h> "]
[161.852443, "o", "            \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\r\n\u001b[?2004l\r of efficacy and \u001b[?2004h> "]
[161.852939, "o", "            \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.853054, "o", "        },\r\n\u001b[?2004l\r\r\n\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.853304, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.853471, "o", "            \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\rRACTIONS WITH PAXL\u001b[?2004h> "]
[161.853731, "o", "            \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.853979, "o", "            \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r2\u001b[?2004h> "]
[161.854011, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.854182, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[161.854288, "o", "            \"passage_id\": \"PASSAGE_0019\",\r\n\u001b[?2004l\rfect Other\u001b[?2004h> "]
[161.854458, "o", "            \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.855161, "o", "            \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A, and an inhibitor of CYP2D6, P-gp and OATP1B1. Co-administration of PAXLOVID with drugs that are primarily metabolized by CYP3A and CYP2D6 or are transported by P-gp or OATP1B1 may result in increased plasma concentrations of such drugs and increase the risk of adverse events.\"\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[161.855198, "o", "\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.855278, "o", "    \"structured_fields\": {}\r\n\u001b[?2004l\ro\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[161.855356, "o", "\u001b[?2004h> "]
[161.85543, "o", "# 2. 6f12607a1ba14dd5 (Paxlovid, factual)\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.855451, "o", "> "]
[161.855532, "o", "answers_map[\"6f12607a1ba14dd5\"] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.85556, "o", "    \"qid\": \"6f12607a1ba14dd5\",\r\n\u001b[?2004l\rrenone, ivab"]
[161.855687, "o", "\u001b[?2004h>     \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r,\u001b[?2004h> "]
[161.858279, "o", "    \"answer\": \"Medications that should be avoided or are contraindicated with PAXLOVID include: alpha 1-adrenoreceptor antagonists (alfuzosin), antianginals (ranolazine), antiarrhythmics (amiodarone, dronedarone, flecainide, propafenone, quinidine), anti-gout agents (colchicine in patients with renal and/or hepatic impairment), antipsychotics (lurasidone, pimozide), benign prostatic hyperplasia agents (silodosin), cardiovascular agents (eplerenone, ivabradine), ergot derivatives (dihydroergotamine, ergotamine, methylergonovine), HMG-CoA reductase inhibitors (lovastatin, simvastatin), immunosuppressants (voclosporin), microsomal triglyceride transfer protein inhibitors (lomitapide), migraine medications (eletriptan, ubrogepant), mineralocorticoid receptor antagonists (finerenone), opioid antagonists (naloxegol), PDE5 inhibitors (sildenafil [Revatio] for pulmonary arterial hypertension), sedative/hypnotics (triazolam, oral midazolam), serotonin receptor 1A agonist/serotonin receptor 2A antagonists (flibanserin), and vasopressin receptor antagonists (tolvaptan). Strong CYP3A inducers to be avoided include apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John\\u0027s Wort. Other medications to avoid concomitant use with include tamsulosin, encorafenib, ivosidenib, neratinib, venetoclax, ibrutinib, rivaroxaban, voriconazole, aliskiren, ticagrelor, vorapaxar, glecaprevir/pibrentasvir, everolimus, sirolimus, salmeterol, rimegepant, suvorexant, and tadalafil (for PAH).\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.858358, "o", "    \"citations\": [\r\n\u001b[?2004l\rvi\u001b[?2004h> "]
[161.85842, "o", "        {\r\n\u001b[?2004l\r). \u001b[?2004h> "]
[161.85852, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.858618, "o", "            \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\rin c\u001b[?2004h> "]
[161.858705, "o", "            \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r"]
[161.858766, "o", "\u001b[?2004h> "]
[161.859232, "o", "            \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\r\n\u001b[?2004l\rR\u001b[?2004h"]
[161.859287, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.859307, "o", ">     ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.85939, "o", "    \"structured_fields\": {}\r\n\u001b[?2004l\r"]
[161.859479, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.859503, "o", "# 3. mixed-2a90a3df19df68 (Paxlovid, factual)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.859612, "o", "answers_map[\"mixed-2a90a3df19df68\"] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.859722, "o", "    \"qid\": \"mixed-2a90a3df19df68\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.860623, "o", "    \"answer\": \"PAXLOVID contains ritonavir, which is a strong CYP3A inhibitor. This can result in increased plasma concentrations of concomitant medications that are primarily metabolized by CYP3A, potentially leading to serious, life-threatening, or fatal adverse events. PAXLOVID is contraindicated with drugs highly dependent on CYP3A for clearance and with strong CYP3A inducers that can significantly lower PAXLOVID plasma levels and lead to loss of efficacy and viral resistance. It also inhibits CYP2D6, P-gp, and OATP1B1, which can increase exposure to drugs metabolized or transported by these pathways.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.860644, "o", "    \"citations\": [\r\n\u001b[?2004l\rt"]
[161.860715, "o", "\u001b[?2004h> "]
[161.860773, "o", "        {\r\n\u001b[?2004l\re\": \"oral\"\u001b[?2004h> "]
[161.860841, "o", "            \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.860967, "o", "            \"passage_id\": \"PASSAGE_0000\",\r\n\u001b[?2004l\r"]
[161.860988, "o", "\u001b[?2004h> "]
