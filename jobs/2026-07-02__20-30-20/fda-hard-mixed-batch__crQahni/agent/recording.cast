[161.861597, "o", "            \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.861634, "o", "        },\r\n\u001b[?2004l\r"]
