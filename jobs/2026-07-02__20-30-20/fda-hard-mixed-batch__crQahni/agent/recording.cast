[161.865641, "o", "    \"qid\": \"daef650b92e56473\",\r\n\u001b[?2004l\r\"supporti\u001b[?2004h> "]
[161.865708, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.866332, "o", "    \"answer\": \"Lopinavir-Ritonavir oral solution must be administered with food. In adults, it can be given in a once-daily regimen of 800 mg lopinavir / 200 mg ritonavir (10 mL) or a twice-daily regimen of 400 mg lopinavir / 100 mg ritonavir (5 mL). Once-daily dosing is not recommended in pediatric patients, pregnant women, or patients taking certain concomitant medications. The maximum recommended daily adult dose is 800 mg lopinavir / 200 mg ritonavir (10 mL).\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.866351, "o", "    \"citations\": [\r\n\u001b[?2004l\r"]
[161.866415, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\rd_topic\": \u001b[?2004h> "]
