[161.862805, "o", "# 4. mixed-7c14643ec4356a (Paxlovid, factual)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.862894, "o", "answers_map[\"mixed-7c14643ec4356a\"] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.862959, "o", "    \"qid\": \"mixed-7c14643ec4356a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.863055, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.864411, "o", "    \"answer\": \"Medications contraindicated and to be avoided with PAXLOVID include: alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in renal/hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (Revatio for PAH), triazolam, oral midazolam, flibanserin, and tolvaptan. Strong CYP3A inducers such as apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John\\u0027s Wort are also contraindicated. Concomitant use of other drugs like tamsulosin, encorafenib, ivosidenib, neratinib, venetoclax, ibrutinib, rivaroxaban, voriconazole, aliskiren, ticagrelor, vorapaxar, glecaprevir/pibrentasvir, everolimus, sirolimus, salmeterol, rimegepant, suvorexant, and tadalafil (for PAH) should also be avoided.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[161.864481, "o", "> "]
