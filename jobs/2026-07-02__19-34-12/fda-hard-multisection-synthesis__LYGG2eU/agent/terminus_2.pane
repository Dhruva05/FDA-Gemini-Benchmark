[?2004l[?2004h>     {
[?2004l[?2004h>         "qid": "9be5515bc3064979",
[?2004l     "answer": "Important warnings [?2004h>         "status": "ANSWERED",
[?2004l[?2004h>         "answer": "Safety risks listed for Lopinavir-Ritonavir include: serious drug interactions (leading to severe, life-threatening, or fatal events); toxicity in preterm neonates due to ethanol and propylene glycol excipients (including cardiac toxicity, lactic acidosis, renal failure, CNS depression, and respiratory complications); pancreatitis (sometimes fatal, associated with marked triglyceride elevations); hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation); QT interval prolongation and torsade de pointes; PR interval prolongation (AV block); new onset diabetes mellitus or hyperglycemia; immune reconstitution syndrome; lipid elevations (large increases in total cholesterol and triglycerides); fat redistribution; increased bleeding in patients with hemophilia; and potential for HIV-1 resistance/cross-resistance.",
[?2004l[?2004h>         "citations": [
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0014",
[?2004l[?2004h>                 "section": "5.1 Risk of Serious Adverse Reactions Due to Drug Interactions",
[?2004l[?2004h>                 "supporting_quote": "Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l
  [?2004h>                 "passage_id": "PASSAGE_0015",
[?2004l[?2004h>                 "section": "5.2 Toxicity in Preterm Neonates",
[?2004l": "PASSAGE_0015",[?2004h>                 "supporting_quote": "Preterm neonates may be at increased risk of propylene glycol-associated adverse events due to diminished ability to metabolize propylene glycol, thereby leading to accumulation and potential adverse events."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0016",
[?2004l[?2004h>                 "section": "5.3 Pancreatitis",
[?2004l[?2004h>                 "supporting_quote": "Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0017",
[?2004l3-91[?2004h>                 "section": "5.4 Hepatotoxicity",
[?2004l[?2004h>                 "supporting_quote": "There have been postmarketing reports of hepatic dysfunction, including some fatalities. These have generally occurred in patients with advanced HIV-1 disease taking multiple concomitant medications in the setting of underlying chronic hepatitis or cirrhosis."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l "set_id": "4b[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0018",
[?2004l[?2004h>                 "section": "5.5 QT Interval Prolongation",
[?2004l[?2004h>                 "supporting_quote": "Postmarketing cases of QT interval prolongation and torsade de pointes have been reported although causality of lopinavir and ritonavir could not be established."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0019",
[?2004l[?2004h>                 "section": "5.6 PR Interval Prolongation",
[?2004l[?2004h>                 "supporting_quote": "Lopinavir and ritonavir prolongs the PR interval in some patients. Cases of second or third degree atrioventricular block have been reported."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0022",
[?2004l[?2004h>                 "section": "5.9 Lipid Elevations",
[?2004l[?2004h>                 "supporting_quote": "Treatment with lopinavir and ritonavir has resulted in large increases in the concentration of total cholesterol and triglycerides ."
[?2004l[?2004h>             }
[?2004l[?2004h>         ],
[?2004l[?2004h>         "structured_fields": {}
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>         "qid": "18078efe9380c8dc",
[?2004l[?2004h>         "status": "ANSWERED",
[?2004l[?2004h>         "answer": "Important warnings and precautions associated with Lopinavir-Ritonavir include: risk of serious adverse reactions due to drug interactions (strong CYP3A inhibition); toxicity in preterm neonates (due to ethanol and propylene glycol excipients, should not be used in preterm neonates in the immediate postnatal period); pancreatitis (potentially fatal, associated with marked triglyceride elevations); hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation); QT interval prolongation and torsade de pointes (avoid in congenital long QT syndrome or hypokalemia); PR interval prolongation (caution in structural heart disease or conduction system abnormalities); diabetes mellitus/hyperglycemia (new onset or exacerbation); immune reconstitution syndrome; lipid elevations (large increases in total cholesterol and triglycerides); fat redistribution; increased bleeding in patients with hemophilia; and potential for HIV-1 resistance/cross-resistance.",
[?2004l[?2004h>         "citations": [
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0014",
[?2004l[?2004h>                 "section": "5.1 Risk of Serious Adverse Reactions Due to Drug Interactions",
[?2004l[?2004h>                 "supporting_quote": "Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0015",
[?2004l[?2004h>                 "section": "5.2 Toxicity in Preterm Neonates",
[?2004l[?2004h>                 "supporting_quote": "Lopinavir and ritonavir oral solution should not be used in preterm neonates in the immediate postnatal period because of possible toxicities."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0016",
[?2004l[?2004h>                 "section": "5.3 Pancreatitis",
[?2004l[?2004h>                 "supporting_quote": "Pancreatitis should be considered if clinical symptoms (nausea, vomiting, abdominal pain) or abnormalities in laboratory values (such as increased serum lipase or amylase values) suggestive of pancreatitis occur."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0017",
[?2004l[?2004h>                 "section": "5.4 Hepatotoxicity",
[?2004l[?2004h>                 "supporting_quote": "Appropriate laboratory testing should be conducted prior to initiating therapy with lopinavir and ritonavir and patients should be monitored closely during treatment."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0018",
[?2004l[?2004h>                 "section": "5.5 QT Interval Prolongation",
[?2004l[?2004h>                 "supporting_quote": "Avoid use in patients with congenital long QT syndrome, those with hypokalemia, and with other drugs that prolong the QT interval ."
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0019",
[?2004l[?2004h>                 "section": "5.6 PR Interval Prolongation",
[?2004l[?2004h>                 "supporting_quote": "Lopinavir and ritonavir should be used with caution in patients with underlying structural heart disease, pre-existing conduction system abnormalities, ischemic heart disease or cardiomyopathies"
[?2004l[?2004h>             },
[?2004l[?2004h>             {
[?2004l[?2004h>                 "set_id": "4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85",
[?2004l[?2004h>                 "passage_id": "PASSAGE_0022",
[?2004l[?2004h>                 "section": "5.9 Lipid Elevations",
[?2004l[?2004h>                 "supporting_quote": "Triglyceride and cholesterol testing should be performed prior to initiating lopinavir and ritonavir therapy and at periodic intervals during therapy."
[?2004l[?2004h>             }
