[?2004l[?2004h>                 "section": "5.2 Toxicity in Preterm Neonates",
[?2004l5.[?2004h>                 "target_text": "Preterm neonates may be at increased risk of propylene glycol-associated adverse events due to diminished ability to metabolize propylene glycol, thereby leading to accumulation and potential adverse events."
[?2004l[?2004h>             },
[?2004l"s[?2004h>             {
