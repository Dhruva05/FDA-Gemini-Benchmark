[?2004hroot@15b83e10b8d1:/workspace# cat << 'EOF' > parse_passages.py
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> with open('/workspace/data/public/labels.jsonl') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         label = json.loads(line)
[?2004l[?2004h>         print(label['drug_name'])
[?2004l[?2004h>         raw = label['label_raw']
[?2004l[?2004h>         # Let's find all occurrences of PASSAGE_####||
[?2004l[?2004h>         matches = list(re.finditer(r'(PASSAGE_\d+)\|\|\n', raw))
[?2004l[?2004h>         passages = {}
[?2004l[?2004h>         for i in range(len(matches)):
[?2004l[?2004h>             start = matches[i].end()
[?2004l[?2004h>             end = matches[i+1].start() if i+1 < len(matches) else len(raw)
[?2004l[?2004h>             pid = matches[i].group(1)
[?2004l[?2004h>             ptext = raw[start:end]
[?2004l[?2004h>             # Clean up trailing/leading newlines to see if it matches chunks
[?2004l[?2004h>             passages[pid] = ptext
[?2004l[?2004h>         
[?2004l[?2004h>         chunks = label['chunks']
[?2004l[?2004h>         print(f"Chunks count: {len(chunks)}, Passages count: {len(passages)}")
[?2004l[?2004h>         
[?2004l[?2004h>         matched = 0
[?2004l[?2004h>         for idx, chunk in enumerate(chunks):
[?2004l[?2004h>             pid = f"PASSAGE_{idx:04d}"
[?2004l[?2004h>             if pid in passages:
[?2004l[?2004h>                 ptext = passages[pid]
[?2004l[?2004h>                 # Strip trailing newlines/whitespace
[?2004l[?2004h>                 if ptext.rstrip() == chunk.rstrip():
