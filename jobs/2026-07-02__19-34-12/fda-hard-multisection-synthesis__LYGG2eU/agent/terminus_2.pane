[?2004l[?2004h>                 ptext = passages[pid]
[?2004l[?2004h>                 if ptext.strip() == chunk.strip():
[?2004l[?2004h>                     matched += 1
[?2004l[?2004h>                 else:
[?2004l[?2004h>                     if matched < 2:
