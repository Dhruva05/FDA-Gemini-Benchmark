[?2004l[?2004h>                 "section": "2.5 Dosage Recommendations in Pregnancy",
[?2004lment with l[?2004h>                 "supporting_quote": "Administer 400/100 mg of lopinavir and ritonavir twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions."
[?2004l[?2004h>             }
[?2004l[?2004h>         ],
[?2004lef[?2004h>         "structured_fields": {}
