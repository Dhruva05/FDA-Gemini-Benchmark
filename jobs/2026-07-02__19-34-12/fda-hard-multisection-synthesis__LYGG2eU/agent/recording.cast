[219.66957, "o", "        \"qid\": \"b2531657ba5c7a78\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.670374, "o", "        \"answer\": \"Paxlovid contains ritonavir, a strong CYP3A inhibitor. This can lead to increased plasma concentrations of concomitant medications metabolized by CYP3A, potentially causing severe, life-threatening, or fatal events. Conversely, strong CYP3A inducers can decrease Paxlovid concentrations, which may lead to loss of therapeutic effect and possible viral resistance. Calcineurin inhibitors (such as tacrolimus and cyclosporine) and calcium channel blockers are the most commonly reported concomitant medications resulting in serious adverse reactions.\",\r\n\u001b[?2004l\r"]
[219.670437, "o", "\u001b[?2004h>         \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.670518, "o", ">             {\r\n\u001b[?2004l\rorting_quote\":\u001b[?2004h> "]
[219.670871, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r ethanol a\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0000\",\r\n\u001b[?2004l\rnd propylene glycol, it is not recommended for\u001b[?2004h> "]
[219.670968, "o", "                \"section\": \"BOXED WARNING\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.671348, "o", "                \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\rion.\"\r\n\u001b[?2004h> "]
[219.671373, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.671508, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.671618, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.671743, "o", "                \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.671946, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r"]
[219.671971, "o", "\u001b[?2004h> "]
[219.672301, "o", "                \"supporting_quote\": \"The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.672474, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[219.67256, "o", "\u001b[?2004h>                 \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r-\u001b[?2004h> "]
[219.672638, "o", "                \"passage_id\": \"PASSAGE_0019\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.672813, "o", "                \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.673079, "o", "                \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.673185, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.673223, "o", "        ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.673307, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.673382, "o", "        \"qid\": \"6f12607a1ba14dd5\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.67345, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rr\u001b[?2004h"]
[219.67358, "o", "> "]
[219.674918, "o", "        \"answer\": \"Paxlovid is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions. It is also contraindicated with strong CYP3A inducers due to the potential for loss of virologic response and resistance. These include: alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in patients with renal and/or hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (Revatio) when used for pulmonary arterial hypertension, triazolam, oral midazolam, flibanserin, tolvaptan, apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort.\",\r\n\u001b[?2004l\r"]
[219.675003, "o", "\u001b[?2004h>         \"citations\": [\r\n\u001b[?2004l\ron\""]
[219.67503, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[219.675038, "o", "\u001b[?2004h> "]
[219.675276, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.675351, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r"]
[219.675375, "o", "\u001b[?2004h> "]
[219.675465, "o", "                \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r    {\r\n                \"se\u001b[?2004h> "]
[219.676176, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers where significantly reduced nirmatrelvir or ritonavir plasma concentrations may be associated with the potential for loss of virologic response and possible resistance.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.676218, "o", "            }\r\n\u001b[?2004l\r   \u001b[?2004h> "]
[219.676291, "o", "        ],\r\n\u001b[?2004l\r           \u001b[?2004h> "]
[219.676399, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r mL\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[219.676466, "o", "\u001b[?2004h> "]
[219.676519, "o", "        \"qid\": \"daef650b92e56473\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rce daily\"\r\n            },\r\n     \u001b[?2004h> "]
[219.677342, "o", "        \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. For administration by feeding tube, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility with the ethanol and propylene glycol excipients. Feeding tubes made of silicone or polyvinyl chloride (PVC) are compatible and can be used. Lopinavir and ritonavir oral solution contains approximately 42% (v/v) ethanol and approximately 15% (w/v) propylene glycol.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.67745, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[219.677546, "o", "\u001b[?2004h>                 \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.677581, "o", "> "]
[219.677643, "o", "                \"passage_id\": \"PASSAGE_0001\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.677794, "o", "                \"section\": \"2.1 General Administration Recommendations\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.677932, "o", "                \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.678046, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\rand respirator\u001b[?2004h> "]
[219.678179, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\rssociated with m\u001b[?2004h> "]
[219.678325, "o", "                \"passage_id\": \"PASSAGE_0002\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.6785, "o", "                \"section\": \"2.2 Administering Oral Solution by Feeding Tube\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.679182, "o", "                \"supporting_quote\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility. Feeding tubes that are compatible with ethanol and propylene glycol, such as silicone and polyvinyl chloride (PVC) feeding tubes, can be used for administration of lopinavir and ritonavir oral solution.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.679255, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r3-9194-6dc1dd9"]
[219.679339, "o", "\u001b[?2004h> "]
[219.679422, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r"]
[219.679461, "o", "\u001b[?2004h> "]
[219.679544, "o", "                \"passage_id\": \"PASSAGE_0106\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.6796, "o", "                \"section\": \"11 DESCRIPTION\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.679843, "o", "                \"supporting_quote\": \"Lopinavir and ritonavir oral solution contains approximately 42% (v/v) ethanol and approximately 15% (w/v) propylene glycol.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.679891, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         ],"]
[219.679965, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.680038, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r"]
[219.680113, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\rlopinav\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.680215, "o", "        \"qid\": \"a0576a26f2a2eeac\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.680243, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.681552, "o", "        \"answer\": \"Lopinavir and ritonavir can be administered as a once-daily or twice-daily regimen in adults. The recommended once-daily dosage is 800 mg/200 mg (10 mL of the 80 mg/20 mg per mL oral solution). Once-daily dosing is not recommended in pregnant women, pediatric patients, patients with three or more lopinavir resistance-associated substitutions, or in combination with carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir. The recommended twice-daily dosage is 400 mg/100 mg (5 mL). When administered in combination with efavirenz, nevirapine, or nelfinavir, the twice-daily dosage must be increased to 520 mg/130 mg (6.5 mL). In pregnant women, the recommended dosage is 400 mg/100 mg twice daily; once-daily dosing is not recommended and oral solution should be avoided.\",\r\n\u001b[?2004l\r"]
[219.68162, "o", "\u001b[?2004h>         \"citations\": [\r\n\u001b[?2004l\r"]
[219.68164, "o", "\u001b[?2004h> "]
[219.6817, "o", "            {\r\n\u001b[?2004l\r     \u001b[?2004h> "]
[219.681893, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.681991, "o", "                \"passage_id\": \"PASSAGE_0003\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
