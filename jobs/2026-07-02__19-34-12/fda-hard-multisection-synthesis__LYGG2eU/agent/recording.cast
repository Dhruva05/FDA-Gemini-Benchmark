[264.578193, "o", "        \"qid\": \"daef650b92e56473\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.578262, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.579082, "o", "        \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. For administration by feeding tube, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility with the ethanol and propylene glycol excipients. Feeding tubes made of silicone or polyvinyl chloride (PVC) are compatible and can be used. Lopinavir and ritonavir oral solution contains approximately 42% (v/v) ethanol and approximately 15% (w/v) propylene glycol.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.579146, "o", "        \"citations_raw\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.579168, "o", "            {\r\n\u001b[?2004l\r"]
[264.57919, "o", "\u001b[?2004h> "]
[264.579282, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.579393, "o", "                \"passage_id\": \"PASSAGE_0001\",\r\n\u001b[?2004l\rvents); \u001b[?2004h> "]
[264.57958, "o", "                \"section\": \"2.1 General Administration Recommendations\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.579724, "o", "                \"target_text\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\r\n\u001b[?2004l\r \u001b[?2004h> "]
[264.579785, "o", "            },\r\n\u001b[?2004l\r"]
[264.57985, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[264.579964, "o", "\u001b[?2004h> "]
[264.580031, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\rride elevations);\u001b[?2004h> "]
[264.58013, "o", "                \"passage_id\": \"PASSAGE_0002\",\r\n\u001b[?2004l\ron, elevated\u001b[?2004h> "]
[264.580255, "o", "                \"section\": \"2.2 Administering Oral Solution by Feeding Tube\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.580878, "o", "                \"target_text\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility. Feeding tubes that are compatible with ethanol and propylene glycol, such as silicone and polyvinyl chloride (PVC) feeding tubes, can be used for administration of lopinavir and ritonavir oral solution.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.580934, "o", "            },\r\n\u001b[?2004l\r"]
[264.580943, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.581061, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\rn\": \"5.1 Ri\u001b[?2004h> "]
[264.581143, "o", "                \"passage_id\": \"PASSAGE_0106\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.581238, "o", "                \"section\": \"11 DESCRIPTION\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.581419, "o", "                \"target_text\": \"Lopinavir and ritonavir oral solution contains approximately 42% (v/v) ethanol and approximately 15% (w/v) propylene glycol.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.58147, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         ],\r\n\u001b[?2004l\r"]
[264.581564, "o", "\u001b[?2004h> "]
[264.581582, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\rnavi\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[264.581617, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.581703, "o", "        \"qid\": \"a0576a26f2a2eeac\",\r\n\u001b[?2004l\rdicat\u001b[?2004h> "]
[264.581805, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[264.581849, "o", "\u001b[?2004h> "]
[264.583044, "o", "        \"answer\": \"Lopinavir and ritonavir can be administered as a once-daily or twice-daily regimen in adults. The recommended once-daily dosage is 800 mg/200 mg (10 mL of the 80 mg/20 mg per mL oral solution). Once-daily dosing is not recommended in pregnant women, pediatric patients, patients with three or more lopinavir resistance-associated substitutions, or in combination with carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir. The recommended twice-daily dosage is 400 mg/100 mg (5 mL). When administered in combination with efavirenz, nevirapine, or nelfinavir, the twice-daily dosage must be increased to 520 mg/130 mg (6.5 mL). In pregnant women, the recommended dosage is 400 mg/100 mg twice daily; once-daily dosing is not recommended and oral solution should be avoided.\",\r\n\u001b[?2004l\r"]
[264.583085, "o", "\u001b[?2004h> "]
[264.5831, "o", "        \"citations_raw\": [\r\n\u001b[?2004l\r"]
[264.583146, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[264.5832, "o", "\u001b[?2004h> "]
[264.583231, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.583332, "o", "                \"passage_id\": \"PASSAGE_0003\",\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[264.583431, "o", "                \"section\": \"2.3 Dosage Recommendations in Adults\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.583796, "o", "                \"target_text\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2. Lopinavir and ritonavir once daily dosing regimen is not recommended in:\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.583809, "o", "            },\r\n\u001b[?2004l\ri"]
[264.583843, "o", "\u001b[?2004h> "]
[264.583901, "o", "            {\r\n\u001b[?2004l\rtis or cirrhos\u001b[?2004h> "]
[264.583914, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n"]
[264.584008, "o", "\u001b[?2004l\r"]
[264.584087, "o", "\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0004\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.584117, "o", "                \"section\": \"Recommended Dosage\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.584213, "o", "                \"target_text\": \"80 mg/20 mg per mL Oral Solution 800 mg/200 mg (10 mL) once daily\"\r\n\u001b[?2004l\rtext\": \"Postmarketing cases of \u001b[?2004h> "]
[264.584356, "o", "            },\r\n\u001b[?2004l\rpro\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.584422, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r"]
[264.58456, "o", "\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0005\",\r\n\u001b[?2004l\r"]
[264.584622, "o", "\u001b[?2004h> "]
[264.584682, "o", "                \"section\": \"Recommended Dosage\",\r\n\u001b[?2004l\r"]
[264.584739, "o", "\u001b[?2004h> "]
[264.584897, "o", "                \"target_text\": \"80 mg/20 mg per mL Oral Solution 400 mg/100 mg (5 mL) twice daily\"\r\n\u001b[?2004l\r \u001b[?2004h"]
[264.584911, "o", ">             },\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.584918, "o", "> "]
[264.584989, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.585115, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\rtext\": \"Lopinavir an\u001b[?2004h> "]
[264.585159, "o", "                \"passage_id\": \"PASSAGE_0006\",\r\n\u001b[?2004l\r"]
[264.585199, "o", "\u001b[?2004h> "]
