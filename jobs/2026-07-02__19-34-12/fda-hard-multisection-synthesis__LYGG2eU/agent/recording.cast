[219.667142, "i", "cat << 'EOF' > generate_answers.py\nimport json\n\n# Load labels\nlabels = {}\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        labels[label['set_id']] = label\n\ndef verify_quote(set_id, passage_id, quote):\n    label = labels[set_id]\n    idx = int(passage_id.split('_')[1])\n    chunk = label['chunks'][idx]\n    if quote in chunk:\n        return True\n    else:\n        print(f\"QUOTE NOT FOUND in {set_id} {passage_id}!\")\n        print(f\"Quote: {repr(quote)}\")\n        print(f\"Chunk: {repr(chunk[:200])}...\")\n        return False\n\n# Let's define the answers and citations\nanswers_data = [\n    {\n        \"qid\": \"b2531657ba5c7a78\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Paxlovid contains ritonavir, a strong CYP3A inhibitor. This can lead to increased plasma concentrations of concomitant medications metabolized by CYP3A, potentially causing severe, life-threatening, or fatal events. Conversely, strong CYP3A inducers can decrease Paxlovid concentrations, which may lead to loss of therapeutic effect and possible viral resistance. Calcineurin inhibitors (such as tacrolimus and cyclosporine) and calcium channel blockers are the most commonly reported concomitant medications resulting in serious adverse reactions.\",\n        \"citations\": [\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0000\",\n                \"section\": \"BOXED WARNING\",\n                \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0013\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"supporting_quote\": \"The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0019\",\n                \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\n                \"supporting_quote\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"6f12607a1ba14dd5\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Paxlovid is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions. It is also contraindicated with strong CYP3A inducers due to the potential for loss of virologic response and resistance. These include: alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in patients with renal and/or hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (Revatio) when used for pulmonary arterial hypertension, triazolam, oral midazolam, flibanserin, tolvaptan, apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort.\",\n        \"citations\": [\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0012\",\n                \"section\": \"4 CONTRAINDICATIONS\",\n                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers where significantly reduced nirmatrelv"]
[219.667306, "i", "ir or ritonavir plasma concentrations may be associated with the potential for loss of virologic response and possible resistance.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"daef650b92e56473\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Lopinavir and ritonavir oral solution must be taken with food. For administration by feeding tube, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility with the ethanol and propylene glycol excipients. Feeding tubes made of silicone or polyvinyl chloride (PVC) are compatible and can be used. Lopinavir and ritonavir oral solution contains approximately 42% (v/v) ethanol and approximately 15% (w/v) propylene glycol.\",\n        \"citations\": [\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0001\",\n                \"section\": \"2.1 General Administration Recommendations\",\n                \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0002\",\n                \"section\": \"2.2 Administering Oral Solution by Feeding Tube\",\n                \"supporting_quote\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility. Feeding tubes that are compatible with ethanol and propylene glycol, such as silicone and polyvinyl chloride (PVC) feeding tubes, can be used for administration of lopinavir and ritonavir oral solution.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0106\",\n                \"section\": \"11 DESCRIPTION\",\n                \"supporting_quote\": \"Lopinavir and ritonavir oral solution contains approximately 42% (v/v) ethanol and approximately 15% (w/v) propylene glycol.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"a0576a26f2a2eeac\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Lopinavir and ritonavir can be administered as a once-daily or twice-daily regimen in adults. The recommended once-daily dosage is 800 mg/200 mg (10 mL of the 80 mg/20 mg per mL oral solution). Once-daily dosing is not recommended in pregnant women, pediatric patients, patients with three or more lopinavir resistance-associated substitutions, or in combination with carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, or nelfinavir. The recommended twice-daily dosage is 400 mg/100 mg (5 mL). When administered in combination with efavirenz, nevirapine, or nelfinavir, the twice-daily dosage must be increased to 520 mg/130 mg (6.5 mL). In pregnant women, the recommended dosage is 400 mg/100 mg twice daily; once-daily dosing is not recommended and oral solution should be avoided.\",\n        \"citations\": [\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0003\",\n                \"section\": \"2.3 Dosage Recommendations in Adults\",\n                \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2. Lopinavir and ritonavir once daily dosing regimen is not recommended in:\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0004\",\n                \"section\": \"Recommended Dosage\",\n                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 800 mg/200 mg (10 mL) once daily\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0005\",\n                \"section\": \"Recommended Dosage\",\n                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 400 mg/100 mg (5 mL) twice daily\"\n            },\n            {\n                \"set"]
[219.667479, "i", "_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0006\",\n                \"section\": \"Recommended Dosage\",\n                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 520 mg/130 mg (6.5 mL) twice daily\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0012\",\n                \"section\": \"2.5 Dosage Recommendations in Pregnancy\",\n                \"supporting_quote\": \"Administer 400/100 mg of lopinavir and ritonavir twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"9be5515bc3064979\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Safety risks listed for Lopinavir-Ritonavir include: serious drug interactions (leading to severe, life-threatening, or fatal events); toxicity in preterm neonates due to ethanol and propylene glycol excipients (including cardiac toxicity, lactic acidosis, renal failure, CNS depression, and respiratory complications); pancreatitis (sometimes fatal, associated with marked triglyceride elevations); hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation); QT interval prolongation and torsade de pointes; PR interval prolongation (AV block); new onset diabetes mellitus or hyperglycemia; immune reconstitution syndrome; lipid elevations (large increases in total cholesterol and triglycerides); fat redistribution; increased bleeding in patients with hemophilia; and potential for HIV-1 resistance/cross-resistance.\",\n        \"citations\": [\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0014\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"supporting_quote\": \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0015\",\n                \"section\": \"5.2 Toxicity in Preterm Neonates\",\n                \"supporting_quote\": \"Preterm neonates may be at increased risk of propylene glycol-associated adverse events due to diminished ability to metabolize propylene glycol, thereby leading to accumulation and potential adverse events.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0016\",\n                \"section\": \"5.3 Pancreatitis\",\n                \"supporting_quote\": \"Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0017\",\n                \"section\": \"5.4 Hepatotoxicity\",\n                \"supporting_quote\": \"There have been postmarketing reports of hepatic dysfunction, including some fatalities. These have generally occurred in patients with advanced HIV-1 disease taking multiple concomitant medications in the setting of underlying chronic hepatitis or cirrhosis.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0018\",\n                \"section\": \"5.5 QT Interval Prolongation\",\n                \"supporting_quote\": \"Postmarketing cases of QT interval prolongation and torsade de pointes have been reported although causality of lopinavir and ritonavir could not be established.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0019\",\n                \"section\":"]
[219.667508, "i", " \"5.6 PR Interval Prolongation\",\n                \"supporting_quote\": \"Lopinavir and ritonavir prolongs the PR interval in some patients. Cases of second or third degree atrioventricular block have been reported.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0022\",\n                \"section\": \"5.9 Lipid Elevations\",\n                \"supporting_quote\": \"Treatment with lopinavir and ritonavir has resulted in large increases in the concentration of total cholesterol and triglycerides .\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"18078efe9380c8dc\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Important warnings and precautions associated with Lopinavir-Ritonavir include: risk of serious adverse reactions due to drug interactions (strong CYP3A inhibition); toxicity in preterm neonates (due to ethanol and propylene glycol excipients, should not be used in preterm neonates in the immediate postnatal period); pancreatitis (potentially fatal, associated with marked triglyceride elevations); hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation); QT interval prolongation and torsade de pointes (avoid in congenital long QT syndrome or hypokalemia); PR interval prolongation (caution in structural heart disease or conduction system abnormalities); diabetes mellitus/hyperglycemia (new onset or exacerbation); immune reconstitution syndrome; lipid elevations (large increases in total cholesterol and triglycerides); fat redistribution; increased bleeding in patients with hemophilia; and potential for HIV-1 resistance/cross-resistance.\",\n        \"citations\": [\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0014\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"supporting_quote\": \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0015\",\n                \"section\": \"5.2 Toxicity in Preterm Neonates\",\n                \"supporting_quote\": \"Lopinavir and ritonavir oral solution should not be used in preterm neonates in the immediate postnatal period because of possible toxicities.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0016\",\n                \"section\": \"5.3 Pancreatitis\",\n                \"supporting_quote\": \"Pancreatitis should be considered if clinical symptoms (nausea, vomiting, abdominal pain) or abnormalities in laboratory values (such as increased serum lipase or amylase values) suggestive of pancreatitis occur.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0017\",\n                \"section\": \"5.4 Hepatotoxicity\",\n                \"supporting_quote\": \"Appropriate laboratory testing should be conducted prior to initiating therapy with lopinavir and ritonavir and patients should be monitored closely during treatment.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_001"]
