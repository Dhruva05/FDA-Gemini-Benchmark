[11.143563, "i", "cat << 'EOF' > explore.py\nimport json\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    questions = [json.loads(line) for line in f]\n\nprint(\"Questions:\")\nfor q in questions:\n    print(f\"QID: {q['qid']} | Drug: {q['drug_name']} | Question: {q['question']} | Fields: {q.get('required_output_fields')}\")\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        print(f\"\\nLabel Drug Name: {label.get('drug_name')} | Set ID: {label.get('set_id')}\")\n        print(f\"Keys in label: {list(label.keys())}\")\n        print(f\"Number of chunks: {len(label.get('chunks', []))}\")\n        if label.get('chunks'):\n            print(\"First chunk keys:\", list(label['chunks'][0].keys()))\n            print(\"First chunk example:\", label['chunks'][0])\nEOF\npython3 explore.py\n"]
