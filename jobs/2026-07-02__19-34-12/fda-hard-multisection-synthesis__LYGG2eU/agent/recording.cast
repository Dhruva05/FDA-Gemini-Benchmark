[219.682427, "o", "                \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2. Lopinavir and ritonavir once daily dosing regimen is not recommended in:\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.682443, "o", "            },\r\n\u001b[?2004l\rhe \u001b[?2004h> "]
