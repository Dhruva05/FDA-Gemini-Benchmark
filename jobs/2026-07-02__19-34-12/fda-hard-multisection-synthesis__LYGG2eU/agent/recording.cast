[35.791972, "i", "cat << 'EOF' > match_chunks.py\nimport json\nimport re\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        print(f\"Drug: {label['drug_name']}\")\n        raw = label['label_raw']\n        chunks = label['chunks']\n        # Let's find all PASSAGE_#### in raw\n        passages = re.findall(r'(PASSAGE_\\d+)\\|\\|\\n(.*?)(?=(?:PASSAGE_\\d+\\|\\|\\n|$))', raw, re.DOTALL)\n        print(f\"Found {len(passages)} passages in raw via regex.\")\n        print(f\"Number of chunks in label: {len(chunks)}\")\n        \n        # Check matching\n        matched = 0\n        for i, (pid, ptext) in enumerate(passages):\n            chunk_text = chunks[i] if i < len(chunks) else \"\"\n            # Normalize whitespace to compare\n            p_norm = \" \".join(ptext.strip().split())\n            c_norm = \" \".join(chunk_text.strip().split())\n            if p_norm == c_norm:\n                matched += 1\n            else:\n                if i < 3:\n                    print(f\"Mismatch at index {i}:\")\n                    print(f\"Raw passage text (first 100): {repr(p_norm[:100])}\")\n                    print(f\"Chunk text (first 100):       {repr(c_norm[:100])}\")\n        print(f\"Matched: {matched}/{len(passages)}\")\n        print(\"-\"*40)\nEOF\npython3 match_chunks.py\n"]
