[63.188771, "i", "cat << 'EOF' > parse_passages_v2.py\nimport json\nimport re\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        print(label['drug_name'])\n        raw = label['label_raw']\n        # Let's find all occurrences of (?:\\|\\|)?PASSAGE_####||\n        matches = list(re.finditer(r'\\|\\|PASSAGE_(\\d+)\\|\\|\\n', raw))\n        # Wait, the first passage might not have || before it if it starts the string. Let's see if the first one has ||.\n        if not matches or matches[0].start() > 10:\n            # Try without || for the very first one if needed, or check if PASSAGE_0000 has ||\n            # Let's look at the start of raw\n            print(\"Start of raw:\", repr(raw[:100]))\n        \n        # Let's find all PASSAGE_#### and extract\n        matches = list(re.finditer(r'(?:\\|\\|)?PASSAGE_(\\d+)\\|\\|\\n', raw))\n        passages = {}\n        for i in range(len(matches)):\n            start = matches[i].end()\n            end = matches[i+1].start() if i+1 < len(matches) else len(raw)\n            pid = f\"PASSAGE_{int(matches[i].group(1)):04d}\"\n            ptext = raw[start:end].rstrip('\\n\\r| ')\n            passages[pid] = ptext\n        \n        chunks = label['chunks']\n        print(f\"Chunks count: {len(chunks)}, Passages count: {len(passages)}\")\n        \n        matched = 0\n        for idx, chunk in enumerate(chunks):\n            pid = f\"PASSAGE_{idx:04d}\"\n            if pid in passages:\n                ptext = passages[pid]\n                if ptext.strip() == chunk.strip():\n                    matched += 1\n                else:\n                    if matched < 2:\n                        print(f\"Mismatch for {pid}:\")\n                        print(f\"ptext (repr): {repr(ptext[-100:])}\")\n                        print(f\"chunk (repr): {repr(chunk[-100:])}\")\n            else:\n                print(f\"{pid} not in parsed passages!\")\n        print(f\"Matched: {matched}/{len(chunks)}\")\n        print(\"-\"*40)\nEOF\npython3 parse_passages_v2.py\n"]
