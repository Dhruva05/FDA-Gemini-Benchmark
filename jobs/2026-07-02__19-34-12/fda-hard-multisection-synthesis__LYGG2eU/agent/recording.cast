[40.729644, "i", "cat << 'EOF' > diff_check.py\nimport json\nimport re\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        raw = label['label_raw']\n        chunks = label['chunks']\n        passages = re.findall(r'(PASSAGE_\\d+)\\?\\?\\n|PASSAGE_(\\d+)\\|\\|\\n(.*?)(?=(?:PASSAGE_\\d+\\|\\|\\n|$))', raw, re.DOTALL)\n        # Wait, the regex might be slightly different. Let's do a simpler regex.\n        passages = re.findall(r'(PASSAGE_\\d+)\\|\\|\\n(.*?)(?=(?:PASSAGE_\\d+\\|\\|\\n|$))', raw, re.DOTALL)\n        pid, ptext = passages[0]\n        ctext = chunks[0]\n        print(f\"ptext len: {len(ptext)}, ctext len: {len(ctext)}\")\n        print(f\"ptext representation: {repr(ptext[:200])}\")\n        print(f\"ctext representation: {repr(ctext[:200])}\")\n        break\nEOF\npython3 diff_check.py\n"]
