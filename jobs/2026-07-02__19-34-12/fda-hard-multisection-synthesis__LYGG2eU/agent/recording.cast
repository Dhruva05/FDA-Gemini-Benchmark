[30.02411, "i", "cat << 'EOF' > find_passage_raw.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        print(label['drug_name'])\n        raw_str = json.dumps(label)\n        idx = 0\n        while True:\n            idx = raw_str.find('PASSAGE', idx)\n            if idx == -1:\n                break\n            print(f\"Found 'PASSAGE' at index {idx}: {raw_str[idx:idx+50]}\")\n            idx += 1\n        break\nEOF\npython3 find_passage_raw.py\n"]
