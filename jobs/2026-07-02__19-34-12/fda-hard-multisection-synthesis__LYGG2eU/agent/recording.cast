[264.570934, "o", "# Define raw answers data\r\n\u001b[?2004l\r"]
[264.571025, "o", "\u001b[?2004h> answers_raw = [\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.571086, "o", ">         \"qid\": \"b2531657ba5c7a78\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.571104, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.571902, "o", "        \"answer\": \"Paxlovid contains ritonavir, a strong CYP3A inhibitor. This can lead to increased plasma concentrations of concomitant medications metabolized by CYP3A, potentially causing severe, life-threatening, or fatal events. Conversely, strong CYP3A inducers can decrease Paxlovid concentrations, which may lead to loss of therapeutic effect and possible viral resistance. Calcineurin inhibitors (such as tacrolimus and cyclosporine) and calcium channel blockers are the most commonly reported concomitant medications resulting in serious adverse reactions.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.571957, "o", "        \"citations_raw\": [\r\n\u001b[?2004l\raus\u001b[?2004h> "]
[264.571983, "o", "            {\r\n\u001b[?2004l\r"]
[264.572046, "o", "\u001b[?2004h> "]
[264.572159, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.572269, "o", "                \"passage_id\": \"PASSAGE_0000\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.572371, "o", "                \"section\": \"BOXED WARNING\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.572766, "o", "                \"target_text\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\r"]
[264.572907, "o", "\u001b[?2004h>             },\r\n\u001b[?2004l\r {\r\n   \u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[264.572931, "o", "\u001b[?2004h> "]
[264.573092, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[264.573175, "o", "                \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[264.573358, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.573722, "o", "                \"target_text\": \"The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.573741, "o", "            },\r\n\u001b[?2004l\r"]
[264.573849, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\rnswer\": \"Lopin"]
[264.57391, "o", "\u001b[?2004h> "]
[264.573979, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.57403, "o", "                \"passage_id\": \"PASSAGE_0019\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.574229, "o", "                \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.574465, "o", "                \"target_text\": \"PAXLOVID (nirmatrelvir co-packaged with ritonavir) is a strong inhibitor of CYP3A\"\r\n\u001b[?2004l\rvir res"]
[264.574521, "o", "\u001b[?2004h> "]
[264.574654, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.574739, "o", "        ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.574819, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n"]
[264.574903, "o", "\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.574991, "o", "        \"qid\": \"6f12607a1ba14dd5\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.575061, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.576692, "o", "        \"answer\": \"Paxlovid is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions. It is also contraindicated with strong CYP3A inducers due to the potential for loss of virologic response and resistance. These include: alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine (in patients with renal and/or hepatic impairment), lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (Revatio) when used for pulmonary arterial hypertension, triazolam, oral midazolam, flibanserin, tolvaptan, apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.576805, "o", "        \"citations_raw\": [\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.576823, "o", ">             {\r\n\u001b[?2004l\r"]
[264.576934, "o", "sage\",\r\n       \u001b[?2004h> "]
[264.577006, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r"]
[264.577099, "o", "\u001b[?2004h> "]
[264.577134, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.577202, "o", "                \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.57788, "o", "                \"target_text\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers where significantly reduced nirmatrelvir or ritonavir plasma concentrations may be associated with the potential for loss of virologic response and possible resistance.\"\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r   \"target_tex\u001b[?2004h"]
[264.577915, "o", "> "]
