[56.852948, "i", "cat << 'EOF' > print_around.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        raw = label['label_raw']\n        idx = raw.find('PASSAGE_0001')\n        print(repr(raw[idx-50:idx+150]))\n        break\nEOF\npython3 print_around.py\n"]
