[18.027449, "i", "cat << 'EOF' > explore.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        print(f\"\\nLabel Drug Name: {label.get('drug_name')} | Set ID: {label.get('set_id')}\")\n        chunks = label.get('chunks', [])\n        for i in range(min(5, len(chunks))):\n            print(f\"Chunk {i}:\")\n            print(chunks[i])\n            print(\"-\"*40)\n        break\nEOF\npython3 explore.py\n"]
