[264.682606, "o", "                \"section\": \"5.4 Risk of HIV-1 Resistance Development\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.682738, "o", "                \"target_text\": \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.682754, "o", "            },\r\n\u001b[?2004l\r"]
[264.68283, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[264.682846, "o", "\u001b[?2004h> "]
[264.682891, "o", "                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.682949, "o", "                \"passage_id\": \"PASSAGE_0018\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.68297, "o", "                \"section\": \"6.1 Clinical Trials Experience\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.683201, "o", "                \"target_text\": \"The most common adverse reactions (\\u22651% incidence in the PAXLOVID group and occurring at a greater frequency than in the placebo group) were dysgeusia (5% and <1%, respectively) and diarrhea (3% and 2%, respectively).\"\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.683265, "o", "        ],\r\n\u001b[?2004l\r\u001b[?2004h>         \"structured_fields\": {}\r\n\u001b[?2004l\r"]
[264.68334, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.683427, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> answers_final = []\r\n\u001b[?2004l\r\u001b[?2004h> for ans in answers_raw:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.683481, "o", "    citations = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.683542, "o", "    for cit in ans['citations_raw']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.683614, "o", "        exact_quote = verify_and_get_quote(cit['set_id'], cit['passage_id'], cit['target_text'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.683673, "o", "        citations.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"set_id\": cit['set_id'],\r\n\u001b[?2004l\r"]
[264.683719, "o", "\u001b[?2004h> "]
[264.683743, "o", "            \"passage_id\": cit['passage_id'],\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.683832, "o", ">             \"section\": cit['section'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.683904, "o", "            \"supporting_quote\": exact_quote\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.683963, "o", "    answers_final.append({\r\n\u001b[?2004l\r\u001b[?2004h>         \"qid\": ans['qid'],\r\n\u001b[?2004l\r"]
[264.683983, "o", "\u001b[?2004h> "]
[264.684039, "o", "        \"status\": ans['status'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.684119, "o", "        \"answer\": ans['answer'],\r\n\u001b[?2004l\r\u001b[?2004h>         \"citations\": citations,\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.684179, "o", "> "]
[264.684243, "o", "        \"structured_fields\": ans['structured_fields']\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[264.684277, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> output = {\"answers\": answers_final}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.684348, "o", "with open('/workspace/answers.json', 'w') as f:\r\n\u001b[?2004l\r"]
[264.684405, "o", "\u001b[?2004h> "]
