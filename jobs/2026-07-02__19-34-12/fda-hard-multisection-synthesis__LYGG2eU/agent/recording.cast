[14.381394, "i", "cat << 'EOF' > explore.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        print(f\"\\nLabel Drug Name: {label.get('drug_name')} | Set ID: {label.get('set_id')}\")\n        chunks = label.get('chunks', [])\n        print(f\"Type of chunks: {type(chunks)}\")\n        if chunks:\n            print(f\"Type of first chunk: {type(chunks[0])}\")\n            print(f\"First chunk representation (first 200 chars): {repr(chunks[0][:200])}\")\n        break\nEOF\npython3 explore.py\n"]
