[44.692679, "i", "cat << 'EOF' > diff_check_2.py\nimport json\nimport re\nimport difflib\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        raw = label['label_raw']\n        chunks = label['chunks']\n        passages = re.findall(r'(PASSAGE_\\d+)\\|\\|\\n(.*?)(?=(?:PASSAGE_\\d+\\|\\|\\n|$))', raw, re.DOTALL)\n        pid, ptext = passages[0]\n        ctext = chunks[0]\n        diff = list(difflib.ndiff(ptext, ctext))\n        # Print non-matching parts\n        for i, d in enumerate(diff):\n            if not d.startswith(' '):\n                print(f\"{i}: {repr(d)}\")\n        break\nEOF\npython3 diff_check_2.py\n"]
