[264.566769, "o", "\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\rmide, enzalutamide,\u001b[?2004h"]
[264.56687, "o", ">         label = json.loads(line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.56696, "o", "> "]
[264.567195, "o", "        labels[label['set_id']] = label\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[264.567317, "o", "def get_exact_substring(chunk, target_text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.567444, "o", "    # Normalize whitespaces to a single space, including non-breaking spaces\r\n\u001b[?2004l\r"]
[264.567466, "o", "\u001b[?2004h> "]
[264.567619, "o", "    def normalize(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.567917, "o", "        text = re.sub(r'\\s+', ' ', text)\r\n\u001b[?2004l\r\u001b[?2004h>         return text.strip().lower()\r\n\u001b[?2004l\r"]
[264.568039, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.56827, "o", "    norm_chunk = normalize(chunk)\r\n\u001b[?2004l\r\u001b[?2004h>     norm_target = normalize(target_text)\r\n\u001b[?2004l\r        \"target_text\": \"PAXLOVID is contraindi\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[264.568405, "o", "> "]
[264.568549, "o", "    if norm_target not in norm_chunk:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.56861, "o", "        print(f\"Target NOT found in normalized chunk!\")"]
[264.568691, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.568762, "o", "        print(f\"Norm Target: {repr(norm_target)}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.568954, "o", "        print(f\"Norm Chunk:  {repr(norm_chunk[:200])}...\")\r\n\u001b[?2004l\r"]
[264.568973, "o", "\u001b[?2004h>         return None\r\n\u001b[?2004l\r"]
[264.569059, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.569165, "o", "    words = target_text.split()\r\n\u001b[?2004l\rcent\u001b[?2004h> "]
[264.569276, "o", "    escaped_words = [re.escape(w) for w in words]\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.569305, "o", "> "]
[264.569427, "o", "    pattern = r'\\s+'.join(escaped_words)\r\n\u001b[?2004l\re\u001b[?2004h> "]
[264.56948, "o", "    \r\n\u001b[?2004l\rsista\u001b[?2004h> "]
[264.569563, "o", "    match = re.search(pattern, chunk, re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.569675, "o", "    if match:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.569727, "o", "        return match.group(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.569806, "o", "    return None\r\n\u001b[?2004l\r\r\n  \u001b[?2004h> \r\n\u001b[?2004l\r"]
[264.569866, "o", "\u001b[?2004h> "]
[264.570044, "o", "def verify_and_get_quote(set_id, passage_id, target_text):\r\n\u001b[?2004l\r\u001b[?2004h>     label = labels[set_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.570108, "o", "    idx = int(passage_id.split('_')[1])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.570184, "o", "    chunk = label['chunks'][idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.570395, "o", "    exact_quote = get_exact_substring(chunk, target_text)\r\n\u001b[?2004l\r"]
[264.570451, "o", "\u001b[?2004h>     if exact_quote:\r\n\u001b[?2004l\rential incompatibili\u001b[?2004h"]
[264.570501, "o", "> "]
[264.570527, "o", "        return exact_quote\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.57066, "o", "    else:\r\n"]
[264.57073, "o", "\u001b[?2004l\r\u001b[?2004h> "]
