[108.84802, "i", "cat << 'EOF' > list_paxlovid_warnings.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        if label['set_id'] == '8a99d6d6-fd9e-45bb-b1bf-48c7f761232a':\n            for idx, chunk in enumerate(label['chunks']):\n                first_line = chunk.strip().split('\\n')[0]\n                if first_line.startswith('5 ') or first_line.startswith('5.'):\n                    print(f\"PASSAGE_{idx:04d}: {first_line}\")\nEOF\npython3 list_paxlovid_warnings.py\n"]
