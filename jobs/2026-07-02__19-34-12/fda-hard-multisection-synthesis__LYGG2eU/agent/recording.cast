[264.585349, "o", "> "]
[264.585518, "o", "                \"target_text\": \"80 mg/20 mg per mL Oral Solution 520 mg/130 mg (6.5 mL) twice daily\"\r\n\u001b[?2004l\r"]
[264.585534, "o", "\u001b[?2004h>             },\r\n\u001b[?2004l\r4-"]
[264.585573, "o", "\u001b[?2004h"]
[264.585602, "o", ">             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.585756, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r"]
[264.585851, "o", "\u001b[?2004h> "]
[264.585999, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.586187, "o", "                \"section\": \"2.5 Dosage Recommendations in Pregnancy\",\r\n\u001b[?2004l\r"]
[264.586237, "o", "\u001b[?2004h> "]
[264.586568, "o", "                \"target_text\": \"Administer 400/100 mg of lopinavir and ritonavir twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions.\"\r\n\u001b[?2004l\r"]
[264.586583, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r "]
[264.586629, "o", "\u001b[?2004h>         ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.586729, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.586789, "o", "    },\r\n\u001b[?2004l\rnt\u001b[?2004h"]
[264.586833, "o", ">     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.586926, "o", "        \"qid\": \"9be5515bc3064979\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.587008, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.587023, "o", "> "]
[264.588232, "o", "        \"answer\": \"Safety risks listed for Lopinavir-Ritonavir include: serious drug interactions (leading to severe, life-threatening, or fatal events); toxicity in preterm neonates due to ethanol and propylene glycol excipients (including cardiac toxicity, lactic acidosis, renal failure, CNS depression, and respiratory complications); pancreatitis (sometimes fatal, associated with marked triglyceride elevations); hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation); QT interval prolongation and torsade de pointes; PR interval prolongation (AV block); new onset diabetes mellitus or hyperglycemia; immune reconstitution syndrome; lipid elevations (large increases in total cholesterol and triglycerides); fat redistribution; increased bleeding in patients with hemophilia; and potential for HIV-1 resistance/cross-resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.588266, "o", "        \"citations_raw\": [\r\n\u001b[?2004l\rstan"]
[264.588283, "o", "\u001b[?2004h> "]
[264.58836, "o", "            {\r\n\u001b[?2004l\r \u001b[?2004h> "]
[264.588505, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r4b1cae\u001b[?2004h> "]
[264.588629, "o", "                \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r \u001b[?2004h> "]
[264.588793, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.589195, "o", "                \"target_text\": \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.589214, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.589297, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.589387, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.589507, "o", "                \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.589611, "o", "                \"section\": \"5.2 Toxicity in Preterm Neonates\",\r\n\u001b[?2004l\r5.\u001b[?2004h> "]
[264.589985, "o", "                \"target_text\": \"Preterm neonates may be at increased risk of propylene glycol-associated adverse events due to diminished ability to metabolize propylene glycol, thereby leading to accumulation and potential adverse events.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.590008, "o", "            },\r\n\u001b[?2004l\r\"s\u001b[?2004h"]
[264.590119, "o", ">             {\r\n\u001b[?2004l\r"]
[264.59018, "o", "\u001b[?2004h> "]
[264.590258, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.590354, "o", "                \"passage_id\": \"PASSAGE_0016\",\r\n\u001b[?2004l\r"]
[264.590374, "o", "\u001b[?2004h> "]
[264.590462, "o", "                \"section\": \"5.3 Pancreatitis\",\r\n\u001b[?2004l\r \""]
[264.590476, "o", "\u001b[?2004h> "]
[264.590639, "o", "                \"target_text\": \"Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.590682, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.590747, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.590835, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0017\",\r\n\u001b[?2004l\r"]
[264.590887, "o", "\u001b[?2004h>                 \"section\": \"5.4 Hepatotoxicity\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591116, "o", "                \"target_text\": \"There have been postmarketing reports of hepatic dysfunction, including some fatalities. These have generally occurred in patients with advanced HIV-1 disease taking multiple concomitant medications in the setting of underlying chronic hepatitis or cirrhosis.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591133, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591148, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591226, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591321, "o", "                \"passage_id\": \"PASSAGE_0018\",\r\n\u001b[?2004l\r"]
[264.591369, "o", "\u001b[?2004h> "]
[264.591441, "o", "                \"section\": \"5.5 QT Interval Prolongation\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591577, "o", "                \"target_text\": \"Postmarketing cases of QT interval prolongation and torsade de pointes have been reported although causality of lopinavir and ritonavir could not be established.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591601, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[264.591623, "o", "\u001b[?2004h> "]
[264.591716, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.59177, "o", "                \"passage_id\": \"PASSAGE_0019\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591853, "o", "                \"section\": \"5.6 PR Interval Prolongation\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.591993, "o", "                \"target_text\": \"Lopinavir and ritonavir prolongs the PR interval in some patients. Cases of second or third degree atrioventricular block have been reported.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.592009, "o", "> "]
[264.592052, "o", "            {\r\n\u001b[?2004l\r"]
[264.592099, "o", "\u001b[?2004h> "]
[264.592138, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.59216, "o", "                \"passage_id\": \"PASSAGE_0022\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.592229, "o", "                \"section\": \"5.9 Lipid Elevations\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.592366, "o", "                \"target_text\": \"Treatment with lopinavir and ritonavir has resulted in large increases in the concentration of total cholesterol and triglycerides .\"\r\n\u001b[?2004l\r\u001b[?2004h>             }"]
[264.59238, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.592424, "o", ">         ],\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.592545, "o", ">         \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.592627, "o", "        \"qid\": \"18078efe9380c8dc\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[264.592681, "o", "\u001b[?2004h> "]
[264.593379, "o", "        \"answer\": \"Important warnings and precautions associated with Lopinavir-Ritonavir include: risk of serious adverse reactions due to drug interactions (strong CYP3A inhibition); toxicity in preterm neonates (due to ethanol and propylene glycol excipients, should not be used in preterm neonates in the immediate postnatal period); pancreatitis (potentially fatal, associated with marked triglyceride elevations); hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation); QT interval prolongation and torsade de pointes (avoid in congenital long QT syndrome or hypokalemia); PR interval prolongation (caution in structural heart disease or conduction system abnormalities); diabetes mellitus/hyperglycemia (new onset or exacerbation); immune reconstitution syndrome; lipid elevations (large increases in total cholesterol and triglycerides); fat redistribution; increased bleeding in patients with hemophilia; and potential for HIV-1 resistance/cross-resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.593466, "o", "        \"citations_raw\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.593508, "o", "> "]
[264.593575, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r"]
[264.593598, "o", "\u001b[?2004h> "]
[264.593701, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.593972, "o", "                \"target_text\": \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594028, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594041, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594108, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594163, "o", "                \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594227, "o", "                \"section\": \"5.2 Toxicity in Preterm Neonates\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594367, "o", "                \"target_text\": \"Lopinavir and ritonavir oral solution should not be used in preterm neonates in the immediate postnatal period because of possible toxicities.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594424, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[264.594433, "o", "\u001b[?2004h> "]
[264.594515, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594571, "o", "                \"passage_id\": \"PASSAGE_0016\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594635, "o", "                \"section\": \"5.3 Pancreatitis\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.594707, "o", "                \"target_text\": \"Pancreatitis should be consi"]
[264.670118, "i", "dered if clinical symptoms (nausea, vomiting, abdominal pain) or abnormalities in laboratory values (such as increased serum lipase or amylase values) suggestive of pancreatitis occur.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0017\",\n                \"section\": \"5.4 Hepatotoxicity\",\n                \"target_text\": \"Appropriate laboratory testing should be conducted prior to initiating therapy with lopinavir and ritonavir and patients should be monitored closely during treatment.\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0018\",\n                \"section\": \"5.5 QT Interval Prolongation\",\n                \"target_text\": \"Avoid use in patients with congenital long QT syndrome, those with hypokalemia, and with other drugs that prolong the QT interval .\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0019\",\n                \"section\": \"5.6 PR Interval Prolongation\",\n                \"target_text\": \"Lopinavir and ritonavir should be used with caution in patients with underlying structural heart disease, pre-existing conduction system abnormalities, ischemic heart disease or cardiomyopathies\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0022\",\n                \"section\": \"5.9 Lipid Elevations\",\n                \"target_text\": \"Triglyceride and cholesterol testing should be performed prior to initiating lopinavir and ritonavir therapy and at periodic intervals during therapy.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"fbab4114f66e2dda\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Important warnings and precautions associated with Paxlovid are: risk of serious, life-threatening, or fatal adverse reactions due to drug interactions (strong CYP3A inhibition by ritonavir, or loss of therapeutic effect and possible resistance due to CYP3A induction); hypersensitivity reactions (including anaphylaxis, toxic epidermal necrolysis, Stevens-Johnson syndrome; discontinue immediately if signs occur); hepatotoxicity (hepatic transaminase elevations, clinical hepatitis, jaundice; caution in pre-existing liver disease or liver enzyme abnormalities); and risk of HIV-1 resistance development in individuals with uncontrolled or undiagnosed HIV-1 infection.\",\n        \"citations_raw\": [\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0000\",\n                \"section\": \"BOXED WARNING\",\n                \"target_text\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0013\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"target_text\": \"Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations of medications metabolized by CYP3A.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0014\",\n                \"section\": \"5.2 Hypersensitivity Reactions\",\n                \"target_text\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PA"]
[264.670219, "i", "SSAGE_0015\",\n                \"section\": \"5.3 Hepatotoxicity\",\n                \"target_text\": \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0016\",\n                \"section\": \"5.4 Risk of HIV-1 Resistance Development\",\n                \"target_text\": \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"2d63e0a82215867f\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"The safety risks listed for Paxlovid include: serious, life-threatening, or fatal adverse reactions due to drug interactions; hypersensitivity reactions (including anaphylaxis, toxic epidermal necrolysis, Stevens-Johnson syndrome, and malaise); hepatotoxicity (hepatic transaminase elevations, clinical hepatitis, jaundice); risk of HIV-1 resistance development in individuals with uncontrolled or undiagnosed HIV-1 infection; and common adverse reactions from clinical trials (incidence >=1% and greater than placebo) which are dysgeusia (5% vs <1% placebo) and diarrhea (3% vs 2% placebo). Other adverse reactions identified under Emergency Use Authorization include headache, hypertension, abdominal pain, nausea, vomiting, and malaise.\",\n        \"citations_raw\": [\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0013\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"target_text\": \"Severe, life-threatening, and/or fatal adverse reactions due to drug interactions have been reported in patients treated with PAXLOVID.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0014\",\n                \"section\": \"5.2 Hypersensitivity Reactions\",\n                \"target_text\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0015\",\n                \"section\": \"5.3 Hepatotoxicity\",\n                \"target_text\": \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0016\",\n                \"section\": \"5.4 Risk of HIV-1 Resistance Development\",\n                \"target_text\": \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0018\",\n                \"section\": \"6.1 Clinical Trials Experience\",\n                \"target_text\": \"The most common adverse reactions (\\u22651% incidence in the PAXLOVID group and occurring at a greater frequency than in the placebo group) were dysgeusia (5% and <1%, respectively) and diarrhea (3% and 2%, respectively).\"\n            }\n        ],\n        \"structured_fields\": {}\n    }\n]\n\nanswers_final = []\nfor ans in answers_raw:\n    citations = []\n    for cit in ans['citations_raw']:\n        exact_quote = verify_and_get_quote(cit['set_id'], cit['passage_id'], cit['target_text'])\n        citations.append({\n            \"set_id\": cit['set_id'],\n            \"passage_id\": cit['passage_id'],\n            \"section\": cit['section'],\n            \"supporting_quote\": exact_quote\n        })\n    answers_fina"]
