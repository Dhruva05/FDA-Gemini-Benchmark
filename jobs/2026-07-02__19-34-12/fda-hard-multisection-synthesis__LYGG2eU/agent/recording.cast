[233.450043, "i", "cat << 'EOF' > test_normalize.py\nimport re\n\ndef get_exact_substring(chunk, target_text):\n    # Normalize whitespaces to a single space, including non-breaking spaces\n    def normalize(text):\n        # replace non-breaking spaces and any other whitespace with standard space\n        text = re.sub(r'\\s+', ' ', text)\n        return text.strip().lower()\n    \n    norm_chunk = normalize(chunk)\n    norm_target = normalize(target_text)\n    \n    if norm_target not in norm_chunk:\n        print(f\"Target NOT found in normalized chunk!\")\n        print(f\"Norm Target: {repr(norm_target)}\")\n        print(f\"Norm Chunk:  {repr(norm_chunk[:200])}\")\n        return None\n    \n    # Let's find the match by building a regex pattern from target_text\n    # We split target_text by any whitespace and join with \\s+\n    words = target_text.split()\n    escaped_words = [re.escape(w) for w in words]\n    pattern = r'\\s+'.join(escaped_words)\n    \n    match = re.search(pattern, chunk, re.IGNORECASE)\n    if match:\n        return match.group(0)\n    return None\n\nchunk = \"Treatment with lopinavir\\xa0and ritonavir has resulted in large increases\"\ntarget = \"Treatment with lopinavir and ritonavir has resulted\"\nprint(repr(get_exact_substring(chunk, target)))\nEOF\npython3 test_normalize.py\n"]
