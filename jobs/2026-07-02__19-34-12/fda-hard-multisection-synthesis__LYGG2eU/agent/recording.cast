[77.616057, "i", "cat << 'EOF' > list_headings.py\nimport json\nimport re\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        print(\"=\"*60)\n        print(f\"Drug: {label['drug_name']} | Set ID: {label['set_id']}\")\n        print(\"=\"*60)\n        for idx, chunk in enumerate(label['chunks']):\n            # If chunk starts with a number or section-like title\n            lines = chunk.strip().split('\\n')\n            first_line = lines[0] if lines else \"\"\n            if re.match(r'^[0-9]+(\\.[0-9]+)?\\s+[A-Z]', first_line) or re.match(r'^[A-Z\\s]{5,25}$', first_line):\n                print(f\"PASSAGE_{idx:04d}: {first_line[:80]}\")\nEOF\npython3 list_headings.py\n"]
[77.616303, "o", "cat << 'EOF' > list_headings.py\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n"]
