[84.609248, "i", "cat << 'EOF' > search_labels.py\nimport json\nimport sys\n\ndef search(set_id, keywords):\n    with open('/workspace/data/public/labels.jsonl') as f:\n        for line in f:\n            label = json.loads(line)\n            if label['set_id'] != set_id:\n                continue\n            print(f\"=== Searching in {label['drug_name']} ({set_id}) for {keywords} ===\")\n            for idx, chunk in enumerate(label['chunks']):\n                # Check if all keywords are in the chunk (case-insensitive)\n                if all(kw.lower() in chunk.lower() for kw in keywords):\n                    first_line = chunk.strip().split('\\n')[0]\n                    print(f\"PASSAGE_{idx:04d} (Heading: {first_line[:50]}):\")\n                    # Print lines matching keywords\n                    for line in chunk.split('\\n'):\n                        if any(kw.lower() in line.lower() for kw in keywords):\n                            print(f\"  {line[:120]}\")\n                    print(\"-\"*40)\n\nif len(sys.argv) > 2:\n    search(sys.argv[1], sys.argv[2:])\nEOF\n"]
[84.609533, "o", "cat << 'EOF' > search_labels.py\r\n\u001b[?2004l\r"]
