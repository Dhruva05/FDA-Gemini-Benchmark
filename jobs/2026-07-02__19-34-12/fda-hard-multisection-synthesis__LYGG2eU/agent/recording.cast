[219.683045, "o", "                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 800 mg/200 mg (10 mL) once daily\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.68311, "o", "            },\r\n\u001b[?2004l\r \"Po\u001b[?2004h> "]
[219.683163, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.683297, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.683317, "o", "> "]
[219.683405, "o", "                \"passage_id\": \"PASSAGE_0005\",\r\n\u001b[?2004l\r"]
[219.683426, "o", "\u001b[?2004h> "]
[219.683505, "o", "                \"section\": \"Recommended Dosage\",\r\n\u001b[?2004l\r },\u001b[?2004h> "]
[219.683662, "o", "                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 400 mg/100 mg (5 mL) twice daily\"\r\n\u001b[?2004l\r"]
[219.68368, "o", "\u001b[?2004h>             },\r\n\u001b[?2004l\rE"]
[219.683726, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.683875, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.683945, "o", "                \"passage_id\": \"PASSAGE_0006\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.684009, "o", "                \"section\": \"Recommended Dosage\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.684174, "o", "                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 520 mg/130 mg (6.5 mL) twice daily\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.684212, "o", "            },\r\n\u001b[?2004l\r\"set\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.68422, "o", "> "]
[219.684372, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.684426, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.684549, "o", "                \"section\": \"2.5 Dosage Recommendations in Pregnancy\",\r\n\u001b[?2004l\rment with l\u001b[?2004h> "]
[219.684824, "o", "                \"supporting_quote\": \"Administer 400/100 mg of lopinavir and ritonavir twice daily in pregnant patients with no documented lopinavir-associated resistance substitutions.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.684848, "o", "            }\r\n\u001b[?2004l\r"]
[219.684925, "o", "\u001b[?2004h> "]
[219.684988, "o", "        ],\r\n\u001b[?2004l\ref\u001b[?2004h> "]
[219.685007, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.685054, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.685139, "o", ">         \"qid\": \"9be5515bc3064979\",\r\n\u001b[?2004l\r     \"answer\": \"Important warnings \u001b[?2004h> "]
[219.685223, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[219.685284, "o", "\u001b[?2004h> "]
[219.686334, "o", "        \"answer\": \"Safety risks listed for Lopinavir-Ritonavir include: serious drug interactions (leading to severe, life-threatening, or fatal events); toxicity in preterm neonates due to ethanol and propylene glycol excipients (including cardiac toxicity, lactic acidosis, renal failure, CNS depression, and respiratory complications); pancreatitis (sometimes fatal, associated with marked triglyceride elevations); hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation); QT interval prolongation and torsade de pointes; PR interval prolongation (AV block); new onset diabetes mellitus or hyperglycemia; immune reconstitution syndrome; lipid elevations (large increases in total cholesterol and triglycerides); fat redistribution; increased bleeding in patients with hemophilia; and potential for HIV-1 resistance/cross-resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.686398, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.686481, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.686581, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.68664, "o", "                \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.686916, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.687375, "o", "                \"supporting_quote\": \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r"]
[219.687436, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.68759, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\r\n  \u001b[?2004h> "]
[219.687726, "o", "                \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.687873, "o", "                \"section\": \"5.2 Toxicity in Preterm Neonates\",\r\n\u001b[?2004l\r\": \"PASSAGE_0015\",\u001b[?2004h> "]
[219.688157, "o", "                \"supporting_quote\": \"Preterm neonates may be at increased risk of propylene glycol-associated adverse events due to diminished ability to metabolize propylene glycol, thereby leading to accumulation and potential adverse events.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.688234, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.688296, "o", ">             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.688345, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.688443, "o", "                \"passage_id\": \"PASSAGE_0016\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.688501, "o", "                \"section\": \"5.3 Pancreatitis\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.68876, "o", "                \"supporting_quote\": \"Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.688791, "o", "            },\r\n\u001b[?2004l\r"]
[219.688805, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[219.688916, "o", "\u001b[?2004h"]
[219.688963, "o", "> "]
[219.689025, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0017\",\r\n\u001b[?2004l\r3-91\u001b[?2004h> "]
[219.68915, "o", "                \"section\": \"5.4 Hepatotoxicity\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.689603, "o", "                \"supporting_quote\": \"There have been postmarketing reports of hepatic dysfunction, including some fatalities. These have generally occurred in patients with advanced HIV-1 disease taking multiple concomitant medications in the setting of underlying chronic hepatitis or cirrhosis.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.689623, "o", "> "]
[219.689674, "o", "            },\r\n\u001b[?2004l\r"]
[219.689714, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r \"set_id\": \"4b"]
[219.689737, "o", "\u001b[?2004h> "]
[219.68982, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.689897, "o", "                \"passage_id\": \"PASSAGE_0018\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.689971, "o", "                \"section\": \"5.5 QT Interval Prolongation\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.690124, "o", "                \"supporting_quote\": \"Postmarketing cases of QT interval prolongation and torsade de pointes have been reported although causality of lopinavir and ritonavir could not be established.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.690239, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.690312, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0019\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.690331, "o", "                \"section\": \"5.6 PR Interval Prolongation\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.690485, "o", "                \"supporting_quote\": \"Lopinavir and ritonavir prolongs the PR interval in some patients. Cases of second or third degree atrioventricular block have been reported.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r"]
[219.690501, "o", "\u001b[?2004h> "]
[219.690554, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.690624, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.690639, "o", "                \"passage_id\": \"PASSAGE_0022\",\r\n"]
[219.690678, "o", "\u001b[?2004l\r\u001b[?2004h"]
[219.69075, "o", "> "]
[219.690791, "o", "                \"section\": \"5.9 Lipid Elevations\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.690983, "o", "                \"supporting_quote\": \"Treatment with lopinavir and ritonavir has resulted in large increases in the concentration of total cholesterol and triglycerides .\"\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.691005, "o", ">         ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.691065, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[219.691124, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.691181, "o", ">         \"qid\": \"18078efe9380c8dc\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.691207, "o", ">         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.691945, "o", "        \"answer\": \"Important warnings and precautions associated with Lopinavir-Ritonavir include: risk of serious adverse reactions due to drug interactions (strong CYP3A inhibition); toxicity in preterm neonates (due to ethanol and propylene glycol excipients, should not be used in preterm neonates in the immediate postnatal period); pancreatitis (potentially fatal, associated with marked triglyceride elevations); hepatotoxicity (hepatic dysfunction, elevated transaminases, hepatic decompensation); QT interval prolongation and torsade de pointes (avoid in congenital long QT syndrome or hypokalemia); PR interval prolongation (caution in structural heart disease or conduction system abnormalities); diabetes mellitus/hyperglycemia (new onset or exacerbation); immune reconstitution syndrome; lipid elevations (large increases in total cholesterol and triglycerides); fat redistribution; increased bleeding in patients with hemophilia; and potential for HIV-1 resistance/cross-resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.69196, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.691967, "o", "            {\r\n\u001b[?2004l\r"]
[219.692026, "o", "\u001b[?2004h> "]
[219.692075, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.692181, "o", "                \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.692225, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.692472, "o", "                \"supporting_quote\": \"Initiation of lopinavir and ritonavir, a CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving lopinavir and ritonavir, may increase plasma concentrations of medications metabolized by CYP3A.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.69249, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.692552, "o", ">             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.692615, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.692678, "o", "                \"passage_id\": \"PASSAGE_0015\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.692738, "o", "                \"section\": \"5.2 Toxicity in Preterm Neonates\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.692871, "o", "                \"supporting_quote\": \"Lopinavir and ritonavir oral solution should not be used in preterm neonates in the immediate postnatal period because of possible toxicities.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.692917, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693023, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693107, "o", "                \"passage_id\": \"PASSAGE_0016\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[219.693122, "o", "> "]
[219.693179, "o", "                \"section\": \"5.3 Pancreatitis\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.69338, "o", "                \"supporting_quote\": \"Pancreatitis should be considered if clinical symptoms (nausea, vomiting, abdominal pain) or abnormalities in laboratory values (such as increased serum lipase or amylase values) suggestive of pancreatitis occur.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693397, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693444, "o", "            {\r\n\u001b[?2004l\r"]
[219.693481, "o", "\u001b[?2004h> "]
[219.693535, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693597, "o", "                \"passage_id\": \"PASSAGE_0017\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693652, "o", "                \"section\": \"5.4 Hepatotoxicity\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693816, "o", "                \"supporting_quote\": \"Appropriate laboratory testing should be conducted prior to initiating therapy with lopinavir and ritonavir and patients should be monitored closely during treatment.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693912, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.693972, "o", "                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[219.694024, "o", "                \"passage_id\": \"PASSAGE_001"]
[219.769611, "i", "8\",\n                \"section\": \"5.5 QT Interval Prolongation\",\n                \"supporting_quote\": \"Avoid use in patients with congenital long QT syndrome, those with hypokalemia, and with other drugs that prolong the QT interval .\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0019\",\n                \"section\": \"5.6 PR Interval Prolongation\",\n                \"supporting_quote\": \"Lopinavir and ritonavir should be used with caution in patients with underlying structural heart disease, pre-existing conduction system abnormalities, ischemic heart disease or cardiomyopathies\"\n            },\n            {\n                \"set_id\": \"4b1caefa-e6a2-42f3-9194-6dc1dd9e6d85\",\n                \"passage_id\": \"PASSAGE_0022\",\n                \"section\": \"5.9 Lipid Elevations\",\n                \"supporting_quote\": \"Triglyceride and cholesterol testing should be performed prior to initiating lopinavir and ritonavir therapy and at periodic intervals during therapy.\"\n            }\n        ],\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"fbab4114f66e2dda\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"Important warnings and precautions associated with Paxlovid are: risk of serious, life-threatening, or fatal adverse reactions due to drug interactions (strong CYP3A inhibition by ritonavir, or loss of therapeutic effect and possible resistance due to CYP3A induction); hypersensitivity reactions (including anaphylaxis, toxic epidermal necrolysis, Stevens-Johnson syndrome; discontinue immediately if signs occur); hepatotoxicity (hepatic transaminase elevations, clinical hepatitis, jaundice; caution in pre-existing liver disease or liver enzyme abnormalities); and risk of HIV-1 resistance development in individuals with uncontrolled or undiagnosed HIV-1 infection.\",\n        \"citations\": [\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0000\",\n                \"section\": \"BOXED WARNING\",\n                \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0013\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"supporting_quote\": \"Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations of medications metabolized by CYP3A.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0014\",\n                \"section\": \"5.2 Hypersensitivity Reactions\",\n                \"supporting_quote\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0015\",\n                \"section\": \"5.3 Hepatotoxicity\",\n                \"supporting_quote\": \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0016\",\n                \"section\": \"5.4 Risk of HIV-1 Resistance Development\",\n                \"supporting_quote\": \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\"\n            }\n        ],"]
[219.769642, "i", "\n        \"structured_fields\": {}\n    },\n    {\n        \"qid\": \"2d63e0a82215867f\",\n        \"status\": \"ANSWERED\",\n        \"answer\": \"The safety risks listed for Paxlovid include: serious, life-threatening, or fatal adverse reactions due to drug interactions; hypersensitivity reactions (including anaphylaxis, toxic epidermal necrolysis, Stevens-Johnson syndrome, and malaise); hepatotoxicity (hepatic transaminase elevations, clinical hepatitis, jaundice); risk of HIV-1 resistance development in individuals with uncontrolled or undiagnosed HIV-1 infection; and common adverse reactions from clinical trials (incidence >=1% and greater than placebo) which are dysgeusia (5% vs <1% placebo) and diarrhea (3% vs 2% placebo). Other adverse reactions identified under Emergency Use Authorization include headache, hypertension, abdominal pain, nausea, vomiting, and malaise.\",\n        \"citations\": [\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0013\",\n                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\n                \"supporting_quote\": \"Severe, life-threatening, and/or fatal adverse reactions due to drug interactions have been reported in patients treated with PAXLOVID.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0014\",\n                \"section\": \"5.2 Hypersensitivity Reactions\",\n                \"supporting_quote\": \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0015\",\n                \"section\": \"5.3 Hepatotoxicity\",\n                \"supporting_quote\": \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0016\",\n                \"section\": \"5.4 Risk of HIV-1 Resistance Development\",\n                \"supporting_quote\": \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\"\n            },\n            {\n                \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\n                \"passage_id\": \"PASSAGE_0018\",\n                \"section\": \"6.1 Clinical Trials Experience\",\n                \"supporting_quote\": \"The most common adverse reactions (≥1% incidence in the PAXLOVID group and occurring at a greater frequency than in the placebo group) were dysgeusia (5% and <1%, respectively) and diarrhea (3% and 2%, respectively).\"\n            }\n        ],\n        \"structured_fields\": {}\n    }\n]\n\n# Verify all quotes\nall_verified = True\nfor ans in answers_data:\n    for cit in ans['citations']:\n        if not verify_quote(cit['set_id'], cit['passage_id'], cit['supporting_quote']):\n            all_verified = False\n\nif all_verified:\n    print(\"All quotes verified successfully!\")\n    # Write to /workspace/answers.json\n    output = {\"answers\": answers_data}\n    with open('/workspace/answers.json', 'w') as f:\n        json.dump(output, f, indent=2)\n    print(\"Wrote /workspace/answers.json\")\nelse:\n    print(\"Some quotes failed verification!\")\nEOF\npython3 generate_answers.py\n"]
