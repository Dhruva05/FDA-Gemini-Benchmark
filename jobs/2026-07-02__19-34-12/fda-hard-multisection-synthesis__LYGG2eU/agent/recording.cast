[92.181842, "i", "cat << 'EOF' > print_passages.py\nimport json\nimport sys\n\nset_id = sys.argv[1]\npids = sys.argv[2:]\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        if label['set_id'] == set_id:\n            for pid in pids:\n                idx = int(pid.split('_')[1])\n                print(f\"=== {pid} ===\")\n                print(label['chunks'][idx])\n                print(\"=\"*40)\nEOF\npython3 print_passages.py 8a99d6d6-fd9e-45bb-b1bf-48c7f761232a PASSAGE_0000 PASSAGE_0013 PASSAGE_0021\n"]
