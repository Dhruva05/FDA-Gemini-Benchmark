[26.372622, "i", "cat << 'EOF' > find_passage.py\nimport json\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        label = json.loads(line)\n        print(label['drug_name'])\n        # Let's search inside the dictionary for any keys or string values containing 'PASSAGE'\n        def search_dict(obj, path=\"\"):\n            if isinstance(obj, dict):\n                for k, v in obj.items():\n                    if 'PASSAGE' in str(k):\n                        print(f\"Found in key: {path}.{k}\")\n                    search_dict(v, f\"{path}.{k}\")\n            elif isinstance(obj, list):\n                for i, v in enumerate(obj):\n                    if isinstance(v, str) and 'PASSAGE' in v:\n                        print(f\"Found in list element {path}[{i}]: {v[:100]}...\")\n                    else:\n                        search_dict(v, f\"{path}[{i}]\")\n        search_dict(label)\n        break\nEOF\npython3 find_passage.py\n"]
