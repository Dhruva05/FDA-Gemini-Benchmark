[156.646959, "o", "                },\r\n\u001b[?2004l\r12, \"P\u001b[?2004h> "]
[156.647051, "o", "                {\r\n\u001b[?2004l\r\u001b[?2004h>                     \"set_id\": set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
