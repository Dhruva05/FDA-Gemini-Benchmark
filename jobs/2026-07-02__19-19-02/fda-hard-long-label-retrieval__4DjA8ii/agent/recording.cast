[156.658893, "o", "                    \"section\": \"2.3 Dosage in Patients with Renal Impairment\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.658996, "o", "                    \"supporting_quote\": get_exact_quote(7, \"150 mg nirmatrelvir (one 150 mg tablet) with 100 mg ritonavir (one 100 mg tablet) twice daily\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.659035, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.659082, "o", "            \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.659118, "o", "        },\r\n\u001b[?2004l\r"]
[156.659174, "o", "\u001b[?2004h> "]
[156.659191, "o", "        {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.659238, "o", "            \"qid\": \"b54c25890c1ae3a6\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.659248, "o", "            \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.659715, "o", "            \"answer\": \"Paxlovid consists of nirmatrelvir tablets co-packaged with ritonavir tablets, which must be taken together. The tablets can be taken with or without food. They must be swallowed whole and should not be chewed, broken, or crushed. Treatment should be initiated as soon as possible after diagnosis of COVID-19 and within 5 days of symptom onset. If a dose is missed within 8 hours of the usual time, it should be taken as soon as possible; if missed by more than 8 hours, the missed dose should be skipped and the next dose taken at the regular time (do not double the dose).\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.659731, "o", "            \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.659807, "o", "                {\r\n\u001b[?2004l\r\u001b[?2004h> "]
