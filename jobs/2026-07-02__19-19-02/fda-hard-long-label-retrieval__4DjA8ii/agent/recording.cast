[22.182487, "i", "python3 -c \"\nimport json, re\nwith open('/workspace/data/public/labels.jsonl') as f:\n    data = json.loads(f.readline())\n    raw = data['label_raw']\n    passages = re.split(r'\\|\\|(PASSAGE_\\d+)\\|\\|', raw)\n    # The first element of split might be empty if it starts with the delimiter\n    print('First 5 elements of split:', [p[:50] for p in passages[:10]])\n\"\n"]
