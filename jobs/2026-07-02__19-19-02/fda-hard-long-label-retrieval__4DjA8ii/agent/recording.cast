[156.660134, "o", "                    \"supporting_quote\": get_exact_quote(3, \"PAXLOVID (both nirmatrelvir and ritonavir tablets) can be taken with or without food . The tablets should be swallowed whole and not chewed, broken, or crushed.\")\r\n\u001b[?2004l\r\u001b[?2004h>                 },\r\n\u001b[?2004l\r\u001b[?2004h"]
