[40.959225, "i", "cat << 'EOF' > search_label.py\nimport json\nimport re\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    for line in f:\n        data = json.loads(line)\n        if data['set_id'] == '8a99d6d6-fd9e-45bb-b1bf-48c7f761232a':\n            label_data = data\n            break\n\ndef search(pattern, case_insensitive=True):\n    flags = re.IGNORECASE if case_insensitive else 0\n    results = []\n    for idx, chunk in enumerate(label_data['chunks']):\n        if re.search(pattern, chunk, flags):\n            results.append((idx, chunk))\n    return results\n\nEOF\npython3 -i search_label.py\n"]
