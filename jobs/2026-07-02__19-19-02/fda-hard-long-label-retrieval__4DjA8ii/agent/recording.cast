[156.647391, "o", "\u001b[?2004h> "]
[156.647609, "o", "                    \"supporting_quote\": get_exact_quote(15, \"Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
