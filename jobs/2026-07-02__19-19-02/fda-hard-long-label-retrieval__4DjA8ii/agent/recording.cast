[156.648591, "o", "            \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.648633, "o", "        {\r\n\u001b[?2004l\rrment (C"]
[156.648688, "o", "\u001b[?2004h> "]
[156.648708, "o", "            \"qid\": \"2d63e0a82215867f\",\r\n\u001b[?2004l\r not \u001b[?2004h> "]
[156.648818, "o", "            \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rion du\u001b[?2004h> "]
[156.649834, "o", "            \"answer\": \"The safety risks listed for Paxlovid include drug-drug interactions (which can lead to serious, life-threatening, or fatal events), hypersensitivity reactions (including anaphylaxis, toxic epidermal necrolysis, and Stevens-Johnson syndrome), hepatotoxicity (hepatic transaminase elevations, clinical hepatitis, and jaundice), and risk of HIV-1 resistance development. In clinical trials, the most common adverse reactions (>=1% incidence and more frequent than placebo) were dysgeusia and diarrhea. Other post-authorization adverse reactions include headache, hypertension, abdominal pain, nausea, vomiting, and malaise.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.649926, "o", "            \"citations\": [\r\n\u001b[?2004l\r_\u001b[?2004h> "]
[156.649988, "o", "                {\r\n\u001b[?2004l\r"]
[156.650006, "o", "\u001b[?2004h> "]
[156.650074, "o", "                    \"set_id\": set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.650173, "o", "                    \"passage_id\": \"PASSAGE_0018\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.6502, "o", "> "]
[156.650314, "o", "                    \"section\": \"6.1 Clinical Trials Experience\",\r\n\u001b[?2004l\r"]
[156.650365, "o", "\u001b[?2004h> "]
[156.650802, "o", "                    \"supporting_quote\": get_exact_quote(18, \"The most common adverse reactions (≥1% incidence in the PAXLOVID group and occurring at a greater frequency than in the placebo group) were dysgeusia (5% and <1%, respectively) and diarrhea (3% and 2%, respectively).\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.650874, "o", "                },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.650963, "o", "                {\r\n\u001b[?2004l\r     \u001b[?2004h"]
[156.651039, "o", ">                     \"set_id\": set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.65118, "o", "                    \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.651247, "o", "                    \"section\": \"5.2 Hypersensitivity Reactions\",\r\n\u001b[?2004l\r"]
[156.651323, "o", "\u001b[?2004h> "]
[156.651696, "o", "                    \"supporting_quote\": get_exact_quote(14, \"Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.651746, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.651789, "o", "            ],\r\n\u001b[?2004l\r nirmat\u001b[?2004h> "]
[156.651898, "o", "            \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r"]
[156.651952, "o", "\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.652072, "o", ">             \"qid\": \"cf74a5a8ac9b19de\",\r\n"]
[156.652102, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[156.65215, "o", "            \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[156.652169, "o", "\u001b[?2004h> "]
[156.653821, "o", "            \"answer\": \"Paxlovid is contraindicated in: 1) Patients with a history of clinically significant hypersensitivity reactions (e.g., toxic epidermal necrolysis, Stevens-Johnson syndrome) to its active ingredients (nirmatrelvir or ritonavir) or other components; 2) Concomitant use with drugs primarily metabolized by CYP3A for which elevated concentrations are associated with serious and/or life-threatening reactions (e.g., alfuzosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, colchicine in renal/hepatic impairment, lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil for PAH, triazolam, oral midazolam, flibanserin, and tolvaptan); and 3) Concomitant use with strong CYP3A inducers where significantly reduced plasma concentrations of Paxlovid may cause loss of virologic response and possible resistance (e.g., apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, and St. John's Wort).\",\r\n\u001b[?2004l\r"]
[156.653863, "o", "\u001b[?2004h>             \"citations\": [\r\n\u001b[?2004l\r"]
[156.653923, "o", "\u001b[?2004h"]
[156.65399, "o", ">                 {\r\n\u001b[?2004l\rne 1\u001b[?2004h> "]
[156.654054, "o", "                    \"set_id\": set_id,\r\n\u001b[?2004l\r"]
[156.654112, "o", "\u001b[?2004h> "]
[156.654198, "o", "                    \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r\u001b[?2004h>                     \"section\": \"4 CONTRAINDICATIONS\",\r\n"]
[156.65431, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[156.654668, "o", "                    \"supporting_quote\": get_exact_quote(12, \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product.\")\r\n\u001b[?2004l\rd a\u001b[?2004h> "]
[156.65472, "o", "                }\r\n\u001b[?2004l\r"]
[156.654764, "o", "\u001b[?2004h>             ],\r\n\u001b[?2004l\r after diagnosi\u001b[?2004h> "]
[156.654864, "o", "            \"structured_fields\": {}\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[156.65492, "o", "        },\r\n\u001b[?2004l\r onse\u001b[?2004h>         {\r\n\u001b[?2004l\rt. If a do"]
[156.654935, "o", "\u001b[?2004h> "]
[156.655016, "o", "            \"qid\": \"c4dc176c4827f0ef\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.655121, "o", "            \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[156.655148, "o", "> "]
[156.655933, "o", "            \"answer\": \"Paxlovid should not be taken by: 1) Patients with a history of clinically significant hypersensitivity reactions (such as toxic epidermal necrolysis or Stevens-Johnson syndrome) to nirmatrelvir, ritonavir, or any other component of the product; 2) Patients taking any of the contraindicated medications that are highly dependent on CYP3A for clearance or are strong CYP3A inducers; and 3) Patients with severe hepatic impairment (Child-Pugh Class C), as Paxlovid is not recommended for this population due to a lack of pharmacokinetic or safety data.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.655987, "o", "            \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.656138, "o", "                {\r\n\u001b[?2004l\r\u001b[?2004h>                     \"set_id\": set_id,\r\n\u001b[?2004l\r                 \"set_id\"\u001b[?2004h> "]
[156.656162, "o", "                    \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r"]
[156.656215, "o", "\u001b[?2004h> "]
[156.656272, "o", "                    \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r.2 Recommen\u001b[?2004h> "]
[156.656684, "o", "                    \"supporting_quote\": get_exact_quote(12, \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.656703, "o", "                },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.656751, "o", "                {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.656836, "o", "                    \"set_id\": set_id,\r\n\u001b[?2004l\r\u001b[?2004h>                     \"passage_id\": \"PASSAGE_0010\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.656914, "o", "                    \"section\": \"2.4 Use in Patients with Hepatic Impairment\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.657152, "o", "                    \"supporting_quote\": get_exact_quote(10, \"No pharmacokinetic or safety data are available regarding the use of nirmatrelvir or ritonavir in subjects with severe (Child-Pugh Class C) hepatic impairment; therefore, PAXLOVID is not recommended for use in patients with severe hepatic impairment .\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.657198, "o", "                }\r\n\u001b[?2004l\r\u001b[?2004h>             ],\r\n\u001b[?2004l\r"]
[156.657283, "o", "\u001b[?2004h> "]
[156.657326, "o", "            \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r\u001b[?2004h>         {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.657436, "o", "            \"qid\": \"000ecd1d6df50389\",\r\n\u001b[?2004l\r\u001b[?2004h>             \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.658076, "o", "            \"answer\": \"The standard recommended dosage for Paxlovid is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) taken together orally twice daily (in the morning and at bedtime) for 5 days. For patients with moderate renal impairment (eGFR >=30 to <60 mL/min), the dose is reduced to 150 mg nirmatrelvir (one 150 mg tablet) with 100 mg ritonavir (one 100 mg tablet) twice daily for 5 days. For severe renal impairment (eGFR <30 mL/min), the dosage is 300 mg nirmatrelvir with 100 mg ritonavir on Day 1, followed by 150 mg nirmatrelvir with 100 mg ritonavir once daily on Days 2-5 (administered after hemodialysis on dialysis days). No dosage adjustment is needed for mild renal impairment or mild/moderate hepatic impairment. Paxlovid is not recommended in severe hepatic impairment or severe renal impairment without dose adjustment.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.658093, "o", "            \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.658145, "o", "                {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.658166, "o", "                    \"set_id\": set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.658256, "o", "                    \"passage_id\": \"PASSAGE_0004\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.65834, "o", "                    \"section\": \"2.2 Recommended Dosage\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.658554, "o", "                    \"supporting_quote\": get_exact_quote(4, \"The recommended dosage for PAXLOVID is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) with all 3 tablets taken together orally twice daily in the morning and at bedtime for 5 days.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.658621, "o", "                },\r\n\u001b[?2004l\r\u001b[?2004h>                 {\r\n\u001b[?2004l\r\u001b[?2004h> "]
