[156.648043, "o", "                    \"section\": \"5.4 Risk of HIV-1 Resistance Development\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[156.648431, "o", "                    \"supporting_quote\": get_exact_quote(16, \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
