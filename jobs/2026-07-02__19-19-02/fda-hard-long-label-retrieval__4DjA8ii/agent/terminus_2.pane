[?2004l[?2004h>                     "supporting_quote": get_exact_quote(14, "Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported with PAXLOVID .")
[?2004l[?2004h>                 }
