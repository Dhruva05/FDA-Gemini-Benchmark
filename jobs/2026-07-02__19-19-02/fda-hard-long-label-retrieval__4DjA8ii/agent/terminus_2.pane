[?2004l[?2004h>         {
[?2004l[?2004h>             "qid": "000ecd1d6df50389",
[?2004l[?2004h>             "status": "ANSWERED",
[?2004l[?2004h>             "answer": "The standard recommended dosage for Paxlovid is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) taken together orally twice daily (in the morning and at bedtime) for 5 days. For patients with moderate renal impairment (eGFR >=30 to <60 mL/min), the dose is reduced to 150 mg nirmatrelvir (one 150 mg tablet) with 100 mg ritonavir (one 100 mg tablet) twice daily for 5 days. For severe renal impairment (eGFR <30 mL/min), the dosage is 300 mg nirmatrelvir with 100 mg ritonavir on Day 1, followed by 150 mg nirmatrelvir with 100 mg ritonavir once daily on Days 2-5 (administered after hemodialysis on dialysis days). No dosage adjustment is needed for mild renal impairment or mild/moderate hepatic impairment. Paxlovid is not recommended in severe hepatic impairment or severe renal impairment without dose adjustment.",
[?2004l[?2004h>             "citations": [
