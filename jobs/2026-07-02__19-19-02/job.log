placebo group) were dysgeusia (5% and <1%, respectively) and diarrhea (3% and 2%, respectively)."),\n    (12, "PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product."),\n    (10, "No pharmacokinetic or safety data are available regarding the use of nirmatrelvir or ritonavir in subjects with severe (Child-Pugh Class C) hepatic impairment; therefore, PAXLOVID is not recommended for use in patients with severe hepatic impairment ."),\n    (4, "The recommended dosage for PAXLOVID is 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) with all 3 tablets taken together orally twice daily in the morning and at bedtime for 5 days."),\n    (7, "150 mg nirmatrelvir (one 150 mg tablet) with 100 mg ritonavir (one 100 mg tablet) twice daily"),\n    (3, "PAXLOVID (both nirmatrelvir and ritonavir tablets) can be taken with or without food . The tablets should be swallowed whole and not chewed, broken, or crushed.")\n]\n\nall_ok = True\nfor idx, quote in citations_to_check:\n    passage_text = chunks[idx]\n    # Clean up whitespace in both to avoid mismatch due to newlines/tabs\n    p_clean = " ".join(passage_text.split())\n    q_clean = " ".join(quote.split())\n    if q_clean in p_clean:\n        print(f"PASSAGE_{idx:04d}: Match OK")\n    else:\n        print(f"PASSAGE_{idx:04d}: MISMATCH!")\n        print(f"  Expected: {repr(q_clean)}")\n        print(f"  Found:    {repr(p_clean[:200])}...")\n        all_ok = False\n\nif all_ok:\n    print("All quotes are valid exact substrings!")\nEOF\npython3 verify_quotes.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
