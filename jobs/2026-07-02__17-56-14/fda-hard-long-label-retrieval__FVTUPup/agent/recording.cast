[330.80986, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.809932, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"set_id\": set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
