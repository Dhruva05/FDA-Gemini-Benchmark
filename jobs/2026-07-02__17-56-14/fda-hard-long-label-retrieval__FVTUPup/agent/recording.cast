[330.807353, "o", "\u001b[?2004h> "]
[330.807468, "o", "                \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r"]
[330.807499, "o", "\u001b[?2004h> "]
[330.807715, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions\"\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[330.807735, "o", "\u001b[?2004h>         ],\r\n\u001b[?2004l\r\"supporting\u001b[?2004h> "]
[330.807842, "o", "        \"structured_fields\": {\r\n\u001b[?2004l\r"]
[330.807903, "o", "\u001b[?2004h> "]
[330.807957, "o", "            \"contraindications\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.808098, "o", "                \"History of clinically significant hypersensitivity reactions to active ingredients or components\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.808315, "o", "                \"Co-administration with drugs primarily metabolized by CYP3A with serious/life-threatening risks\",\r\n\u001b[?2004l\r"]
[330.808349, "o", "\u001b[?2004h> "]
[330.808476, "o", "                \"Co-administration with strong CYP3A inducers with loss of virologic response risk\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.808532, "o", "            ]\r\n\u001b[?2004l\r"]
[330.808604, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.808663, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.808741, "o", "        \"qid\": \"c4dc176c4827f0ef\",\r\n\u001b[?2004l\r {\u001b[?2004h"]
[330.808759, "o", ">         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[330.808809, "o", "\u001b[?2004h> "]
[330.809434, "o", "        \"answer\": \"Paxlovid should not be taken by: 1) Patients with a history of clinically significant hypersensitivity reactions (e.g., toxic epidermal necrolysis or Stevens-Johnson syndrome) to nirmatrelvir, ritonavir, or any other components of Paxlovid. 2) Patients taking any contraindicated medications, including those primarily metabolized by CYP3A for which elevated concentrations cause serious/life-threatening reactions, or strong CYP3A inducers. 3) Patients with severe hepatic impairment (Child-Pugh Class C), as Paxlovid is not recommended for use in this population due to a lack of pharmacokinetic or safety data.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.809504, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.80958, "o", "> "]
