[264.677368, "o", "\u001b[?2004hroot@2635f56baf2a:/workspace# "]
[275.125157, "i", "cat << 'EOF' > validate_answers.py\nimport json\n\n# Load labels\nwith open('/workspace/data/public/labels.jsonl') as f:\n    label_data = json.loads(f.readline())\n\n# Load questions\nquestions = []\nwith open('/workspace/data/public/questions.jsonl') as f:\n    for line in f:\n        questions.append(json.loads(line))\n\n# Load answers\nwith open('/workspace/answers.json') as f:\n    answers_data = json.load(f)\n\nprint(\"Keys in answers_data:\", answers_data.keys())\nanswers = answers_data.get(\"answers\", [])\nprint(f\"Number of answers: {len(answers)}\")\n\nqids_q = {q['qid'] for q in questions}\nqids_a = {a['qid'] for a in answers}\n\nprint(\"Questions QIDs:\", qids_q)\nprint(\"Answers QIDs:\", qids_a)\nassert qids_q == qids_a, f\"Mismatch in QIDs! Missing: {qids_q - qids_a}, Extra: {qids_a - qids_q}\"\n\nfor a in answers:\n    print(f\"Checking QID: {a['qid']}\")\n    assert \"status\" in a, \"Missing status\"\n    assert a[\"status\"] in [\"ANSWERED\", \"NOT_FOUND\"], f\"Invalid status: {a['status']}\"\n    assert \"answer\" in a, \"Missing answer\"\n    assert \"citations\" in a, \"Missing citations\"\n    assert \"structured_fields\" in a, \"Missing structured_fields\"\n    \n    for cit in a[\"citations\"]:\n        assert \"set_id\" in cit, \"Citation missing set_id\"\n        assert \"passage_id\" in cit, \"Citation missing passage_id\"\n        assert \"section\" in cit, \"Citation missing section\"\n        assert \"supporting_quote\" in cit, \"Citation missing supporting_quote\"\n        \n        # Check if passage_id is valid\n        pid = cit[\"passage_id\"]\n        import re\n        m = re.match(r'PASSAGE_(\\d+)', pid)\n        assert m, f\"Invalid passage_id format: {pid}\"\n        idx = int(m.group(1))\n        assert idx < len(label_data['chunks']), f\"passage_id index out of range: {pid}\"\n        \n        # Check supporting quote\n        quote = cit[\"supporting_quote\"]\n        chunk = label_data['chunks'][idx]\n        assert quote in chunk, f\"Supporting quote '{quote}' not found in chunk {pid}!\"\n\nprint(\"All validations passed successfully!\")\nEOF\npython3 validate_answers.py\n"]
