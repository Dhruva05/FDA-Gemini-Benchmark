[264.585891, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[264.58596, "o", "\u001b[?2004h> "]
[264.586023, "o", "        \"qid\": \"c4dc176c4827f0ef\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.586075, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.586528, "o", "        \"answer\": \"Paxlovid should not be taken by: 1) Patients with a history of clinically significant hypersensitivity reactions (e.g., toxic epidermal necrolysis or Stevens-Johnson syndrome) to nirmatrelvir, ritonavir, or any other components of Paxlovid. 2) Patients taking any contraindicated medications, including those primarily metabolized by CYP3A for which elevated concentrations cause serious/life-threatening reactions, or strong CYP3A inducers. 3) Patients with severe hepatic impairment (Child-Pugh Class C), as Paxlovid is not recommended for use in this population due to a lack of pharmacokinetic or safety data.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.586547, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.58659, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h"]
