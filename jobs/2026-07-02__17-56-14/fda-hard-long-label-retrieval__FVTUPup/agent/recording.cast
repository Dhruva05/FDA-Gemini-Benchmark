[330.810028, "o", "> "]
[330.81008, "o", "                \"section\": \"2.4 Use in Patients with Hepatic Impairment\",\r\n\u001b[?2004l\r"]
[330.810115, "o", "\u001b[?2004h> "]
[330.810198, "o", "                \"supporting_quote\": \"PAXLOVID is not recommended for use in patients with severe hepatic impairment\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.810278, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         ],\r\n\u001b[?2004l\r"]
[330.810296, "o", "\u001b[?2004h>         \"structured_fields\": {"]
[330.810361, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.81038, "o", "            \"contraindicated_populations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.810509, "o", "                \"Patients with history of clinically significant hypersensitivity reactions to active ingredients or components\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.810606, "o", "                \"Patients taking contraindicated drugs (primarily CYP3A-metabolized or strong CYP3A inducers)\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.810619, "o", "> "]
[330.810749, "o", "                \"Patients with severe hepatic impairment (Child-Pugh Class C) (not recommended)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.810804, "o", "            ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.810857, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.810876, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h>         \"qid\": \"000ecd1d6df50389\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.810945, "o", ">         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.811641, "o", "        \"answer\": \"The recommended dosage regimen of Paxlovid is: 1) Standard dosage for patients with normal renal function or mild renal impairment (eGFR >= 60 mL/min): 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) taken together orally twice daily (morning and bedtime) for 5 days. 2) Patients with moderate renal impairment (eGFR >= 30 to <60 mL/min): 150 mg nirmatrelvir (one 150 mg tablet) with 100 mg ritonavir (one 100 mg tablet) taken together orally twice daily for 5 days. 3) Patients with severe renal impairment (eGFR <30 mL/min), including those requiring hemodialysis: Day 1: 300 mg nirmatrelvir (two 150 mg tablets) with 100 mg ritonavir (one 100 mg tablet) once. Days 2-5: 150 mg nirmatrelvir (one 150 mg tablet) with 100 mg ritonavir (one 100 mg tablet) once daily. On dialysis days, the dose should be administered after hemodialysis. The 5-day treatment course should be initiated as soon as possible after diagnosis of COVID-19, and within 5 days of symptom onset.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.811696, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h"]
