[330.800847, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[330.800957, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\rswer\":"]
[330.801043, "o", "\u001b[?2004h>         \"qid\": \"2d63e0a82215867f\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.801105, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.801172, "o", "> "]
[330.802462, "o", "        \"answer\": \"The safety risks listed for Paxlovid include: 1) Most common adverse reactions (incidence >= 1% and greater than placebo) from clinical trials: dysgeusia (5% vs. <1%) and diarrhea (3% vs. 2%). 2) Adverse reactions identified during Emergency Use Authorization (EUA) use: anaphylaxis, hypersensitivity reactions, toxic epidermal necrolysis, Stevens-Johnson syndrome, headache, hypertension, abdominal pain, nausea, vomiting, and malaise. 3) Serious warnings/precautions: risk of serious adverse reactions due to drug interactions (especially with calcineurin inhibitors and calcium channel blockers), hepatotoxicity (transaminase elevations, clinical hepatitis, jaundice), and risk of HIV-1 resistance development in patients with uncontrolled or undiagnosed HIV-1 infection.\",\r\n\u001b[?2004l\r"]
[330.80249, "o", "\u001b[?2004h> "]
[330.802519, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.802588, "o", "            {\r\n\u001b[?2004l\rifi\u001b[?2004h> "]
