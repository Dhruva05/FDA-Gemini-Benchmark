[264.570748, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers where significantly reduced nirmatrelvir or ritonavir plasma concentrations may be associated with the potential for loss of virologic response and possible resistance.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.570845, "o", "            }\r\n\u001b[?2004l\r  ]\u001b[?2004h>         ],\r\n\u001b[?2004l\r"]
