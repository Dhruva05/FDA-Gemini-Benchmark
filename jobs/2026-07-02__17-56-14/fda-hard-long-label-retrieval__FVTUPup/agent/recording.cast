[264.57225, "o", "            ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.57234, "o", "            \"strong_cyp3a_inducers\": [\r\n\u001b[?2004l\rns \u001b[?2004h> "]
[264.572538, "o", "                \"apalutamide\", \"enzalutamide\", \"carbamazepine\", \"phenobarbital\", \"primidone\", \"phenytoin\",\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[264.572709, "o", "                \"rifampin\", \"rifapentine\", \"lumacaftor/ivacaftor\", \"St. John's Wort\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.572725, "o", ">             ],\r\n\u001b[?2004l\r"]
[264.572779, "o", "nts with uncont\u001b[?2004h> "]
[264.572899, "o", "            \"other_medications_to_avoid\": [\r\n\u001b[?2004l\rion.\",\r\n   \u001b[?2004h> "]
[264.573085, "o", "                \"tamsulosin\", \"encorafenib\", \"ivosidenib\", \"neratinib\", \"venetoclax\", \"ibrutinib\",\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[264.573247, "o", "                \"rivaroxaban\", \"dabigatran\", \"voriconazole\", \"aliskiren\", \"ticagrelor\", \"vorapaxar\",\r\n\u001b[?2004l\rrti\u001b[?2004h> "]
[264.573434, "o", "                \"clopidogrel\", \"glecaprevir/pibrentasvir\", \"everolimus\", \"sirolimus\", \"salmeterol\",\r\n\u001b[?2004l\r"]
[264.57345, "o", "\u001b[?2004h> "]
[264.573563, "o", "                \"rimegepant\", \"suvorexant\", \"tadalafil\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.573675, "o", "            ]\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[264.573696, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.573792, "o", "        \"qid\": \"fbab4114f66e2dda\",\r\n\u001b[?2004l\rctiv\u001b[?2004h> "]
[264.573884, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.575353, "o", "        \"answer\": \"The important warnings and precautions associated with Paxlovid are: 1) Risk of Serious Adverse Reactions Due to Drug Interactions: Ritonavir is a strong CYP3A inhibitor, and co-administration with CYP3A-metabolized drugs can lead to serious, life-threatening, or fatal events, while strong CYP3A inducers can decrease Paxlovid exposure, causing loss of efficacy and resistance. 2) Hypersensitivity Reactions: Anaphylaxis, serious skin reactions (including toxic epidermal necrolysis and Stevens-Johnson syndrome), and other hypersensitivity reactions have been reported. 3) Hepatotoxicity: Hepatic transaminase elevations, clinical hepatitis, and jaundice have occurred in patients receiving ritonavir. 4) Risk of HIV-1 Resistance Development: Ritonavir co-administration may lead to HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection.\",\r\n\u001b[?2004l\r"]
[264.575374, "o", "\u001b[?2004h>         \"citations\": [\r\n\u001b[?2004l\r"]
[264.575437, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\rrolysis [TEN] \u001b[?2004h> "]
