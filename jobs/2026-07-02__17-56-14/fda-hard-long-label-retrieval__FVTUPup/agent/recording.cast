[264.586977, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.586997, "o", ">             {\r\n\u001b[?2004l\r"]
