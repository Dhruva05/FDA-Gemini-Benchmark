[73.642258, "i", "cat << 'EOF' > search.py\nimport json\nimport sys\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    data = json.loads(f.readline())\n\nchunks = data['chunks']\n\nif len(sys.argv) > 1:\n    query = sys.argv[1].lower()\n    for i, chunk in enumerate(chunks):\n        if query in chunk.lower():\n            print(f'=== PASSAGE_{i:04d} ===')\n            print(chunk[:300] + '...')\n            print()\nEOF\npython3 search.py \"dosage\"\n"]
