[330.802907, "o", "                \"section\": \"6.1 Clinical Trials Experience\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.803083, "o", "                \"supporting_quote\": \"were dysgeusia (5% and <1%, respectively) and diarrhea (3% and 2%, respectively).\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.803138, "o", "            }\r\n\u001b[?2004l\r"]
[330.8032, "o", "\u001b[?2004h>         ],\r\n\u001b[?2004l\rended for u\u001b[?2004h> "]
