[330.797973, "o", "                \"supporting_quote\": \"Severe, life-threatening, and/or fatal adverse reactions due to drug interactions have been reported in patients treated with PAXLOVID.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
