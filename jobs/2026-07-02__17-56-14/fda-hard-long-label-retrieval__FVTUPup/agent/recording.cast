[264.58237, "o", "                \"nausea\", \"vomiting\", \"malaise\"\r\n\u001b[?2004l\r\u001b[?2004h>             ],\r\n\u001b[?2004l\rmpai"]
[264.582387, "o", "\u001b[?2004h> "]
[264.582456, "o", "            \"serious_risks\": [\r\n\u001b[?2004l\r n\u001b[?2004h> "]
