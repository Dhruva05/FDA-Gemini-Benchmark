[264.575823, "o", "> "]
[264.576086, "o", "                \"supporting_quote\": \"Severe, life-threatening, and/or fatal adverse reactions due to drug interactions have been reported in patients treated with PAXLOVID.\"\r\n\u001b[?2004l\rnedaron\u001b[?2004h> "]
[264.576138, "o", "            },\r\n\u001b[?2004l\ride, \u001b[?2004h> "]
