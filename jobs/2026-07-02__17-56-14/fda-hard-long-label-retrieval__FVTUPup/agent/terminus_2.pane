[?2004hroot@2635f56baf2a:/workspace# cat << 'EOF' > validate_answers.py
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> # Load labels
[?2004l[?2004h> with open('/workspace/data/public/labels.jsonl') as f:
[?2004l[?2004h>     label_data = json.loads(f.readline())
[?2004l[?2004h> 
[?2004l[?2004h> # Load questions
[?2004l[?2004h> questions = []
[?2004l[?2004h> with open('/workspace/data/public/questions.jsonl') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         questions.append(json.loads(line))
[?2004l[?2004h> 
[?2004l[?2004h> # Load answers
[?2004l[?2004h> with open('/workspace/answers.json') as f:
[?2004l[?2004h>     answers_data = json.load(f)
[?2004l[?2004h> 
[?2004l[?2004h> print("Keys in answers_data:", answers_data.keys())
[?2004l[?2004h> answers = answers_data.get("answers", [])
[?2004l[?2004h> print(f"Number of answers: {len(answers)}")
[?2004l[?2004h> 
[?2004l[?2004h> qids_q = {q['qid'] for q in questions}
[?2004l[?2004h> qids_a = {a['qid'] for a in answers}
[?2004l[?2004h> 
[?2004l[?2004h> print("Questions QIDs:", qids_q)
[?2004l[?2004h> print("Answers QIDs:", qids_a)
[?2004l[?2004h> assert qids_q == qids_a, f"Mismatch in QIDs! Missing: {qids_q - qids_a}, Extra: {qids_a - qids_q}"
[?2004l[?2004h> 
[?2004l[?2004h> for a in answers:
[?2004l[?2004h>     print(f"Checking QID: {a['qid']}")
[?2004l[?2004h>     assert "status" in a, "Missing status"
[?2004l[?2004h>     assert a["status"] in ["ANSWERED", "NOT_FOUND"], f"Invalid status: {a['status']}"
[?2004l[?2004h>     assert "answer" in a, "Missing answer"
[?2004l[?2004h>     assert "citations" in a, "Missing citations"
[?2004l[?2004h>     assert "structured_fields" in a, "Missing structured_fields"
[?2004l[?2004h>     
[?2004l[?2004h>     for cit in a["citations"]:
[?2004l[?2004h>         assert "set_id" in cit, "Citation missing set_id"
[?2004l[?2004h>         assert "passage_id" in cit, "Citation missing passage_id"
[?2004l[?2004h>         assert "section" in cit, "Citation missing section"
[?2004l[?2004h>         assert "supporting_quote" in cit, "Citation missing supporting_quote"
[?2004l[?2004h>         
[?2004l[?2004h>         # Check if passage_id is valid
[?2004l[?2004h>         pid = cit["passage_id"]
[?2004l[?2004h>         import re
[?2004l[?2004h>         m = re.match(r'PASSAGE_(\d+)', pid)
[?2004l[?2004h>         assert m, f"Invalid passage_id format: {pid}"
[?2004l[?2004h>         idx = int(m.group(1))
[?2004l[?2004h>         assert idx < len(label_data['chunks']), f"passage_id index out of range: {pid}"
[?2004l[?2004h>         
[?2004l[?2004h>         # Check supporting quote
[?2004l[?2004h>         quote = cit["supporting_quote"]
[?2004l[?2004h>         chunk = label_data['chunks'][idx]
[?2004l[?2004h>         assert quote in chunk, f"Supporting quote '{quote}' not found in chunk {pid}!"
[?2004l[?2004h> 
[?2004l[?2004h> print("All validations passed successfully!")
[?2004l[?2004h> EOF
