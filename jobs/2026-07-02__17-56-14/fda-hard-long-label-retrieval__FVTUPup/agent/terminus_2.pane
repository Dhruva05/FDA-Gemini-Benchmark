[?2004l[?2004h>                 "passage_id": "PASSAGE_0012",
[?2004l[?2004h>                 "section": "4 CONTRAINDICATIONS",
[?2004l[?2004h>                 "supporting_quote": "PAXLOVID is contraindicated in patients with a history of clinically significant hypersensitivity reactions e.g., toxic epidermal necrolysis (TEN) or Stevens-Johnson syndrome] to its active ingredients (nirmatrelvir or ritonavir) or any other components of the product."
[?2004l[?2004h>             }
[?2004l[?2004h>         ],
[?2004l[?2004h>         "structured_fields": {
[?2004l[?2004h>             "contraindications": [
[?2004l[?2004h>                 "History of clinically significant hypersensitivity reactions to active ingredients or components",
[?2004l[?2004h>                 "Co-administration with drugs primarily metabolized by CYP3A with serious/life-threatening risks",
[?2004l[?2004h>                 "Co-administration with strong CYP3A inducers with loss of virologic response risk"
[?2004l[?2004h>             ]
[?2004l[?2004h>         }
[?2004l[?2004h>     },
[?2004l[?2004h>     {
[?2004l[?2004h>         "qid": "c4dc176c4827f0ef",
[?2004l[?2004h>         "status": "ANSWERED",
[?2004l[?2004h>         "answer": "Paxlovid should not be taken by: 1) Patients with a history of clinically significant hypersensitivity reactions (e.g., toxic epidermal necrolysis or Stevens-Johnson syndrome) to nirmatrelvir, ritonavir, or any other components of Paxlovid. 2) Patients taking any contraindicated medications, including those primarily metabolized by CYP3A for which elevated concentrations cause serious/life-threatening reactions, or strong CYP3A inducers. 3) Patients with severe hepatic impairment (Child-Pugh Class C), as Paxlovid is not recommended for use in this population due to a lack of pharmacokinetic or safety data.",
