[?2004l[?2004h>         "structured_fields": {
[?2004l[?2004h>             "contraindicated_populations": [
[?2004l[?2004h>                 "Patients with history of clinically significant hypersensitivity reactions to active ingredients or components",
[?2004l[?2004h>                 "Patients taking contraindicated drugs (primarily CYP3A-metabolized or strong CYP3A inducers)",
