[?2004l[?2004h>                 # print first 150 chars or full chunk if short
[?2004l[?2004h>                 print(f"    PASSAGE_{i:04d}: {repr(chunk)}")
[?2004l[?2004h>     print("\n" + "="*80 + "\n")
