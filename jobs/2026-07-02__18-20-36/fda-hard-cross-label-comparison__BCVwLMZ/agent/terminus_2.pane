[?2004l[?2004h> with open('/workspace/data/public/labels.jsonl') as f:
[?2004l[?2004h>     labels = {l['set_id']: l for l in (json.loads(line) for line in f)}
[?2004l[?2004h> 
[?2004l[?2004h> with open('/workspace/data/public/questions.jsonl') as f:
[?2004l[?2004h>     questions = [json.loads(line) for line in f]
[?2004l[?2004h> 
[?2004l[?2004h> for q in questions:
[?2004l[?2004h>     print(f"=== QUESTION: {q['drug_name']} ({q['qid']}) ===")
[?2004l[?2004h>     for set_id in q['comparison_set_ids']:
[?2004l[?2004h>         label = labels[set_id]
