[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         data = json.loads(line)
[?2004l[?2004h>         labels[data["set_id"]] = data
[?2004l[?2004h> 
[?2004l[?2004h> def print_all_chunks(sid):
[?2004l[?2004h>     label = labels[sid]
[?2004l[?2004h>     print("="*80)
[?2004l[?2004h>     print(f"DRUG: {label["drug_name"]} ({sid})")
[?2004l[?2004h>     for i, c in enumerate(label["chunks"]):
[?2004l[?2004h>         print(f"  PASSAGE_{i:04d}: {repr(c)}")
[?2004l[?2004h> 
[?2004l[?2004h> for sid in [
[?2004l[?2004h>     "08c9d3dd-717b-0148-e054-00144ff8d46c",
[?2004l[?2004h>     "36adb32c-638c-4d6e-b66a-1a1c35174ce6",
[?2004l[?2004h>     "6972d9c1-36ec-4246-bf7b-13206d5952c3",
[?2004l[?2004h>     "8e396b27-b44a-4aa9-805b-086395444b5f",
[?2004l[?2004h>     "dcc29902-1fe6-4713-947e-335503959464",
[?2004l[?2004h>     "3efa1e5e-5a14-4724-a2ca-25702f10faed"
[?2004l[?2004h> ]:
[?2004l[?2004h>     print_all_chunks(sid)
