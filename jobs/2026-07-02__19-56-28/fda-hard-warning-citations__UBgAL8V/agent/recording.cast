[149.984674, "o", "                \"supporting_quote\": \"Lopinavir and ritonavir oral solution is not recommended in neonates before a postmenstrual age (first day of the mother’s last menstrual period to birth plus the time elapsed after birth) of 42 weeks and a postnatal age of at least 14 days has been attained .\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r       "]
