[39.184428, "i", "cat << 'EOF' > search.py\nimport json, re\n\nwith open('/workspace/data/public/labels.jsonl') as f:\n    labels = [json.loads(line) for line in f]\n\ndef search(drug_name, query):\n    drug = next(d for d in labels if d['drug_name'].lower() == drug_name.lower())\n    print(f\"Searching for '{query}' in {drug['drug_name']}:\")\n    for i, chunk in enumerate(drug['chunks']):\n        if re.search(query, chunk, re.IGNORECASE):\n            print(f\"PASSAGE_{i:04d} (len={len(chunk)}): {chunk[:200]}...\")\n\nEOF\n"]
[39.184678, "o", "cat << 'EOF' > search.py\r\n\u001b[?2004l\r\u001b[?2004h> import json, re\r\n\u001b[?2004l\r"]
