[149.963889, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[149.963961, "o", "answers_data = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.964232, "o", "    {\r\n\u001b[?2004l\ron\u001b[?2004h> "]
[149.964373, "o", "        \"qid\": \"b2531657ba5c7a78\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.964569, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.965758, "o", "        \"answer\": \"Paxlovid is associated with significant drug interactions due to ritonavir, which is a strong CYP3A inhibitor. This can increase the exposure of certain concomitant medications, potentially resulting in severe, life-threatening, or fatal events. Commonly reported serious adverse reactions involved calcineurin inhibitors (e.g., tacrolimus, cyclosporine) and calcium channel blockers. Conversely, drugs that induce CYP3A can decrease Paxlovid concentrations, leading to a loss of therapeutic effect and possible development of viral resistance. Co-administration with drugs highly dependent on CYP3A for clearance is contraindicated. Prior to prescribing, healthcare providers must review all medications to assess potential interactions, adjust dosages, or perform additional monitoring.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.965828, "o", "        \"citations\": [\r\n\u001b[?2004l\re.\"\r\n    \u001b[?2004h> "]
[149.965894, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.965994, "o", "                \"set_id\": paxlovid_set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.966225, "o", "                \"passage_id\": \"PASSAGE_0000\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.966449, "o", "                \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.966944, "o", "                \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\r"]
[149.967072, "o", "\u001b[?2004h>             },\r\n\u001b[?2004l\rERED\",\r\n        \u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.967167, "o", "                \"set_id\": paxlovid_set_id,\r\n\u001b[?2004l\rbe take\u001b[?2004h> "]
[149.967355, "o", "                \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.967568, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r incompatibility, but comp\u001b[?2004h> "]
[149.967934, "o", "                \"supporting_quote\": \"The most commonly reported concomitant medications resulting in serious adverse reactions were calcineurin inhibitors (e.g., tacrolimus, cyclosporine), followed by calcium channel blockers.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.967956, "o", "            },\r\n\u001b[?2004l\rhe"]
