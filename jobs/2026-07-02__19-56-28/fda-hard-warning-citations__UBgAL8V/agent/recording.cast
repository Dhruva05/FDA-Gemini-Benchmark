[164.072266, "i", "cat << 'EOF' > validate.py\nimport json\nwith open('/workspace/answers.json') as f:\n    data = json.load(f)\n\nprint('Answers count:', len(data['answers']))\nqids = [ans['qid'] for ans in data['answers']]\nprint('QIDs:', qids)\n\nwith open('/workspace/data/public/questions.jsonl') as f:\n    expected_qids = [json.loads(line)['qid'] for line in f]\nprint('Expected QIDs:', expected_qids)\nassert set(qids) == set(expected_qids), 'QID mismatch!'\nassert len(qids) == len(expected_qids), 'Duplicate or missing QIDs!'\n\nfor i, ans in enumerate(data['answers']):\n    assert 'qid' in ans\n    assert 'status' in ans\n    assert 'answer' in ans\n    assert 'citations' in ans\n    assert 'structured_fields' in ans\n    print(f'Answer {i} (QID {ans[\"qid\"]}): status={ans[\"status\"]}, citations_count={len(ans[\"citations\"])}')\n    for cit in ans['citations']:\n        assert 'set_id' in cit\n        assert 'passage_id' in cit\n        assert 'section' in cit\n        assert 'supporting_quote' in cit\n\nprint(\"ALL CHECKS PASSED SUCCESSFULLY!\")\nEOF\n"]
