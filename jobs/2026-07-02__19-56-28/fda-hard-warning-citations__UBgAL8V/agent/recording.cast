[150.090501, "o", "                \"supporting_quote\": \"Because nirmatrelvir is co-administered with ritonavir, there may be a risk of HIV-1 developing resistance to HIV protease inhibitors in individuals with uncontrolled or undiagnosed HIV-1 infection .\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
