[149.988179, "o", "                \"supporting_quote\": \"Pancreatitis has been observed in patients receiving lopinavir and ritonavir therapy, including those who developed marked triglyceride elevations.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.988192, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.988255, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"set_id\": lop_rit_set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
