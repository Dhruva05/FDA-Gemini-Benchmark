[150.093864, "o", "# Validate supporting quotes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.093885, "o", "print(\"Validating quotes...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.093939, "o", "for ans in answers_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.093995, "o", "    print(f\"Checking QID: {ans['qid']}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094089, "o", "    for cit in ans['citations']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094141, "o", "        passage_text = get_passage(cit['set_id'], cit['passage_id'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094165, "o", "        quote = cit['supporting_quote']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094223, "o", "        # Normalize whitespace for matching\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094282, "o", "        norm_passage = \" \".join(passage_text.split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094339, "o", "        norm_quote = \" \".join(quote.split())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094431, "o", "        if norm_quote not in norm_passage:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094501, "o", "            print(f\"ERROR: Quote not found in {cit['passage_id']}!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094568, "o", "            print(f\"Expected: {norm_quote}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.09461, "o", "            print(f\"Passage: {norm_passage[:300]}...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094659, "o", "            exit(1)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[150.094713, "o", "\u001b[?2004h> "]
[150.094767, "o", "            print(f\"  {cit['passage_id']} quote verified!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.094825, "o", "# Save to /workspace/answers.json\r\n\u001b[?2004l\r\u001b[?2004h> out = {\"answers\": answers_data}\r\n\u001b[?2004l\r"]
