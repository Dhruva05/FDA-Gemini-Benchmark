[149.985863, "o", "\u001b[?2004h> "]
[149.986746, "o", "        \"answer\": \"The safety risks listed for Lopinavir-Ritonavir include: 1) Risk of serious, life-threatening, or fatal adverse reactions due to drug interactions with medications metabolized by CYP3A. 2) Toxicity in preterm neonates, including life-threatening cardiac toxicity (AV block, bradycardia, cardiomyopathy), lactic acidosis, renal failure, CNS depression, and respiratory complications due to the ethanol and propylene glycol excipients. 3) Pancreatitis, which has been observed with marked triglyceride elevations, occasionally leading to fatalities. 4) Hepatotoxicity, with reports of hepatic dysfunction, transaminase elevations, or hepatic decompensation, particularly in patients with underlying hepatitis B or C. 5) QT interval prolongation and torsade de pointes. 6) PR interval prolongation and cardiac conduction abnormalities, including second or third-degree AV block. Other risks include diabetes mellitus/hyperglycemia, immune reconstitution syndrome, lipid elevations, fat redistribution, and increased bleeding in hemophilia patients.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.986828, "o", "        \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.98689, "o", "                \"set_id\": lop_rit_set_id,\r\n\u001b[?2004l\r\u001b[?2004h>                 \"passage_id\": \"PASSAGE_0014\",\r\n\u001b[?2004l\r"]
[149.986941, "o", "\u001b[?2004h> "]
[149.987034, "o", "                \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.98721, "o", "                \"supporting_quote\": \"Clinically significant adverse reactions, potentially leading to severe, life-threatening, or fatal events from greater exposures of concomitant medications.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r"]
