[149.970006, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.970156, "o", "    {\r\n\u001b[?2004l\rBe\u001b[?2004h> "]
[149.970193, "o", "        \"qid\": \"6f12607a1ba14dd5\",\r\n\u001b[?2004l\r"]
[149.970293, "o", "\u001b[?2004h>         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\rsolution contains ethanol a"]
[149.970419, "o", "nd \u001b[?2004h> "]
[149.972215, "o", "        \"answer\": \"Medications that should be avoided or are contraindicated with Paxlovid include: alpha 1-adrenoreceptor antagonists (alfuzosin), antianginals (ranolazine), antiarrhythmics (amiodarone, dronedarone, flecainide, propafenone, quinidine), anti-gout agents (colchicine in patients with renal/hepatic impairment), antipsychotics (lurasidone, pimozide), BPH agents (silodosin), cardiovascular agents (eplerenone, ivabradine), ergot derivatives (dihydroergotamine, ergotamine, methylergonovine), HMG-CoA reductase inhibitors (lovastatin, simvastatin), immunosuppressants (voclosporin), microsomal triglyceride transfer protein inhibitors (lomitapide), migraine medications (eletriptan, ubrogepant), mineralocorticoid receptor antagonists (finerenone), opioid antagonists (naloxegol), PDE5 inhibitors (sildenafil for PAH), sedative/hypnotics (triazolam, oral midazolam), serotonin receptor agonists (flibanserin), and vasopressin receptor antagonists (tolvaptan). Additionally, strong CYP3A inducers (e.g., apalutamide, enzalutamide, carbamazepine, phenobarbital, primidone, phenytoin, rifampin, rifapentine, lumacaftor/ivacaftor, St. John's Wort) must be avoided, as well as other specific drugs like tamsulosin, rivaroxaban, and voriconazole.\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"citations\": [\r\n"]
[149.972236, "o", "\u001b[?2004l\r"]
[149.97234, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"set_id\": paxlovid_set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.972491, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\r"]
[149.972554, "o", "\u001b[?2004h> "]
[149.97263, "o", "                \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\rc\u001b[?2004h> "]
[149.973089, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.973108, "o", "            },\r\n\u001b[?2004l\re i\u001b[?2004h> "]
