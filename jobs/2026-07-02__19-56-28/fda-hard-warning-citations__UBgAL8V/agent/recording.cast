[149.975216, "o", ">     },\r\n\u001b[?2004l\r(1\u001b[?2004h> "]
[149.975288, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.975316, "o", "        \"qid\": \"daef650b92e56473\",\r\n\u001b[?2004l\r  "]
[149.975338, "o", "\u001b[?2004h> "]
[149.975388, "o", "        \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.976583, "o", "        \"answer\": \"Lopinavir-Ritonavir oral solution must be taken with food to enhance absorption. It is not recommended for use with polyurethane feeding tubes due to potential incompatibility, but compatible tubes such as silicone or polyvinyl chloride (PVC) feeding tubes can be used. Caregivers and patients should pay special attention to accurate dose administration, utilizing a calibrated dosing cup or oral dosing syringe to minimize the risk of accidental overdose or underdose. Step-by-step instructions include removing the bottle adapter, inserting it, firmly placing the oral syringe tip in the adapter, turning the bottle upside down, drawing up the prescribed dose, checking for accuracy, and swallowing the solution directly from the oral syringe.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.976608, "o", "        \"citations\": [\r\n\u001b[?2004l\r"]
[149.976665, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.97679, "o", "                \"set_id\": lop_rit_set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.976879, "o", "                \"passage_id\": \"PASSAGE_0001\",\r\n\u001b[?2004l\rt\u001b[?2004h"]
[149.976897, "o", "> "]
[149.977043, "o", "                \"section\": \"2.1 General Administration Recommendations\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.977197, "o", "                \"supporting_quote\": \"Lopinavir and ritonavir oral solution must be taken with food.\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.977264, "o", "            {\r\n\u001b[?2004l\r"]
[149.977284, "o", "\u001b[?2004h> "]
[149.977359, "o", "                \"set_id\": lop_rit_set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.977431, "o", "                \"passage_id\": \"PASSAGE_0002\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.977615, "o", "                \"section\": \"2.2 Administering Oral Solution by Feeding Tube\",\r\n\u001b[?2004l\r 400/1\u001b[?2004h> "]
[149.977949, "o", "                \"supporting_quote\": \"Because lopinavir and ritonavir oral solution contains ethanol and propylene glycol, it is not recommended for use with polyurethane feeding tubes due to potential incompatibility.\"\r\n\u001b[?2004l\r: \"\u001b[?2004h> "]
[149.978036, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.978247, "o", "                \"set_id\": lop_rit_set_id,\r\n\u001b[?2004l\re"]
[149.978266, "o", "\u001b[?2004h> "]
[149.978368, "o", "                \"passage_id\": \"PASSAGE_0159\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.978516, "o", "                \"section\": \"17 PATIENT COUNSELING INFORMATION\",\r\n\u001b[?2004l\r"]
[149.978538, "o", "\u001b[?2004h> "]
[149.978796, "o", "                \"supporting_quote\": \"Advise patients and caregivers that the oral solution should be administered using the calibrated dosing cup (supplied) or oral dosing syringe.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.978881, "o", "            },\r\n\u001b[?2004l\ric"]
[149.978961, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\rn\u001b[?2004h> "]
[149.978985, "o", "                \"set_id\": lop_rit_set_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.979056, "o", "                \"passage_id\": \"PASSAGE_0187\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.979243, "o", "                \"section\": \"1 Medication Guide and Instructions for Use\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.979452, "o", "                \"supporting_quote\": \"Swallow the lopinavir and ritonavir oral solution directly from the oral syringe.\"\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[149.979472, "o", "\u001b[?2004h>         ],\r\n\u001b[?2004l\r"]
[149.979525, "o", "vations, or\u001b[?2004h>         \"structured_fields\": {}\r\n\u001b[?2004l\rrticu"]
[149.979545, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[149.979617, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.979713, "o", "        \"qid\": \"a0576a26f2a2eeac\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r"]
[149.979753, "o", "\u001b[?2004h> "]
[149.981286, "o", "        \"answer\": \"The recommended dosage regimen for Lopinavir-Ritonavir is as follows: In adults, it can be administered as a once-daily regimen of 800 mg/200 mg (10 mL oral solution) or a twice-daily regimen of 400 mg/100 mg (5 mL oral solution). The once-daily regimen is not recommended for patients with three or more lopinavir resistance-associated substitutions, those taking certain concomitant medications (e.g., carbamazepine, phenobarbital, phenytoin, efavirenz, nevirapine, nelfinavir), pediatric patients under 18, or pregnant women. When twice-daily Lopinavir-Ritonavir is co-administered with efavirenz, nevirapine, or nelfinavir, the dose must be increased to 520 mg/130 mg (6.5 mL). In pregnant women with no lopinavir-associated resistance, the recommended dose is 400 mg/100 mg twice daily; once-daily dosing and the oral solution formulation should be avoided in pregnancy. In pediatric patients, once-daily dosing is not recommended, and dosing should be calculated based on weight or BSA to avoid underdosing. It is also not recommended in neonates before a postmenstrual age of 42 weeks and postnatal age of 14 days has been attained.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.981348, "o", "        \"citations\": [\r\n\u001b[?2004l\r"]
