[150.084973, "o", "        \"structured_fields\": {}\r\n\u001b[?2004l\re\": \"PAXLOVID inc\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[150.085049, "o", "udes r\u001b[?2004h> "]
