[149.988344, "o", "\u001b[?2004h> "]
[149.988394, "o", "                \"section\": \"5.4 Hepatotoxicity\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.988637, "o", "                \"supporting_quote\": \"There have been postmarketing reports of hepatic dysfunction, including some fatalities. These have generally occurred in patients with advanced HIV-1 disease taking multiple concomitant medications in the setting of underlying chronic hepatitis or cirrhosis.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
