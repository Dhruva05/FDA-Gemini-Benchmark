[149.968325, "o", "                \"passage_id\": \"PASSAGE_0019\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[149.968452, "o", "                \"section\": \"7.1 Potential for PAXLOVID to Affect Other Drugs\",\r\n\u001b[?2004l\rrning th"]
[149.968486, "o", "\u001b[?2004h> "]
[149.968912, "o", "                \"supporting_quote\": \"Co-administration of PAXLOVID with drugs highly dependent on CYP3A for clearance and for which elevated plasma concentrations are associated with serious and/or life-threatening events is contraindicated\"\r\n\u001b[?2004l\r"]
