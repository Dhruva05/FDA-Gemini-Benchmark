[186.048491, "o", "        # Paxlovid - What important drug interactions are noted for Paxlovid?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.048955, "o", "        ans_obj[\"answer\"] = \"Paxlovid is a strong CYP3A inhibitor due to its ritonavir component, which can lead to increased exposure of co-administered medications and potentially serious, life-threatening, or fatal events. It is contraindicated with drugs heavily dependent on CYP3A for clearance or strong CYP3A inducers.\"\r\n\u001b[?2004l\r\u001b[?2004h>         ans_obj[\"citations\"] = [\r\n\u001b[?2004l\r"]
[186.049017, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\rel "]
[186.049114, "o", "\u001b[?2004h>                 \"set_id\": set_id,\r\n\u001b[?2004l\rdoes not provide a supported recom\u001b[?2004h> "]
[186.049304, "o", "                \"passage_id\": \"PASSAGE_0012\",\r\n\u001b[?2004l\rrem\u001b[?2004h>                 \"section\": \"4 CONTRAINDICATIONS\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.049326, "o", "> "]
[186.049814, "o", "                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\r\n\u001b[?2004l\r"]
[186.049837, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h"]
[186.049855, "o", "> "]
[186.049864, "o", "        ]\r\n\u001b[?2004l\risea\u001b[?2004h"]
[186.049964, "o", "> "]
[186.050092, "o", "    elif qid in [\"6f12607a1ba14dd5\", \"mixed-7c14643ec4356a\", \"mixed-97331106c3870d\"]: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.050188, "o", "        # Paxlovid - Which medications should be avoided with Paxlovid?\r\n\u001b[?2004l\r"]
[186.050252, "o", "\u001b[?2004h> "]
[186.051144, "o", "        ans_obj[\"answer\"] = \"Medications that should be avoided or are contraindicated with Paxlovid include alpha 1-adrenoreceptor antagonists (alfuzosin), antianginals (ranolazine), antiarrhythmics (amiodarone, dronedarone, flecainide, propafenone, quinidine), antipsychotics (lurasidone, pimozide), cardiovascular agents (eplerenone, ivabradine), HMG-CoA reductase inhibitors (lovastatin, simvastatin), migraine medications (eletriptan, ubrogepant), strong CYP3A inducers (rifampin, carbamazepine, phenobarbital, phenytoin, St. John's Wort), and others listed in the label.\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[186.051247, "o", "        ans_obj[\"citations\"] = [\r\n\u001b[?2004l\rtion\": \u001b[?2004h> "]
