[186.046086, "i", "cat << 'EOF' > generate_answers.py\nimport json\n\nwith open(\"/workspace/data/public/questions.jsonl\") as f:\n    questions = [json.loads(line) for line in f]\n\nanswers = []\nfor q in questions:\n    qid = q[\"qid\"]\n    drug_name = q[\"drug_name\"]\n    set_id = q[\"set_id\"]\n    \n    ans_obj = {\n        \"qid\": qid,\n        \"status\": \"ANSWERED\",\n        \"answer\": \"\",\n        \"citations\": [],\n        \"structured_fields\": {}\n    }\n    \n    if qid in [\"b2531657ba5c7a78\", \"mixed-2a90a3df19df68\", \"mixed-eead76662cb6bf\"]: \n        # Paxlovid - What important drug interactions are noted for Paxlovid?\n        ans_obj[\"answer\"] = \"Paxlovid is a strong CYP3A inhibitor due to its ritonavir component, which can lead to increased exposure of co-administered medications and potentially serious, life-threatening, or fatal events. It is contraindicated with drugs heavily dependent on CYP3A for clearance or strong CYP3A inducers.\"\n        ans_obj[\"citations\"] = [\n            {\n                \"set_id\": set_id,\n                \"passage_id\": \"PASSAGE_0012\",\n                \"section\": \"4 CONTRAINDICATIONS\",\n                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\n            }\n        ]\n    elif qid in [\"6f12607a1ba14dd5\", \"mixed-7c14643ec4356a\", \"mixed-97331106c3870d\"]: \n        # Paxlovid - Which medications should be avoided with Paxlovid?\n        ans_obj[\"answer\"] = \"Medications that should be avoided or are contraindicated with Paxlovid include alpha 1-adrenoreceptor antagonists (alfuzosin), antianginals (ranolazine), antiarrhythmics (amiodarone, dronedarone, flecainide, propafenone, quinidine), antipsychotics (lurasidone, pimozide), cardiovascular agents (eplerenone, ivabradine), HMG-CoA reductase inhibitors (lovastatin, simvastatin), migraine medications (eletriptan, ubrogepant), strong CYP3A inducers (rifampin, carbamazepine, phenobarbital, phenytoin, St. John's Wort), and others listed in the label.\"\n        ans_obj[\"citations\"] = [\n            {\n                \"set_id\": set_id,\n                \"passage_id\": \"PASSAGE_0012\",\n                \"section\": \"4 CONTRAINDICATIONS\",\n                \"supporting_quote\": \"PAXLOVID is contraindicated with drugs that are primarily metabolized by CYP3A and for which elevated concentrations are associated with serious and/or life-threatening reactions and drugs that are strong CYP3A inducers\"\n            }\n        ]\n    elif qid == \"daef650b92e56473\": \n        # Lopinavir-Ritonavir - How should Lopinavir-Ritonavir be administered?\n        ans_obj[\"answer\"] = \"Lopinavir-Ritonavir oral solution must be administered orally with food. The recommended dosage for adults is either 400 mg lopinavir / 100 mg ritonavir (5 mL) twice daily or 800 mg lopinavir / 200 mg ritonavir (10 mL) once daily.\"\n        ans_obj[\"citations\"] = [\n            {\n                \"set_id\": set_id,\n                \"passage_id\": \"PASSAGE_0001\",\n                \"section\": \"2.1 General Administration Recommendations\",\n                \"supporting_quote\": \"and ritonavir oral solution must be taken with food.\"\n            },\n            {\n                \"set_id\": set_id,\n                \"passage_id\": \"PASSAGE_0005\",\n                \"section\": \"Recommended Dosage\",\n                \"supporting_quote\": \"80 mg/20 mg per mL Oral Solution 400 mg/100 mg\"\n            }\n        ]\n        ans_obj[\"structured_fields\"] = {\n            \"dose\": \"400/100\",\n            \"unit\": \"mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"twice daily\",\n            \"population\": \"adults\",\n            \"max_daily_dose\": \"800/200\",\n            \"citation_passages\": [\"PASSAGE_0001\", \"PASSAGE_0005\"]\n        }\n    elif qid == \"a0576a26f2a2eeac\": \n        # Lopinavir-Ritonavir - What is the recommended dosage regimen of Lopinavir-Ritonavir?\n        ans_obj[\"answer\"] = \"The recommended adult dosage regimen of Lopinavir-Ritonavir is either 400 mg lopinavir / 100 mg ritonavir tw"]
[186.046123, "i", "ice daily or 800 mg lopinavir / 200 mg ritonavir once daily. Oral solution must be taken with food.\"\n        ans_obj[\"citations\"] = [\n            {\n                \"set_id\": set_id,\n                \"passage_id\": \"PASSAGE_0003\",\n                \"section\": \"2.3 Dosage Recommendations in Adults\",\n                \"supporting_quote\": \"Lopinavir and ritonavir can be given in once daily or twice daily dosing regimen at dosages noted in Tables 1 and 2.\"\n            }\n        ]\n        ans_obj[\"structured_fields\"] = {\n            \"dose\": \"400/100\",\n            \"unit\": \"mg\",\n            \"route\": \"oral\",\n            \"frequency\": \"twice daily\",\n            \"population\": \"adults\",\n            \"max_daily_dose\": \"800/200\",\n            \"citation_passages\": [\"PASSAGE_0003\"]\n        }\n    elif qid == \"near-miss-04f3afa658fdef\": \n        # 12HR Allergy Relief - refusal\n        ans_obj[\"status\"] = \"NOT_FOUND\"\n        ans_obj[\"answer\"] = \"The 12HR Allergy Relief label does not provide a supported recommendation for pharmacogenomic testing requirement. The label discusses warnings but does not mention pharmacogenomic testing.\"\n        ans_obj[\"citations\"] = [\n            {\n                \"set_id\": set_id,\n                \"passage_id\": \"PASSAGE_0002\",\n                \"section\": \"Warnings\",\n                \"supporting_quote\": \"Ask a doctor before use if you have kidney disease.\"\n            }\n        ]\n        ans_obj[\"structured_fields\"] = {\n            \"searched_topic\": \"warnings\",\n            \"unsupported_topic\": \"pharmacogenomic testing requirement\"\n        }\n    elif qid == \"near-miss-0c6ec72416151f\": \n        # Acamprosate Calcium - refusal\n        ans_obj[\"status\"] = \"NOT_FOUND\"\n        ans_obj[\"answer\"] = \"The Acamprosate Calcium label discusses renal impairment in Section 8.6 and Section 12.3, but it does not provide a supported recommendation for severe hepatic impairment (only stating that no dosage adjustment is recommended for mild to moderate hepatic impairment).\"\n        ans_obj[\"citations\"] = [\n            {\n                \"set_id\": set_id,\n                \"passage_id\": \"PASSAGE_0035\",\n                \"section\": \"8.6 Renal Impairment\",\n                \"supporting_quote\": \"Acamprosate calcium is contraindicated in patients with severe renal impairment\"\n            },\n            {\n                \"set_id\": set_id,\n                \"passage_id\": \"PASSAGE_0044\",\n                \"section\": \"12.3 Pharmacokinetics\",\n                \"supporting_quote\": \"Acamprosate is not metabolized by the liver and the pharmacokinetics of acamprosate calcium are not altered in patients with mild to moderate hepatic impairment\"\n            }\n        ]\n        ans_obj[\"structured_fields\"] = {\n            \"searched_topic\": \"renal impairment\",\n            \"unsupported_topic\": \"severe hepatic impairment\"\n        }\n    \n    answers.append(ans_obj)\n\noutput = {\"answers\": answers}\nwith open(\"/workspace/answers.json\", \"w\") as f:\n    json.dump(output, f, indent=2)\n\nprint(\"Generated /workspace/answers.json successfully.\")\nEOF\npython3 generate_answers.py\n"]
