[194.66916, "i", "cat << 'EOF' > validate_answers.py\nimport json\n\nwith open(\"/workspace/data/public/questions.jsonl\") as f:\n    questions = {q[\"qid\"]: q for q in (json.loads(line) for line in f)}\n\nwith open(\"/workspace/data/public/labels.jsonl\") as f:\n    labels = {l[\"set_id\"]: l for l in (json.loads(line) for line in f)}\n\nwith open(\"/workspace/answers.json\") as f:\n    answers_data = json.load(f)\n\nif \"answers\" not in answers_data:\n    print(\"ERROR: Missing answers key.\")\n    exit(1)\n\nans_list = answers_data[\"answers\"]\nif len(ans_list) != len(questions):\n    print(f\"ERROR: Number of answers ({len(ans_list)}) does not match number of questions ({len(questions)}).\")\n    exit(1)\n\nall_ok = True\nfor ans in ans_list:\n    qid = ans.get(\"qid\")\n    if qid not in questions:\n        print(f\"ERROR: Unknown qid {qid}\")\n        all_ok = False\n        continue\n    \n    q = questions[qid]\n    req_fields = q[\"required_output_fields\"]\n    \n    # Check required top-level fields\n    for field in [\"qid\", \"status\", \"answer\", \"citations\", \"structured_fields\"]:\n        if field not in ans:\n            print(f\"ERROR: Missing top-level field {field} for qid {qid}\")\n            all_ok = False\n    \n    # Check status\n    status = ans.get(\"status\")\n    if status not in [\"ANSWERED\", \"NOT_FOUND\"]:\n        print(f\"ERROR: Invalid status {status} for qid {qid}\")\n        all_ok = False\n    \n    # Check structured_fields\n    sf = ans.get(\"structured_fields\", {})\n    for req in req_fields:\n        if req.startswith(\"structured_fields.\"):\n            subfield = req.split(\".\", 1)[1]\n            if subfield not in sf:\n                print(f\"ERROR: Missing structured_fields.{subfield} for qid {qid}\")\n                all_ok = False\n    \n    # Check citations\n    citations = ans.get(\"citations\", [])\n    if not citations:\n        print(f\"ERROR: Missing citations for qid {qid}\")\n        all_ok = False\n    \n    for cit in citations:\n        set_id = cit.get(\"set_id\")\n        passage_id = cit.get(\"passage_id\")\n        supporting_quote = cit.get(\"supporting_quote\")\n        \n        if set_id != q[\"set_id\"]:\n            print(f\"ERROR: Citation set_id {set_id} does not match question set_id {q['set_id']} for qid {qid}\")\n            all_ok = False\n            \n        if set_id not in labels:\n            print(f\"ERROR: Unknown set_id {set_id} for qid {qid}\")\n            all_ok = False\n            continue\n            \n        label = labels[set_id]\n        try:\n            passage_idx = int(passage_id.split(\"_\")[1])\n        except Exception:\n            print(f\"ERROR: Invalid passage_id format {passage_id} for qid {qid}\")\n            all_ok = False\n            continue\n            \n        if passage_idx < 0 or passage_idx >= len(label[\"chunks\"]):\n            print(f\"ERROR: passage_id {passage_id} out of bounds for set_id {set_id} (len {len(label['chunks'])}) for qid {qid}\")\n            all_ok = False\n            continue\n            \n        chunk = label[\"chunks\"][passage_idx]\n        if supporting_quote not in chunk:\n            print(f\"ERROR: supporting_quote {repr(supporting_quote)} not in chunk {passage_id} for qid {qid}\")\n            all_ok = False\n\nif all_ok:\n    print(\"ALL VALIDATIONS PASSED SUCCESSFULLY!\")\nelse:\n    print(\"SOME VALIDATIONS FAILED!\")\nEOF\npython3 validate_answers.py\n"]
