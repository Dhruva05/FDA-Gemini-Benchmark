[50.540434, "i", "python3 -c '\nimport json\nwith open(\"/workspace/data/public/labels.jsonl\") as f:\n    for line in f:\n        data = json.loads(line)\n        if data[\"drug_name\"] == \"Acamprosate Calcium\":\n            for idx, chunk in enumerate(data[\"chunks\"]):\n                if \"renal\" in chunk.lower() or \"hepatic\" in chunk.lower() or \"impairment\" in chunk.lower():\n                    print(f\"PASSAGE_{idx:04d}: {chunk[:300]}\\n\")\n'\n"]
