[186.052569, "o", "\u001b[?2004h> "]
[186.053017, "o", "        ans_obj[\"answer\"] = \"Lopinavir-Ritonavir oral solution must be administered orally with food. The recommended dosage for adults is either 400 mg lopinavir / 100 mg ritonavir (5 mL) twice daily or 800 mg lopinavir / 200 mg ritonavir (10 mL) once daily.\"\r\n\u001b[?2004l\r  \u001b[?2004h> "]
