[69.361831, "i", "python3 -c '\nimport json\nwith open(\"/workspace/data/public/labels.jsonl\") as f:\n    for line in f:\n        obj = json.loads(line)\n        if obj[\"drug_name\"] == \"Lopinavir-Ritonavir\":\n            for i, chunk in enumerate(obj[\"chunks\"]):\n                if \"dosage and administration\" in chunk.lower() or \"dose\" in chunk.lower() or \"adminis\" in chunk.lower():\n                    if i < 30:\n                        print(f\"PASSAGE_{i:04d}: {chunk[:300]}\")\n'\n"]
