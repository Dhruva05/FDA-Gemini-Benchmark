[210.091184, "o", "\u001b[?2004h> "]
[210.091374, "o", "    \"answer\": \"The Acamprosate Calcium label discusses renal impairment and mild to moderate hepatic impairment, but does not provide any dosage adjustment or recommendation for patients with severe hepatic impairment.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.091426, "o", "    \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>       {\r\n\u001b[?2004l\r"]
[210.091494, "o", "\u001b[?2004h> "]
[210.091546, "o", "        \"set_id\": \"ae6e79c0-a307-4888-b647-1b7be4cb9127\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.091569, "o", "        \"passage_id\": \"PASSAGE_0044\",\r\n\u001b[?2004l\r"]
[210.091621, "o", "\u001b[?2004h> "]
[210.091711, "o", "        \"section\": \"12.3 Pharmacokinetics\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.09191, "o", "        \"supporting_quote\": \"Acamprosate is not metabolized by the liver and the pharmacokinetics of acamprosate calcium are not altered in patients with mild to moderate hepatic impairment (groups A and B of the Child-Pugh classification). No adjustment of dosage is recommended in such patients.\"\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[210.091925, "o", "\u001b[?2004h>     ],\r\n\u001b[?2004l\r"]
[210.091961, "o", "\u001b[?2004h> "]
[210.091976, "o", "    \"structured_fields\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.092042, "o", "      \"searched_topic\": \"renal impairment\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.092103, "o", "      \"unsupported_topic\": \"severe hepatic impairment\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.092172, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   },\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.092186, "o", ">   {\r\n\u001b[?2004l\r"]
[210.092222, "o", "\u001b[?2004h> "]
[210.09224, "o", "    \"qid\": \"mixed-eead76662cb6bf\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.092286, "o", "    \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.092687, "o", "    \"answer\": \"Paxlovid is a strong CYP3A inhibitor. Co-administration of Paxlovid with drugs highly dependent on CYP3A for clearance and for which elevated plasma concentrations are associated with serious and/or life-threatening events is contraindicated. Conversely, co-administration of Paxlovid with strong CYP3A inducers is contraindicated because it can significantly reduce Paxlovid plasma concentrations, leading to potential loss of virologic response and possible resistance.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.092702, "o", "> "]
[210.092754, "o", "    \"citations\": [\r\n\u001b[?2004l\r\u001b[?2004h>       {\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.092808, "o", "> "]
[210.092839, "o", "        \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.092903, "o", "        \"passage_id\": \"PASSAGE_0000\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.092955, "o", "        \"section\": \"WARNING: SIGNIFICANT DRUG INTERACTIONS WITH PAXLOVID\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.093154, "o", "        \"supporting_quote\": \"PAXLOVID includes ritonavir, a strong CYP3A inhibitor, which may lead to greater exposure of certain concomitant medications, resulting in potentially severe, life-threatening, or fatal events\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.093234, "o", "      },\r\n\u001b[?2004l\r\u001b[?2004h>       {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.093296, "o", "        \"set_id\": \"8a99d6d6-fd9e-45bb-b1bf-48c7f761232a\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"passage_id\": \"PASSAGE_0013\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.093353, "o", "> "]
[210.093399, "o", "        \"section\": \"5.1 Risk of Serious Adverse Reactions Due to Drug Interactions\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.093677, "o", "        \"supporting_quote\": \"Initiation of PAXLOVID, which contains ritonavir, a strong CYP3A inhibitor, in patients receiving medications metabolized by CYP3A or initiation of medications metabolized by CYP3A in patients already receiving PAXLOVID, may increase plasma concentrations of medications metabolized by CYP3A.\"\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[210.093692, "o", "\u001b[?2004h> "]
[210.093751, "o", "    ],\r\n\u001b[?2004l\r\u001b[?2004h>     \"structured_fields\": {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.09383, "o", "  },\r\n\u001b[?2004l\r\u001b[?2004h>   {\r\n\u001b[?2004l\r\u001b[?2004h>     \"qid\": \"mixed-97331106c3870d\",\r\n\u001b[?2004l\r"]
[210.093885, "o", "\u001b[?2004h>     \"status\": \"ANSWERED\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.094472, "o", "    \"answer\": \"Medications that should be avoided or are contraindicated with Paxlovid include strong CYP3A inhibitors/substrates such as alfuzosin, tamsulosin, ranolazine, amiodarone, dronedarone, flecainide, propafenone, quinidine, lurasidone, pimozide, silodosin, eplerenone, ivabradine, dihydroergotamine, ergotamine, methylergonovine, lovastatin, simvastatin, voclosporin, lomitapide, eletriptan, ubrogepant, finerenone, naloxegol, sildenafil (for pulmonary arterial hypertension), triazolam, oral midazolam, flibanserin, and tolvaptan. Additionally, strong CYP3A inducers such as apalutamide, carbamazepine, phenobarbital, phenytoin, rifampin, and St. John\\'s wort must be avoided as they decrease Paxlovid exposure.\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
